  "we786c34f": "தானியங்கு ஆதாயம்",
  "we7cfa4df": "டீபக் பில்டுகளில் முடக்கத்தில்",
  "we80cfab5": "4 முதல் 8 இலக்கங்கள், ஆப்பைத் திறக்கும்போதும் அதற்குத் திரும்பும்போதும் கேட்கப்படும்.",
  "we81ca295": "இந்தச் சாதனத்தில் நேரடி வேலை செய்யவில்லை",
  "we84e8de4": "வட்டத்திலிருந்து வெளியேறு",
  "we870894c": "JetBrains Mono Variable",
  "we8f0fd30": "எப்படியும் உள்நுழை",
  "we90b5b2e": "இந்தக் குறியீட்டுடன் இணை",
  "we92cdd8b": "இந்த ஆப் இதைப் பயன்படுத்துகிறது",
  "we92ef95b": "எல்லாத் தளங்களுக்கும் முன்னோட்டங்கள்",
  "we93f2bbc": "உரையாடல் திறந்திருக்கும்போது அதன் செய்தி வரும்போது அல்லது அனுப்பப்படும்போது விளைவு ஒருமுறை இயங்கும். செய்தியின் மெனு அதை மீண்டும் இயக்கலாம்.",
  "we94c98b1": "ஏற்கனவே பதிவிறக்கப்படுகிறது",
  "we94e4a15": "இந்த ஸ்பேஸில் ஒவ்வொரு பங்கும் செய்யக்கூடியவை: குறுக்குக்குறி இங்கே அனுமதியை நீக்கும், சாய்வுக்கோடு வட்டம் சொல்வதுபோல் விடும், டிக் அதை வழங்கும். ஒரு பங்கின் முடிவு அனைவரின் முடிவையும் விட மேலானது.",
  "we94e9a1e": "மற்ற ஒலிகளின் ஒலியளவு",
  "we95d060c": "அந்தக் குறியீடு காலாவதியானது",
  "we9601784": "இப்போது புதுப்பி",
  "we98d362c": "அனுப்பியவர்",
  "we98e68a8": "ஒரு கணினி என்ன செய்ய முடியும்",
  "we99721a8": "நேரத்தைத் தேர்ந்தெடுக்கவும்",
  "we9e914e7": "இப்போது உங்கள் PIN-க்குப் பிறகு",
  "wea16f760": "தலைப்பு இல்லை",
  "w24d44177": "Uplink-இன் ரிலேக்குத் திரும்பு",
  "wea904991": "இழை",
  "wea9834dc": "குரலை மட்டும் பதிவு செய்",
  "weac8d2c1": "தனிப்பயன் CSS",
  "webb1c854": "உங்கள் செய்திகளைப் படிக்க முடியவில்லை",
  "webca594c": "உங்கள் தொடர்புகளில் இல்லாத எண்ணிலிருந்து, குறியீடு, PIN, கடவுச்சொல் அல்லது உள்நுழைவு பற்றிப் பேசும் குறுஞ்செய்தியில் நான்கு முதல் எட்டு இலக்கங்கள். அதே குறுஞ்செய்திகளுக்கு அவற்றின் அறிவிப்பில் நகலெடு பொத்தான் கிடைக்கும்.",
  "webf29f1b": "அதனால் தாவல்களிலும் ஆப்பின் ஐகானிலும் உள்ள எண்ணிக்கைகளில் இது எதையும் சேர்க்காது.",
  "webfa87e7": "தனியுரிமை",
  "wec18301d": "என்ன நடந்தது?",
  "wec48d271": "பேட்ஜ்கள்",
  "wec4d47d2": "உங்கள் உரையாடல்கள் ஏற்றப்படுகின்றன…",
  "wec6d25d1": "இந்தத் தீமின் மேல் உங்கள் சொந்த ஸ்டைல்கள் பயன்பாட்டில் உள்ளன",
  "wec7f4385": "இந்தச் சாதனத்திற்கு ஏற்கனவே தெரிந்தது. உங்கள் PIN-உம் எப்போதும் வேலை செய்யும்.",
  "wecca95fc": "எனக்குப் புரிகிறது, WhatsApp-ஐ இணை",
  "wed396212": "அதிலிருந்து, இதன் மூலம் இணை",
  "wed3c96b0": "உறுப்பினர்கள்",
  "wed4ea6ca": "இந்த அழைப்பின் மேல் வரிகளைக் காட்டு",
  "wed730c42": "வட்டத்தில் சேரு",
  "wedaf32e9": "https, அல்லது adb reverse உடன் http://127.0.0.1. மீண்டும் ஏற்று அதை மீண்டும் பெறும்.",
  "wfefc5ca5": "உங்கள் ஃபோன் நீங்கள் யார், உங்கள் நண்பர்கள், அவர்களுடனான உரையாடல்களை ஒப்படைக்கும், அதனால் ஃபோன் அணைந்திருந்தாலும் இந்தக் கணினியும் உங்கள் அதே அடையாளத்துடன் இருக்கும். பிறகு இங்கே உங்கள் Uplink கணக்கில் உள்நுழையலாம்.",
  "wede604b3": "புகார் செய்தவர் ஒப்படைத்தது: புகார் செய்யப்பட்ட செய்தி குறிக்கப்பட்டுள்ளது, மற்றவை அதற்கு முன்னும் பின்னும் சொல்லப்பட்டவை.",
  "wee60fcc9": "(திருத்தப்பட்டது)",
  "wee6f9829": "பதிலாக QR குறியீட்டை ஸ்கேன் செய்",
  "wee764324": "வெளியீடு",
  "weeaedf02": "அடையாளப்பெயரை நகலெடு",
  "wef24fd23": "இது என்ன செய்ய முடியும்",
  "wef264684": "முதல் ஸ்பேஸ்கள்",
  "wef7d1944": "இதை மீண்டும் அனுப்பு",
  "wefca1efb": "வரவேற்கிறோம், {name}! # general-இல் வணக்கம் சொல்லுங்கள், முதலில் # rules-ஐப் படியுங்கள்.",
  "wefcf73c8": "கேள்வி",
  "wcfc863f9": "இவற்றை ஒருபோதும் இணையதளத்தில் தட்டச்சு செய்யவோ யாரிடமும் சொல்லவோ வேண்டாம். உள்நுழைய இங்கே தவிர, Uplink இவற்றை ஒருபோதும் கேட்காது.",
  "wf0431b1f": "பட்டியலின் தலைப்பில் உள்ள துடைப்பம். நீக்க வேண்டிய வகைகளை டிக் செய்து, நீக்கு என்பதை அழுத்தி, ஆம் என்று சொல்லவும்.",
  "wf07da856": "பயன்படுத்திய இடம்",
  "wf0a810bb": "அசலை நகலெடு",
  "wf0dcdc51": "உங்கள் கடவுச்சொல்லுக்குப் பிறகு",
  "wf13718c2": "இதை Google Messages-இல் ஸ்கேன் செய்யவும்",
  "wf14a369b": "யாரையும் கேட்க மாட்டீர்கள், எதுவும் பேச மாட்டீர்கள்.",
  "wf1d8ed6c": "நீங்கள் பயன்படுத்த அனுமதிப்பவருக்கு இதைக் கொடுங்கள். இதில் உள்ள அனைவரும் மீண்டும் உள்நுழைவார்கள்.",
  "wf2089a72": "என் வால்பேப்பருக்குப் பொருத்து",
  "wf20a9ae0": "இன்னும் யாருமில்லை",
  "wf22adf51": "பழையது உடனே வேலை செய்வதை நிறுத்தும்.",
  "wf2485bf2": "புதிய குறியீட்டைக் காட்டு",
  "wf28cb6f4": "அவற்றை மாற்ற வேறு விசைகளை அழுத்தவும், அல்லது இவற்றைச் சேமிக்கவும்.",
  "wf28e14cf": "அனுப்பு",
  "wf299bc23": "குழுவிலிருந்து வெளியேறு",
  "wf2c8eafb": "குறுஞ்செய்தி மூலம் இதில் உள்ளவர்",
  "wf2de284e": "புதிய ஒன்று",
  "wf333e253": "மறையாக்கப்பட்டது",
  "wf4543314": "குறியீடு யாரிடமிருந்து என்று காட்டு",
  "wf4ce9557": "பதிவை அழி",
  "wf522dffc": "சரிபார்ப்புகள்",
  "wf54577b6": "உரையாடல்களும் செய்திகளும்",
  "wf563ddee": "இந்த ஆப்புக்கு இந்தச் சாதனத்தில் உள்ள ரிலேயைப் பயன்படுத்தவா?",
  "wf57642b0": "ரசீதுகள்",
  "wc18c4117": "Uplink உள்ள ஒருவர், உரையாடலின் தலைப்பிலிருந்து, உரையாடலின் பின்னணியை உங்களுடன் ஒத்திசைக்கலாம், நீங்களும் அவருடன். அது உரையாடலில் ஒரு குறுஞ்செய்தியாகப் பயணிக்கும். முடக்கத்தில், அவருடையது இங்கே காட்டப்படாது.",
  "wf588320d": "ஒரு வகையில் குறுஞ்செய்திகளை வகைப்படுத்துவதை நிறுத்த அதை முடக்கவும். ஒரு வகை Messages-இல் காட்டப்படுகிறதா என்பது தாவல்களுக்கு அருகில் உள்ள வடிகட்டியில் தேர்ந்தெடுக்கப்படும்.",
  "wf5910557": "மீண்டும் அனுப்பு",
  "wf5c107b5": "ரிலே சர்வரிடம் கேட்கிறது…",
  "wf5c1cbfa": "தொடர்புகளைத் தேடு",
  "wf5fbfe16": "வட்ட அமைப்புகள்",
  "wf6016ee7": "உங்கள் நெட்வொர்க்கில் ஃபோனின் முகவரியிலும் வழங்கப்படும், அதில் டோக்கன் உள்ள எவருக்கும்.",
  "wf6213819": "அவர்கள் ஆம் என்றதும் நீங்கள் அவர்களுக்கு எழுதலாம்",
  "wf62e8a91": "உங்கள் தொடர்புகளில் இல்லாதவரிடமிருந்து வரும் குறுஞ்செய்தி ஒலியின்றி வரும்.",
  "wf64f71ad": "இணைப்பு உள்ள எவரும் வட்டத்தில் இருப்பார், எனவே உங்களுக்குத் தெரிந்தவர்களுடன் பகிருங்கள்.",
  "wf651116c": "Markdown",
  "wf66cf057": "Google Messages இணைப்பை நீக்கு",
  "wf691ae75": "இப்போது கணினியில் அதைச் சொல்லுங்கள்",
  "wf6d8febf": "இந்தச் சாதனத்தில் திறக்க முடியாது",
  "wf72e3dbd": "யார் சேர்ந்தார், யார் வெளியேற்றப்பட்டார் அல்லது தடைசெய்யப்பட்டார், யார் நிர்வாகி ஆனார் அல்லது நிர்வாகியாக இல்லாமல் போனார் என்பதை ஒவ்வொரு உறுப்பினரின் ஆப்பும் எழுதும் படிக்க மட்டுமான ஸ்பேஸ். உரிமையாளரும் நிர்வாகிகளும் மட்டுமே அங்கே பதிவிடுவார்கள், எனவே அறிவிப்புகளுக்கும் பொருந்தும்.",
  "wf75a34df": "அழைப்புப் பதிவுகள்",
  "wf78ff4ce": "வார்த்தைகளை எழுத்தாக்கு",
  "wf799e9bf": "ஒரு உரையாடல் அல்லது இடத்திற்குத் தாவு…",
  "wf7af146f": "ஸ்பேம் வரும்போது",
  "wf7b404a6": "வண்ணப் பூச்சுகள்",
  "wf7b9754b": "கணக்கு விசையை நகலெடு",
  "wf7c9df13": "சுருக்கங்கள்",
  "wf7dbb560": "அவை இனி பட்டியலில் இல்லை.",
  "wf7e7e208": "மற்றவரின் ஃபோனில் குறுஞ்செய்திகளை மாற்ற முடியாது. மாற்றத்தை அவருக்கு அனுப்பவா?",
  "wf7eb0fbc": "ஸ்டிக்கர்",
  "wf7f4eb9d": "சிக்கல்கள்",
  "wf7f62b49": "பிறகு",
  "wf7ff61ae": "இந்த ஸ்பேஸ் இனி இல்லை.",
  "wf8033306": "ஸ்பேமில் உள்ள உரையாடலின் அடுத்தடுத்த குறுஞ்செய்திகள் அறிவிப்பின்றி வரும். \"ஸ்பேம் அல்ல\" அவற்றை மீண்டும் இயக்கும்.",
  "wf8457f4a": "தெரியாதவர்களுடன் குழு அரட்டைகள்",
  "wf8611fd5": "செய்திகள்",
  "wf868906d": "இதைப் பார்",
  "wf86abe8f": "குரலில் சேரு",
  "wf884324a": "ஒளிர்வு",
  "wf8a2cae3": "பட்டியலிலிருந்து குறியீட்டை நகலெடுப்பது அதன் உரையாடலையும் படித்ததாகக் குறிக்கும்.",
  "wf8c99d31": "ஒருவர் அனுப்பிய அழைப்பு இணைப்பை, அல்லது அதன் அழைப்புச் சொல்லை ஒட்டவும்.",
  "wf8d186a8": "தோல் நிறம்",
  "wf8d864e9": "அனைவரும், அந்த நேரங்களில்",
  "wf8f184d6": "எங்கிருந்தும்",
  "wf8f2191c": "உரைக் கோப்பு",
  "wf8f4da84": "பேனரை அகற்று",
  "wf8fb8363": "உறுப்பினர்கள் மீது செயல்பட உறுப்பினருக்கு மேலே; மாடரேட்டர்கள் செயல்பட மாடரேட்டருக்குக் கீழே.",
  "wf9218cc0": "உங்கள் எண்ணைச் சரிபார்க்கவும்",
  "wf9336e84": "எதுவும் இணைக்கப்படவில்லை",
  "wf94ffe6d": "ஸ்டீரியோ",
  "w680b6e5b": "ஒரு அமைப்பு கட்டுப்படுத்தப்பட்டது அல்லது கிடைக்கவில்லை என்று Android சொன்னால் (இயல்புநிலை SMS ஆப், ஒரு அனுமதி), Uplink-க்கான Android பக்கத்தைத் திறந்து, மேலே ⋮ தட்டி, கட்டுப்படுத்தப்பட்ட அமைப்புகளை அனுமதி என்பதைத் தேர்ந்தெடுக்கவும். பிறகு மீண்டும் முயற்சிக்கவும்.",
  "wf9676bb8": "sk_…",
  "wf968f6b8": "முடக்கத்தில், உங்கள் நண்பர்கள் உங்கள் சுயவிவரத்தில் உத்தரவாதங்களைப் பார்க்க மாட்டார்கள்.",
  "wf986d247": "பெயரை நகலெடு",
  "wf9969a96": "நண்பர்களையும் தொடர்புகளையும் தேடு",
  "wf9d5ccb1": "Mac அல்லது Windows கணினியில்",
  "wfa18c0ee": "கண்டறி",
  "wfa1b66fd": "ஃபோனிலேயே, செய்தியின் வார்த்தைகளில் கண்டறியப்பட்டது. எதுவும் எங்கும் அனுப்பப்படாது.",
  "wfa474602": "உருவாக்கத்தில் உள்ள ஒன்றைப் பயன்படுத்து",
  "wfa4d202a": "இந்த ஸ்பேஸ் எதற்காக",
  "wfa593938": "இணைக்கும் முன் இதைப் படியுங்கள்.",
  "wfa72ecf5": "குறியீட்டைப் படிக்கிறது",
  "wfa9279d1": "உள்ளே அனுமதி",
  "wfab49a4a": "படிக்க மட்டும்",
  "wfae0cba0": "அழைப்புச் சொல்",
  "wfb30d2e6": "ஆப் அல்லது app.gogho.st-இலிருந்து புகார் செய்யவும்",
  "wfb4d80e0": "அழைப்பு இணைப்பு",
  "wfbb27f80": "SMS மூலம் மட்டும் (உங்கள் திட்டத்தில் ஒரு குறுஞ்செய்தி)",
  "wfbb6bbfd": "இந்த ரிலேயில்",
  "wfbbc9969": "கணினியில் Google Messages",
  "wfbc398c5": "உங்கள் சுயவிவரத்தைத் திருத்து",
  "wfc220307": "உங்கள் கோப்புகளைத் திறக்கிறது…",
  "wfc2c683a": "அனைவருக்கும் நீக்கு",
  "wfc3003b5": "தலைப்பு",
  "wfc396a33": "இந்தப் போர்ட்டைப் பயன்படுத்து",
  "wfc45536b": "நகலெடுத்த படம் அதன் ஐகான் ஆகும்.",
  "wfc70cca9": "உங்கள் சொந்தத் தோற்றத்தை உருவாக்குங்கள்",
  "wfcde48b3": "இந்த உலாவி வைத்திருப்பவை",
  "wfd42c4bd": "பயனர்பெயர், பழைய பயனர்பெயர், Uplink id அல்லது கணக்கு மூலம் தேடு",
  "wfced4b75": "ரிலே சர்வர் மூலம் மட்டும்",
  "wfd09bc5c": "அரசியல்",
  "wfd448f26": "நீங்கள் விரும்பும் அளவு தட்டச்சு செய்யவும் அல்லது ஒட்டவும்.",
  "wfd4e0ac8": "நிர்வாகிப் பொறுப்பிலிருந்து நீக்கு",
  "wfd7ca0d6": "படிக்க எளிய எழுத்துரு",
  "wfd7f93f9": "அளவுருக்கள்",
  "wfdcfa44d": "ஒருவரையொருவர் கண்டறிதல்",
  "wfe2d66af": "நீங்கள் எழுதிக்கொண்ட 12 சொற்கள், வரிசைப்படி, இடையில் இடைவெளிகளுடன். கடவுச்சொல்லோ குறியீடோ தேவையில்லை.",
  "wfe615ac2": "Discord-ஐத் திறக்கும். பாட் ஏற்கனவே அங்கே இருந்தால் இதைத் தவிர்க்கவும்.",
  "w4c50755e": "Uplink பூட்டப்பட்டுள்ளது",
  "wfeb65ddc": "நீங்கள் அடையக்கூடிய நபர்கள்",
  "wfebdb8e4": "நீங்கள் ஒலியடக்கிய உரையாடல் அறிவிப்பின்றி வரும் (பட்டியலில் அதை நீண்ட நேரம் அழுத்தவும்).",
  "wff1ea6b4": "குழுவில் உள்ள அனைவரும் இந்தப் பெயரைப் பார்ப்பார்கள்.",
  "wff338aef": "mastodon.social",
  "wff372c62": "இதில் உள்ளவை",
  "wff57177c": "நிர்வாகி பயனர்பெயர்",
  "wff6d80eb": "செல்லவில்லை",
  "wff9fbb7d": "உங்கள் சுயவிவரத்தை அலங்கரியுங்கள். நண்பர்களும் உங்கள் ஸ்பேஸ்களில் உள்ளவர்களும் உங்கள் சுயவிவர அட்டையில் இதைப் பார்ப்பார்கள்.",
  "wffaa2524": "Notion",
  "wffaf28b9": "என் குரல் செய்திகளை மாற்று",
  "wffb9a114": "வைக்கப்பட்டதை அழி"
}
