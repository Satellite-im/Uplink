{
  "@@locale": "ta",
  "w0012dbc4": "இருவருக்கும் இடையே முத்திரையிடப்பட்டது",
  "w0016ab68": "நிலையானது",
  "w98994aae": "இன்னும் யாரும் இல்லை. Uplink-உடன் எண் இணைக்கப்பட்ட உறுப்பினர்கள் வரும்போது தானாகச் சேர்க்கப்படுவார்கள்; மற்றவர்களைக் கீழே சேர்க்கவும். ஒவ்வொருவருக்கும் இது எப்படி வேலை செய்கிறது, எப்படி வெளியேறுவது என்று ஒரு குறுஞ்செய்தி வரும்.",
  "w006d6b47": "நீங்கள் மறையாக்கம் இயக்கியுள்ளவர்களுடன் இது வேலை செய்யும்: குறுஞ்செய்தி மூலம் விசைகளைப் பரிமாறுவதே இரு ஃபோன்களையும் அறிமுகப்படுத்துகிறது. அது நடக்கும் வரை எதுவும் எங்கும் அனுப்பப்படாது. கடக்கும் அனைத்தும் இரு ஃபோன்களுக்கு இடையே முத்திரையிடப்படும்.",
  "w009090ee": "நீங்கள் செய்த புகார்கள்",
  "w00a0bb15": "எல்லா விளைவுகளும்",
  "w00a70065": "கேள்வி",
  "w00acb23a": "எல்லா செருகுநிரல்களையும் காட்டு",
  "w00dac180": "சந்தை வழிகாட்டுதல்களைப் படிக்கவும்",
  "w012e8224": "பிளேயரில் திற",
  "w014a39db": "புதிய டோக்கனை உருவாக்கு",
  "w014aaddc": "Windows மற்றும் உலாவி",
  "w016ac3ca": "பங்கு இல்லாத நிர்வாகி வட்டத்தை நீக்குவது, நிர்வாகிகளை நியமிப்பது தவிர எல்லாவற்றையும் செய்யலாம்.",
  "w1059488e": "பின்னர் படங்கள், குழு அரட்டைகள் உட்பட அனைத்தும் Uplink வழியாகச் செல்லும், உங்கள் எண்ணுக்கு RCS முடக்கப்படும்.",
  "w01a5ccf4": "இதில் எந்தச் செய்தியின் வார்த்தைகளும் இல்லை, ஃபோன் எண் போலத் தெரியும் எதுவும் அடித்துவிடப்படும். நீங்கள் நகலெடுத்தால் அல்லது பகிர்ந்தால் மட்டுமே இது ஃபோனை விட்டு வெளியேறும்.",
  "w01a94d89": "உங்கள் சர்வரில் பாட்டைச் சேர்க்கவும்",
  "w02056534": "சுமார் 1 Mbit/s, DJ கேட்பதை விட ஒரு வினாடி தாமதமாக. முடக்கத்தில், இது மிக உயர்ந்த தரத்தில் Opus.",
  "w0274af2a": "வார்த்தைகள்",
  "w02bfe959": "Bluesky-இல் உள்நுழை",
  "w02c6bc64": "பதில்கள்",
  "w02f243b7": "உங்கள் ஃபோனின் அடையாளத்தையே இங்கும் பெறுங்கள்",
  "w030e28cc": "நீங்கள் எதிர்பார்க்கும் ஒருவர் தன் கணக்கை இணைத்து, கண்டறியப்பட விரும்பினால், அவர் இங்கே தோன்றுவார்.",
  "w0326c1b4": "குமிழ்கள்",
  "w033ebcdd": "எமோஜி",
  "w038fdf9a": "செருகுநிரல்",
  "w03d66880": "அடையாளப்பெயர்கள்",
  "w03daf658": "செய்தி வரும்போது அல்லது அனுப்பப்படும்போது \"வாழ்த்துகள்\"-க்கு கான்ஃபெட்டி, \"பிறந்தநாள் வாழ்த்துகள்\"-க்கு பலூன்கள் மற்றும் பல.",
  "w04153acd": "வழிகாட்டியை மீண்டும் பார்",
  "w0423b5a1": "என் CSS-ஐப் பயன்படுத்து",
  "w0450b757": "அரட்டையை ஏற்றுமதி செய்",
  "w04a57fc2": "அழி",
  "w04d5e37c": "உங்கள் கணக்குகளை இணைக்கவும்",
  "w05652ac2": "இந்த நெட்வொர்க்கில்",
  "w056afd4b": "உங்கள் அருகில் உள்ளவர் ஸ்கேன் செய்ய",
  "w056c2aa6": "சரிபார்க்கப்பட்ட ஃபோன் எண்",
  "w0574902c": "குழு",
  "w05952477": "இந்த உலாவியிலிருந்து வெளியேறவா? உங்கள் கணக்கின் அனைத்தும் இதிலிருந்து நீக்கப்படும்: இங்குள்ள உரையாடல்கள், நண்பர்கள், வட்டங்கள், விசைகள். உங்கள் நண்பர்களும் வட்டங்களும் உங்கள் கணக்குடன் இருக்கும், மீண்டும் உள்நுழையும்போது திரும்ப வரும்; உங்கள் மற்ற சாதனங்கள் தங்கள் உரையாடல்களை வைத்திருக்கும்.",
  "w05d27226": "மீட்பு சொற்களைக் காட்டு",
  "w05e33246": "அழைப்பில் ஒன்றாகப் பாருங்கள்",
  "w0631c9e6": "எல்லா சுயவிவர அமைப்புகளும்",
  "w06357afd": "கோப்புறை",
  "w064e499f": "வரிசைப்படி தட்டவும்",
  "w0654b94a": "உருவாக்கத்தில் உள்ள எந்தச் செருகுநிரல்?",
  "w0655b42d": "இணைப்பைப் பகிர்",
  "w065b8fa0": "இது என்ன",
  "w06ceba79": "அங்கீகரிக்கப்பட்டதும் பட்டியலிடு",
  "w07177156": "மாதிரிகளை முயற்சிக்கவும்",
  "w076b00b5": "படிக்க எளிதானது",
  "w0770bf30": "விளைவை இயக்கு",
  "w07a5c10d": "டெவலப்பரின் குறிப்புகள்",
  "w07d14f16": "உள்நுழையும்போது திறத்தல், விழித்திருத்தல், உங்கள் ஃபோனுடன் பயன்படுத்துதல்.",
  "w0804fd87": "நீங்கள் சொல்வது",
  "w08084200": "ஒவ்வொரு குறுக்குவழியும் அதன் சொந்த விசைகளுக்குத் திரும்பியது",
  "w080a915a": "Android-இல் முடக்கத்தில்",
  "w0815aad4": "புதுப்பி",
  "w0819f3fe": "உங்கள் தரவு",
  "w0856770d": "இந்தக் கணினியிலிருந்து Google Messages இணைப்பை நீக்கவா?",
  "wf7b30046": "Telegram, Signal தவிர, Uplink மற்ற நெட்வொர்க்குகளைச் செருகுநிரல்களாகக் கொண்டுவர முடியும். இவை அதிகாரப்பூர்வ Uplink இணைப்புகள் அல்ல — ஒவ்வொன்றும் அந்த நெட்வொர்க்கின் இணையதளம் அல்லது ஆப் உள்நுழையும் விதத்தில் உள்நுழைகிறது, சில மற்ற ஆப்களை அனுமதிப்பதே இல்லை. இணைக்க ஒன்றை இயக்கவும்.",
  "w08b8af81": "நண்பர்கள் பார்ப்பது",
  "w08e6a368": "ஸ்பேஸை நீக்கு",
  "w09094368": "உங்கள் ஃபோன் மூலம் உள்நுழையவும்",
  "wa613f780": "Uplink இந்தச் சாதனத்தில் தனக்கென ஒரு Telegram ஆப்பாக உள்நுழைகிறது. உங்கள் அரட்டைகள் அதற்கும் Telegram-க்கும் இடையே செல்கின்றன; Uplink-இன் சர்வர் அவற்றைப் பார்ப்பதில்லை. இங்கே வெளியேறவும், அல்லது Telegram › Settings › Devices-இல் அமர்வை முடிக்கவும்.",
  "w091ebd33": "புதியவை",
  "w0937a922": "சொற்களை மீண்டும் பார்",
  "w0947e8bd": "விளையாட்டுகளும்",
  "w095d2483": "ஆப்புக்கு விளையாட்டு எனத் தெரியாத ஒரு நிரல்: ஒரு வரிக்கு ஒரு பெயர், அதன் கோப்பு அல்லது ஆப் அழைக்கப்படுவது போல.",
  "w09a23ca8": "ஒரு நிறம்",
  "w4b296098": "நீங்கள் குறுஞ்செய்தி அனுப்பும் ஒருவரிடமும் Uplink இருந்தால், இரு ஃபோன்களும் ஒன்றையொன்று அடையாளம் காணும், உரையாடலில் அதை மறையாக்க ஒரு பேனர் தோன்றும். முடக்கத்தில், உங்கள் ஃபோன் தன்னைப் பற்றி எதுவும் சொல்லாது, உரையாடலின் தலைப்பிலிருந்து மறையாக்கத்தை இயக்குவீர்கள்.",
  "w09b5065c": "கோப்புகள் ஏற்றப்படுகின்றன…",
  "w09d96e18": "பேட்ஜ்",
  "w09de57fe": "இந்தக் கடவுச்சொற்றொடரைப் பயன்படுத்து",
  "w09e6c912": "குறுஞ்செய்தியில் அழைப்பு அனுப்பு",
  "w09ea4ff9": "இணைப்பு",
  "w09eaf132": "3 மணிநேரத்திற்கு",
  "w0a1fdf97": "இந்த ஃபோனுக்குப் புதிய விசை",
  "w25f29df4": "நான் Uplink-இல் @maya",
  "w0a685f69": "தனிப்பட்டவை & மற்றவை",
  "w0b2b16fd": "Google Messages-உடன் இணைக்கப்பட்டது",
  "w0b35b4a6": "குரல் அமைப்புகள்…",
  "w0b35fb61": "இயக்கத்தில் · சரிபார்க்கப்பட்டது",
  "w0b43d589": "ஸ்பேஸின் பெயருக்குக் கீழே, அதில் உள்ள அனைவருக்கும் காட்டப்படும். எதையும் காட்டாமல் இருக்கக் காலியாக விடவும்.",
  "w0baf1b3f": "இதையும் இதிலுள்ள அனைத்தையும் நீக்கு",
  "w0bc31fdf": "உதவி இணைப்பு அல்லது மின்னஞ்சல்",
  "w0bfeb25e": "Google Messages",
  "w0c141f28": "ஆப்பின் வார்த்தைகள். பெயர் அல்லது எண்ணிக்கை போல அது செயல்படும்போது உருவாக்குவது, இப்போதைக்கு ஆங்கிலத்திலேயே இருக்கும்.",
  "w0c17ea70": "Notion இணைப்புகள் வெளியே திறப்பது நின்றுவிடும். ஏற்கனவே அணுகல் உள்ளவர்களைத் துண்டிக்க, Notion-இலும் ஒருங்கிணைப்பை நீக்கவும்.",
  "w0c43fb4a": "1 மணிநேரம்",
  "w0c632e38": "மொழிகள்",
  "w0c714803": "பட்டியலிடப்பட்டதும் உங்கள் பயனர்பெயர், உதவி இணைப்பு, திரைப்பிடிப்புகள் அனைவருக்கும் காட்டப்படும்.",
  "w0c92e881": "புதுப்பிப்புகளை நிறுவ அனுமதி",
  "w0cbc06a1": "இணைப்பு மூலம் வட்டத்தில் சேரவும்",
  "w0cca89c7": "அனுப்பப்பட்டபடியே அதன் கோப்பு, மாற்றி மீண்டும் ஏற்ற.",
  "w0ce7a514": "தேடலை மூடு",
  "w0cefc1e0": "ntn_…",
  "w0cffd085": "உங்கள் திரை பகிரப்படவில்லை",
  "w0d28d199": "இந்த ஸ்பேஸ் பங்குகள் வருவதற்கு முன் உருவாக்கப்பட்டது, எனவே உரிமையாளர் இல்லை: இதில் உள்ள அனைவரும் உறுப்பினர்கள், அதை யாரும் மாற்ற முடியாது.",
  "w0d58a28e": "உங்கள் ஃபோனுக்காகக் காத்திருக்கிறது",
  "w0d7d4b02": "ஒருவரின் பங்கை மாற்ற அவரை அழுத்திப் பிடிக்கவும். நிர்வாகிகளை உரிமையாளர் மட்டுமே நியமிக்கிறார்.",
  "w0dc6b4aa": "முடக்கம்",
  "w0dc8bada": "இந்த ஃபோனிலும் ரிலே சர்வரிலும், எல்லாக் கணக்குகளையும் உங்கள் எண்ணையும் துண்டித்து, நீங்கள் எதிர்பார்க்கும் நபர்களை அழிக்கிறது.",
  "w0f2a0cf6": "நிர்வாகிகள் மட்டுமே இந்தக் குழுவின் விவரங்களை மாற்ற முடியும்.",
  "w0f52969f": "எளிய பக்கம்.",
  "w3c9609ea": "மதிப்பாய்வு செய்ய இந்தக் கணினியில் உங்கள் Uplink அடையாளம் தேவை. அமைப்புகள் › நான் என்பதில் உங்கள் ஃபோனின் அடையாளத்தையே இங்கும் பெறுங்கள்.",
  "w0f98c706": "கடைசிப் புதுப்பிப்பு கொண்டுவந்தவை.",
  "w0fa9a181": "உங்கள் கணக்கு",
  "w0fbb9a90": "சரிபார்",
  "wb8dae055": "உங்கள் செய்திகள் இந்தச் சாதனத்திற்கும் Bluesky-க்கும் இடையே செல்கின்றன. Uplink-இன் சர்வர் அவற்றைப் பார்ப்பதில்லை, ஆப் கடவுச்சொல்லும் வைக்கப்படுவதில்லை: Bluesky திருப்பித் தரும் அமர்வு மட்டுமே.",
  "w0fd3d5fb": "கோப்புறைக்கு நகர்த்து",
  "w0fe07306": "பெயர்",
  "w0fe169eb": "Messages-க்குள், அவர்களிடம் வேறு எதுவும் கேட்காமல்.",
  "w0fe47214": "குறுஞ்செய்தி மூலம் ஒருவருக்கு அழைப்பு அனுப்பு",
  "w0feb83c1": "முத்திரையிடப்பட்டது",
  "w0ff01b6a": "குறிப்புகள்",
  "w10178f58": "ஆப்புக்குத் தெரிந்து எதுவும் தவறாகவில்லை.",
  "w10220f1c": "அரட்டையின் அளவை மாற்று",
  "w104b9c36": "வட்டத்தையும் அதன் ஸ்பேஸ்களையும் மாற்றலாம்",
  "w10ba10f7": "மொழிபெயர்ப்பை நகலெடு",
  "w10bb1b35": "பங்கின் பெயரை மாற்று",
  "w10f8f9dc": "இது உள்ள எவரும் ஆப்பிலிருந்து சேரலாம்",
  "w111e2910": "இதை Signal மூலம் ஸ்கேன் செய்யவும்",
  "w11344c82": "அனுமதிக்கப்பட்டது · முன்னோட்டங்கள் காட்டப்படும்",
  "w11411f5b": "மறையாக்கப்பட்ட குறுஞ்செய்திகள்",
  "w1170897f": "பட்டியல் பக்கம்",
  "w11bfc20a": "இதை WhatsApp மூலம் ஸ்கேன் செய்யவும்",
  "w11c0fa2e": "ஸ்பேஸிலிருந்து வெளியே எடு",
  "w11c76da0": "இவருடன் பகிர்",
  "w11d3fc68": "உங்கள் தொடர்புகளைப் படிக்க முடியவில்லை",
  "w11d712cf": "MyGame.exe",
  "w11f76bdf": "நீங்கள் கேட்டதிலிருந்து மாற்றங்கள்",
  "w11f84087": "புதிய பங்கு",
  "w12073981": "ரிலே சர்வரால் உங்கள் அரட்டைகளைப் படிக்க முடியாது, எனவே அந்தச் செய்தியும் அதன் இருபுறமும் சில செய்திகளும் புகாருடன் செல்லும், மதிப்பாய்வாளருக்கு மட்டும் முத்திரையிடப்பட்டு.",
  "w12861884": "இன்னும் எதுவும் எழுத்தில் இல்லை.",
  "w12cbbe26": "பின்னணி இல்லை",
  "w12deeb59": "GHOSTPAIR1:…",
  "w12e0eaee": "குழுவை உருவாக்கு",
  "w30fd596a": "உங்கள் ஃபோனில் Signal-இல்: Settings › Linked devices › Link new device, பின்னர் இந்தக் குறியீட்டை நோக்கிக் காட்டவும். Signal Desktop போல Uplink உங்கள் மற்றொரு சாதனமாகிறது. இனி வரும் செய்திகள் இங்கே வரும்; புதிய சாதனத்திற்காக Signal பழைய செய்திகளை வைத்திருப்பதில்லை.",
  "w13e06bb2": "இந்தக் குழு எதற்காக",
  "w140db474": "உங்கள் தொடர்புகளில் யாரும் இல்லாத குழுவும் வகைப்படுத்தப்படும்.",
  "w141bdee1": "சிஸ்டம் தீம்",
  "w1440c15d": "குறிப்பு",
  "w144b5141": "நிறுவல் கட்டளையை நகலெடு",
  "w147a545d": "டெலிவர் ஆனது என்பது செய்தி மற்ற ஃபோனை அடைந்ததாக உங்கள் சேவை வழங்குநர் சொல்வது. படித்தது என்பது பட மற்றும் குழுச் செய்திகளுக்கு மட்டும், பதிலளிக்கும் ஃபோன்களிடமிருந்து மட்டுமே; சாதாரணக் குறுஞ்செய்தியால் அது படிக்கப்பட்டதாகச் சொல்ல வழியில்லை.",
  "w14d49729": "திருத்தத்தை அனுப்பு",
  "w14fe9666": "ஒரு அறிக்கையில் கையொப்பமிடு",
  "w151e1da5": "gogho.st, மற்ற அனைவரும் இருக்கும் இடம்.",
  "w1523b1b3": "உங்கள் ஆன்மாக்களைப் பாருங்கள்",
  "w15253243": "உங்கள் கடவுச்சொல்",
  "w1536d152": "Google Messages-உடன் சேர்ந்து",
  "w1573c706": "அனைத்தையும் அகற்று",
  "w157f22c1": "பிறகு அனுப்பு",
  "w15d01e06": "டெலிவரி அறிக்கைகள்",
  "w1633d372": "மதிப்பாய்வாளருக்கு ஒரு குறிப்பு (விருப்பத்தேர்வு)",
  "w163d04fd": "பதிவு அழிக்கப்பட்டது",
  "w16470815": "புதிய விசையை உருவாக்கு",
  "w1652dc89": "ElevenLabs வழங்கும்",
  "w7a86ca84": "முடக்கத்தில், யாருக்கும் எதுவும் சொல்லப்படாது. இயக்கத்தில், உங்கள் இணைக்கப்பட்ட அடையாளப்பெயர்களில் ஒன்றை ஏற்கனவே அறிந்து, அதைப் பற்றி அறியக் கேட்டவருக்கு, அது Uplink-இல் உள்ளது என்று சொல்லப்படும். அவருக்கு உங்கள் எண், பெயர், மற்ற கணக்குகள் வழங்கப்படாது, உங்கள் எண்ணைப் பற்றி — சரிபார்க்கப்பட்டதோ இல்லையோ — யாருக்கும் சொல்லப்படாது. ரிலே சர்வர் ஒவ்வொரு இணைக்கப்பட்ட அடையாளப்பெயரின் குழப்பப்பட்ட வடிவத்தை மட்டுமே வைத்திருக்கும், அடையாளப்பெயரையே அல்ல.",
  "w1687911f": "இசைப் பயன்முறை",
  "w168ad274": "குறுஞ்செய்திகளும் படச் செய்திகளும்",
  "w16ce9b5d": "மற்ற ஃபோன்கள் எதிர்வினையைக் குறுஞ்செய்தியாக அனுப்புகின்றன, Loved “See you at 7” போல. இயக்கத்தில், அது குறிப்பிடும் செய்தியில் ❤️ ஆக வரையப்படும். முடக்கத்தில், ஒவ்வொரு குறுஞ்செய்தியும் வந்தபடியே காட்டப்படும்.",
  "w16d7fb48": "என் சொந்தக் குரலைப் பயன்படுத்து",
  "w16f56c89": "இந்தச் செருகுநிரலை நான் உருவாக்கினேன், இது சந்தை வழிகாட்டுதல்களைப் பின்பற்றுகிறது",
  "w171b648b": "வந்தது",
  "w172a1093": "அதை அகற்று",
  "w1748662b": "புதிய குறியீட்டைப் பெறு",
  "w17d2bb8a": "இதை உங்கள் கணினிக்கு (அல்லது உலாவி உள்ள எதற்கும்) பகிர்ந்து அங்கே திறக்கவும். பின்னர் இந்த ஃபோனில் Google Messages-ஐத் திறந்து, உங்கள் சுயவிவரப் படத்தைத் தட்டி, Device pairing, பின்னர் QR code scanner-ஐத் தட்டி, அது காட்டும் குறியீட்டை ஸ்கேன் செய்யவும்.",
  "w17ff3e19": "அதை மறந்துவிடு",
  "w18271c85": "பழைய செய்திகளைத் திற",
  "w185d6aab": "எந்த ஆப்பும் திறக்கும் ஒரு எளிய உரைக் கோப்பு.",
  "w18743595": "அனுப்புநர்",
  "w188dadaf": "RCS முடக்கப்பட்ட பிறகு, மற்றவர்களின் ஃபோன்கள் மீண்டும் உங்களுக்குக் குறுஞ்செய்திகளை அனுப்பும். அவர்களின் ஃபோன்கள் இதைக் கவனிக்க சில நிமிடங்கள் முதல் சில மணிநேரங்கள் வரை ஆகலாம்.",
  "w18991ff3": "படச் செய்திகள்",
  "w18ac79a2": "நெட்வொர்க்குகள்",
  "w18dfd47e": "உங்கள் ஃபோன் மறுத்துவிட்டது",
  "w190ba944": "ஆப்பின் மொழி. தானியங்கு என்பது ஆப்பில் இருந்தால் உங்கள் சாதனத்தின் மொழியைப் பின்பற்றும்.",
  "w19239890": "குறுகிய குறியீடுகளுக்குத் தளர்வு",
  "w1926d127": "புதிய கோப்புறை",
  "w1932985f": "படத்தை அகற்று",
  "w1947300c": "உங்கள் ஃபோன் அதே ஆறு இலக்கங்களைக் காட்டுகிறதா?",
  "w194e550a": "பதிலாக QR குறியீட்டுடன் இணை",
  "w1988beab": "2. குறியீட்டைப் பெறுங்கள்",
  "w199573cf": "உரையாடல்கள்",
  "w19c9fd66": "கோப்புகள் ஸ்பேஸ்",
  "w19dc307e": "இயல்புநிலை",
  "w19de31fa": "சாதாரண அரட்டை",
  "w1a29ff2a": "நிறங்கள்",
  "w1a43a2ac": "மீண்டும் ஏற்று",
  "w1a8a032a": "இனி அனுப்பப்படும் செய்திகள் அனைவருக்கும் இதற்குப் பிறகு மறைந்துவிடும்:",
  "w1aa2318e": "அவை பொருந்துகின்றன",
  "w1aa78686": "இப்போது பூட்டு",
  "w1afc1067": "முந்தைய செய்திகள் ஏற்றப்படுகின்றன…",
  "wd84a3240": "Uplink-இல் இப்போது Google Messages உரையாடல்கள் முழுமையாக உள்ளன: RCS மற்றும் குறுஞ்செய்திகள், படங்கள், எதிர்வினைகள், உங்கள் செய்திகள் எப்போது டெலிவர் ஆகின, படிக்கப்பட்டன என்பவை. Google Messages-இன் சொந்த அறிவிப்புகளை முழுவதுமாக முடக்கலாம்; Uplink தனது அறிவிப்புகளைக் காட்டும். Google Messages-இல் ஒரு நேரத்தில் ஒரு வலை அமர்வு மட்டுமே: ஒரு கணினி அல்லது messages.google.com அதை எடுத்தால், இந்த ஃபோன் அதைத் திரும்ப எடுக்கும்.",
  "w1b6055cb": "நண்பரை அகற்று",
  "w1b9ae0bb": "ஆங்கிலம்",
  "w1bd2b16b": "ஒரு தெரு முகவரி.",
  "w1bf5144b": "தானியங்கு புதுப்பிப்புகள் முடக்கத்தில்",
  "w1c08d4d9": "பயனர்பெயர்",
  "w1c0bdb22": "ஒரு கடிகாரம்",
  "w1c3d7753": "அது வகைப்படுத்தும் மாதிரிக் குறுஞ்செய்திகளுக்கான பட்டியலின் வரிசைகள்: கற்பனைக் குறுஞ்செய்திகள், காட்டப் பாதுகாப்பானவை.",
  "w5f49f834": "சர்வரை நிர்வகிக்கக்கூடிய ஒருவர் Uplink-இன் பாட்டைச் சேர்க்கிறார். அது சேனல் பெயர்களையும் குரலில் யார் இருக்கிறார்கள் என்பதையும் மட்டுமே பார்க்கும்.",
  "w1c938151": "சேரக் கேட்கிறார்",
  "w1c943018": "குழுவிலிருந்து வெளியேறு",
  "w1cc87559": "தடைசெய்யப்பட்டவர்",
  "w1ccb6c02": "நீங்கள் முதல் முறை ஒருவருக்கு உங்கள் விசையை அனுப்பும்போது உருவாக்கப்படும்.",
  "w1d26787c": "பட்டியலிடப்பட்டதும் இவற்றை அனைவரும் பார்ப்பார்கள். கற்பனைக் குறுஞ்செய்திகளைப் பயன்படுத்தவும், உண்மையான உரையாடல்களையோ யாருடைய எண்ணையோ ஒருபோதும் பயன்படுத்த வேண்டாம்.",
  "w1db53bb0": "இந்த உலாவியிலிருந்து உங்கள் சுயவிவரம், நண்பர்கள், வட்டங்கள் ஏற்கனவே உள்ளவற்றுடன் உங்கள் காப்புப்பிரதியில் சேரும், அடுத்து உள்நுழையும் சாதனத்திற்கு அவை கிடைக்கும். இது உங்கள் கடவுச்சொல் மற்றும் மீட்பு சொற்களால் மீண்டும் முத்திரையிடப்படும்.",
  "w5daf00ff": "Uplink-இல் புதிய அரட்டை",
  "w1dba6cb7": "திரும்பப் பெறு",
  "w1dc44e05": "அழுத்திப் பேசு முடக்கத்தில்",
  "w1dd4ab8a": "கேட்கிறது",
  "w1e4a8a2c": "வழிகளை அமைக்க முடியவில்லை",
  "w1e66d8b3": "மறையாக்க விசை",
  "w1e67f0c0": "சுருக்கத்தை மூடு",
  "w1e77da81": "இதைப் பயன்படுத்து",
  "w1015dbcb": "Google Messages-இன் அறிவிப்புகள் இல்லாமல், Uplink-இல் RCS அரட்டைகளுக்குப் படங்கள், எதிர்வினைகள், படித்த குறிகள். மற்றொரு திரையின் உதவியுடன் ஒருமுறை இணைக்கப்படும்.",
  "w1f3b1040": "இது என்ன நீக்குகிறது",
  "w1f8de81f": "குழுவின் பெயர்",
  "w1fa630cd": "ஒலிக்கிறது",
  "w1fadcc1e": "டெவலப்பர் பயன்முறை இயக்கத்தில்: அமைப்புகள் › டெவலப்பர்.",
  "w1fd7a547": "இன்னும் இந்தச் சாதனத்தில் இல்லை",
  "w1fe81014": "புதிய பதிப்பைச் சமர்ப்பி",
  "w205686c6": "நாள்காட்டி அழைப்பிதழ்",
  "w2060c750": "சேர்க்கிறது…",
  "w206d1523": "உங்கள் சேவை வழங்குநர் வழியாக SMS மற்றும் MMS. RCS, iMessage ஆகியவை Google, Apple-இன் சொந்த ஆப்கள் தவிர மற்ற ஆப்களுக்குக் கிடைக்காது.",
  "w207a7281": "உள்நுழையவில்லை",
  "w207f0fea": "புதிய செய்தி",
  "w20d73c2b": "ஒவ்வொரு அரட்டையின் பின்னணியையும் பயன்படுத்து",
  "w20f8dddc": "டிராக்",
  "w210f4599": "பக்கத்தை மீண்டும் திற",
  "w2124eb1d": "டிராக்குகள்",
  "w213e90fa": "மீண்டும் முயற்சி",
  "w21754877": "சுத்தம் செய்",
  "w21a5901d": "அகற்று",
  "w21d188ab": "உங்கள் ஆன்மாக்களிடமிருந்து அவர்களுடையவற்றுக்கு ஒரு நன்றி",
  "w221c5380": "அமைப்புகள் › நான்-ஐத் திற",
  "w2238c847": "gogho.st/c/…",
  "w2279d8cb": "அரட்டை",
  "w227d7889": "அனைத்தையும் படித்ததாகக் குறி",
  "w22b1cb59": "திரைப்பட இரவு",
  "w22de047e": "Stardew Valley",
  "w22efd7cf": "டெவலப்பர் பயன்முறையை இயக்க இன்னும் ஒரு தட்டல்.",
  "w2317f6d2": "ஒரு .ghostplugin கோப்பு.",
  "w2342ec20": "முடிக்கப்படாத பதிவேற்றத்தை அகற்று",
  "w234b13cf": "இன்னும் வட்டத்தில் வேறு யாரும் இல்லை",
  "w23f990dc": "இணைப்பை நகலெடு",
  "w2412b392": "ஃபோனிலிருந்து, எல்லா ஆப்களுக்கும் முழு உரையாடல்கள். இதைச் செயல்தவிர்க்க முடியாது. காப்பகப்படுத்திய உரையாடல்கள் தொடப்படாது.",
  "w2431c29c": "உங்கள் மீட்பு சொற்கள்",
  "w247edbab": "இந்தப் பங்குள்ளவர்களின் பெயர்கள், அரட்டையிலும் உறுப்பினர் பட்டியலிலும் இந்த நிறத்தில் காட்டப்படும்.",
  "w24887941": "ரிலே சர்வர்",
  "w24a3727e": "ஃபோனில் இந்த ஆப்புக்கு அல்ல",
  "w24c5991f": "இப்போது அனுப்பு",
  "w24d471a9": "தலைப்பு",
  "w25219998": "அனைவரும்",
  "w2521aec6": "இது மதிப்பாய்வு செய்யப்படுவதை அதன் டெவலப்பர் பார்ப்பார்.",
  "w252f6233": "ரிலேயைச் சரிபார்க்கிறது",
  "w25a2cf5e": "முன்",
  "w25db363e": "இணைப்புகள்",
  "w25e620c0": "அழைப்புக்குத் திரும்பு",
  "w2610cd9d": "நீங்கள் விரும்பும் குறுஞ்செய்திகளைப் பிடிக்கும் ஒரு அடையாளத்தை முடக்கவும்.",
  "w263688a5": "மாடரேட்டருக்கு மேலே",
  "w265915f3": "நிராகரி",
  "w26640fd7": "எதிரொலி நீக்கம்",
  "w2666d2dd": "நெருக்கமாகப் பார்",
  "w26be6f70": "ஒரு உரையாடலின் அறிவிப்பில் குமிழ் பொத்தான் உள்ளது: அந்த உரையாடலைத் திரையின் ஓரத்தில் வைத்திருக்க அதை அழுத்தவும். அகற்ற ஒரு குமிழை X-க்கு இழுக்கவும்.",
  "w2721e1c1": "குழு இல்லை",
  "w2743e320": "உறுப்பினருக்குக் கீழே",
  "w27492d1e": "கோப்பிலிருந்து செருகுநிரலை ஏற்று",
  "w275452c0": "பங்கின் பெயர்",
  "w2795452e": "சேரும் நண்பர்களிலிருந்து அடையாளப்பெயர்களைச் சேர்க்கவும்.",
  "w27acf320": "சாதனங்கள்",
  "w27d1a499": "குரல்",
  "w27e9404f": "பகிர அதன் குறியீட்டை நகலெடு",
  "w27f54f07": "@yourname",
  "w27fed862": "குறுஞ்செய்திகள் இயக்கத்தில்",
  "w285156c6": "செருகுநிரலை ஒட்டு",
  "w287fbd40": "சிஸ்டம் செய்திகள்",
  "w28c56f7b": "செய்திகள் ஏற்றப்படுகின்றன…",
  "w28c78dd8": "உங்கள் ஸ்பீக்கர் ஒலி மைக்ரோஃபோனில் நுழையாமல் தடுக்கிறது. ஹெட்ஃபோன்களுக்கு மட்டும் முடக்கவும்.",
  "w28d12b38": "குழுவிலிருந்து அகற்று",
  "w28e7f8a6": "இந்தச் சாதனத்தில்",
  "w28f57d87": "ஆம் என்றால் அந்தச் சாதனம் உங்கள் கணக்கின் அனைத்துடனும் நீங்களாக உள்நுழையும். நீங்களே அமைக்கும், உங்கள் முன் உள்ள சாதனத்திற்கு மட்டுமே இதைச் செய்யுங்கள். வேறொருவர் காட்டும் அல்லது அனுப்பும் குறியீட்டுக்கு ஒருபோதும் வேண்டாம், அவர் யார் என்று சொன்னாலும்.",
  "w5ddabd1a": "Uplink-இன் இந்த நகலில் Google Messages உதவியாளர் இல்லை. அதைப் பெற Uplink-ஐப் புதுப்பிக்கவும்.",
  "w2995a010": "குழுச் செய்திகளுக்காக, Android இந்த ஃபோனின் எண்ணைச் சொல்ல முடியும்படி.",
  "w29aa2b03": "உங்கள் நண்பர்களுக்கு மட்டுமே அனுப்பப்படும், ரிலே சர்வருக்கு ஒருபோதும் இல்லை. உங்கள் நிலை ஸ்பேஸ்களிலும் வட்டங்களிலும் காட்டப்படும்.",
  "w29ab6f83": "இயக்கு",
  "w29afc29b": "இரவு 10 முதல் காலை 7 வரை அமைதி",
  "w29d4cc91": "அழைப்புகளில் குரல்",
  "w29f524a0": "குழுவின் பெயரை மாற்று",
  "w2a25b834": "matrix.org",
  "w2a41e194": "குறுஞ்செய்திகள் முடக்கத்தில்",
  "w2a4989a9": "என்ன செய்கிறீர்கள்?",
  "w2a527296": "இந்தப் பங்கு இனி இல்லை.",
  "w2a6c0786": "ஒரு நாள் அல்லது நேரம்: \"வெள்ளி 7 மணிக்கு\", \"நாளை காலை 9:30\", \"நவ 20\". அது நிரப்பப்பட்டு நாள்காட்டி திறக்கும்.",
  "w2aa367bb": "எதிர்வினைகள்",
  "w2ab34d71": "அடுத்தது, முந்தையது ஆகியவை காட்டப்பட்டபடி பட்டியலில் கீழும் மேலும் செல்லும். தாவு என்பது எந்த உரையாடலையும் பெயர் அல்லது எண் மூலமும், ஆப்பின் இடங்களையும் கண்டறியும்.",
  "w1a2ee4c9": "உங்கள் ஃபோனில் Uplink-இல் Google Messages அமைக்கப்பட்டுள்ளது, எனவே அங்குள்ள ஒவ்வொரு உரையாடலும், RCS மற்றும் குறுஞ்செய்திகள், அதன் வழியாக ஏற்கனவே இந்தக் கணினியில் காட்டப்படுகிறது.",
  "w2ad4892e": "வட்டங்கள்",
  "w2b183663": "கோப்பு",
  "w2b429339": "செருகுநிரலைச் சமர்ப்பி",
  "w2b4d3cb6": "microsoft.com/devicelogin-ஐத் திறக்கவும்",
  "w2b6a4084": "அழைப்பை அதன் மெனுவிலிருந்து பதிவு செய்யவும். ஒவ்வொரு குரலும் பெயருடன் தனி டிராக், ஆம் என்று சொன்னவர்களின் குரல்கள் மட்டுமே அதில் இருக்கும்.",
  "w2b87faa8": "கீழே நகர்த்து",
  "w2b957729": "கோப்பில் சேமி",
  "w2b9ecb0e": "தொடர்ந்து இயங்கவிடு",
  "w2be026b7": "கையொப்பமிட்ட அறிக்கையை, அதன் BEGIN வரி முதல் END வரி வரை ஒட்டவும். சரிபார்க்க எதுவும் எங்கும் அனுப்பப்படாது.",
  "w2c0113fa": "புதிய குழு…",
  "w2c041143": "உரை அளவு",
  "w2c1dea14": "ரிலே சர்வர் இணைக்கப்படவில்லை (அமைப்புகள் › வழிகள்).",
  "w2c3d6fce": "இப்போது வேண்டாம்",
  "w2c4978c2": "புதிய வாக்கெடுப்பு",
  "w2c4b8e58": "இயல்புநிலை SMS ஆப்",
  "w70219c8a": "Uplink மீண்டும் Google Messages-இன் அறிவிப்புகளைப் படிக்கும்.",
  "w2c74506c": "Wi-Fi-இலிருந்து அனுமதி",
  "w2cc30838": "கடவுச்சொல்",
  "w2d07f80d": "பதிவை நீக்கு",
  "w2d4e6f1c": "விசையை மறந்துவிடு",
  "w2da820fd": "WhatsApp-ஐ இணை",
  "w2df4b23f": "வெளியீடு",
  "w2e37ce06": "திரைப்பிடிப்புகளில் எந்த உண்மையான நபரின் குறுஞ்செய்திகளும் எண்ணும் இல்லை என்பதைச் சரிபார்க்கவும்.",
  "w2e52ed02": "நிறம் இல்லை",
  "w2e743309": "உங்கள் சாதனங்கள்",
  "w2ecca61d": "நிறம்",
  "w2f4385e9": "உங்கள் செருகுநிரலின் பக்கத்தில் யார் வேண்டுமானாலும் பார்க்கக் காட்டப்படும்.",
  "w2f487f5a": "உங்கள் தொடர்புகளில் இல்லாத எண் அனுப்பியது போன்ற ஒரு குறுஞ்செய்தி, ஆப் இயக்குவது போலவே செருகுநிரல் வழியாக இயக்கப்படும்.",
  "w2f5ab953": "விசைகளுக்காகக் காத்திருக்கிறது…",
  "w2fa17c82": "ஆழ்ந்த உறக்கத்தில் (அசையாமல், சார்ஜரில் இல்லாமல், நீண்ட நேரம் திரை அணைந்து) Android எல்லா ஆப்களின் நெட்வொர்க்கையும் துண்டிக்கிறது. புதிய குறுஞ்செய்திகள் இன்னும் கணினியை அடையும், ஏனெனில் Android அவற்றை அனுமதிக்கிறது. பேட்டரி பயன்பாடு கட்டுப்பாடற்றது என இல்லாவிட்டால், கணினியில் நீங்கள் தட்டச்சு செய்வது ஃபோன் விழிக்கும் வரை அங்கேயே காத்திருக்கும்.",
  "w2fb366b1": "கட்டம்",
  "w2fbd40bd": "உங்கள் திரையைப் பகிர்",
  "w2fd91673": "இதை இயக்கு",
  "w2ff06cb8": "அதனுடன் என் பயனர்பெயரையும் அனுப்பு",
  "w2ffcbe05": "சோதி",
  "w30025399": "சேரு",
  "w301078a8": "விசை எதுவும் பயன்படுத்தாதே",
  "w304dd841": "வைக்கப்பட்ட உரையாடல்கள்",
  "w304ff7fb": "எதுவுமில்லை",
  "w30869b3a": "என் சமர்ப்பிப்புகள்",
  "w19a50d43": "இந்தச் சாதனத்தில் மட்டுமே வைக்கப்படும். ஒவ்வொன்றும் Uplink மதிப்பாய்வாளருக்கு முத்திரையிடப்பட்டுச் சென்றது; யார் புகார் செய்தார் என்று அந்த நபரிடம் சொல்லப்படவில்லை.",
  "w309e8830": "வேறு கணக்கில் உள்நுழை",
  "w30c3d5af": "சாதனத்திலேயே, அதற்குச் சொந்த மாடல் இருந்தால் அதைக் கொண்டு கணக்கிடப்படுகிறது. எதுவும் எங்கும் அனுப்பப்படாது.",
  "w30d7a3f0": "Android-இன் குறுஞ்செய்திச் சேமிப்பு",
  "w31018b9f": "தோற்றம்",
  "w31040a8e": "இயல்புநிலை SMS ஆப்பாக அமை",
  "w3122bf93": "3. அதை உள்ளிடுங்கள்",
  "w314fd914": "எல்லா குறுக்குவழிகளையும் மீட்டமை",
  "w3153f49f": "இணைப்பு உதவியாளர்கள் வழியாக மட்டும்",
  "w31eaddb7": "விசைப்பலகைக் குறுக்குவழிகள்",
  "w3224f29d": "யார் செய்யலாம்",
  "w325afcc3": "குழுவின் படம்",
  "w328d0986": "ஐகானின் இடத்தில் காட்டப்படும்",
  "wefd0fb63": "பிறகு Google Messages-இன் அறிவிப்புகள் தேவையில்லாமல், படங்கள், எதிர்வினைகள், உங்கள் செய்திகள் எப்போது டெலிவர் ஆகின, படிக்கப்பட்டன என்பவற்றுடன் ஒவ்வொரு உரையாடலும் Uplink-இல் இருக்கும்.",
  "w32b423b8": "இந்த அழைப்பின் மேல் வரிகளை மடி",
  "w33075dc6": "யாரும் தடுக்கப்படவில்லை",
  "w33b81462": "{n} பேர்",
  "w33d00698": "நிர்வாகிகள் எல்லாவற்றையும் செய்யலாம், நிர்வாகி தவிர எல்லாப் பங்குகளையும் வழங்கலாம். உரிமையாளர் நிர்வாகிகளை நியமிக்கிறார்.",
  "w33ff9c8a": "இன்னும் குறியீடுகள் இல்லை",
  "w341dd0c9": "அழை",
  "w342d13ab": "அவர்கள் இணைப்பு மூலம் திரும்ப வரலாம்.",
  "w345b73db": "விசை, குரல், குரல்களின் பட்டியல் ஆகியவற்றை இந்தச் சாதனத்திலிருந்து அகற்றும். நீங்கள் அங்கே நீக்கும் வரை விசை உங்கள் ElevenLabs கணக்கில் இருக்கும்.",
  "w34829816": "அழைப்புகளில் உங்கள் குரல்",
  "w349607a1": "இந்தக் கணினியையும் அமை",
  "w34a08ec8": "அவர் வெளியேறுவார், திரும்ப வர முடியாது; இங்கே யாரும் அவரைக் கேட்க மாட்டார்கள்",
  "w34a28ea7": "இது மறையாக்கப்பட்டுச் சென்றது (அமைப்புகள் › மறையாக்கம்).",
  "w34a3d9ed": "டெவலப்பர்",
  "w35196aeb": "இந்தக் கணினியில் Google Messages-ஐ அமை",
  "w35349f17": "PIN அமை",
  "w353d4c36": "குழுவுக்கு நகர்த்து…",
  "w35afca3b": "ரத்துசெய்",
  "w35f4f501": "களஞ்சியத்திலிருந்து, tool/ghost-api.mjs மூலம் app.info-ஐ அழைக்கிறது.",
  "w3605ba72": "செய்தி விளைவுகள்",
  "w362a5c83": "பூட்டு இந்தச் சாதனத்தில் மற்றவர்களை ஆப்பிலிருந்து வெளியே வைக்கிறது. ஆப் வைத்திருப்பதை அது குழப்புவதில்லை: இந்தச் சாதனத்தின் கோப்புகளைப் படிக்கக்கூடியவரை அது தடுக்காது. அறிவிப்புகள் இன்னும் வரும். PIN மீண்டும் படிக்க முடியாத குழப்பப்பட்ட சரிபார்ப்பாக மட்டுமே வைக்கப்படுகிறது, எனவே மறந்த PIN-ஐ மீட்டமைக்க முடியாது: மீண்டும் நுழைய ஒரே வழி, இந்தச் சாதனத்தில் ஆப் வைத்திருப்பதை நீக்குவதுதான்.",
  "w364259ba": "நீங்கள் படிக்கும் மற்ற மொழிகள்",
  "wdd7db203": "ஃபோனின் கேமரா இதை Uplink-இல் \"இந்த ரிலேயைப் பயன்படுத்தவா?\" என்பதில் திறக்கும்.",
  "w369278aa": "சந்தையிலிருந்து அகற்று",
  "w36a87cc2": "ஸ்லைடு செய்தால் உடனே நீக்கப்படும். அமைப்புகள் › எழுதுதல்-இல் மீண்டும் கேட்கச் சொல்லவும்.",
  "w36c34fca": "சிஸ்டம் ஸ்பேஸ்",
  "w36e8b900": "Id",
  "w36f01477": "புதிய வட்டம் அல்லது வட்டத்தில் சேரு",
  "wa469f175": "Android-இல் Uplink-க்குக் குமிழ்கள் முடக்கப்பட்டுள்ளன, எனவே எதுவும் தோன்றாது. இயக்கத் தட்டவும்.",
  "w37242a7f": "நேரத்தை மாற்று",
  "w3739d97b": "உங்கள் தற்போதைய கடவுச்சொல்",
  "w375868c0": "நபர்கள் மீதான புகார்கள்",
  "w37643ef1": "மற்ற அனைத்தும்",
  "w37a27889": "அமைப்புகள் › நான்-இல் எப்போது வேண்டுமானாலும் உங்கள் சொற்களை மீண்டும் பாருங்கள்",
  "w37cf08ac": "நாளை வரை (காலை 9)",
  "w37df1997": "அறிக்கையைப் பகிர்",
  "w37faa8f6": "ஐந்து அல்லது ஆறு இலக்க எண்ணிலிருந்து (சேவை வழங்குநர்களிடம் பதிவுசெய்த நிறுவனம்) வரும் குறுஞ்செய்திக்கு இன்னும் ஒரு அடையாளம் தேவை. கடுமை அல்லது மிகக் கடுமையில் இல்லை.",
  "w381d190f": "அறிவிப்புகள்",
  "w381fb08f": "இந்த உரையாடலுக்கு மட்டும். மற்ற ஒவ்வொரு உரையாடலும் தன் தோற்றத்தை வைத்திருக்கும்.",
  "w383958aa": "குறுஞ்செய்திகள் உங்கள் மொழிக்கு மொழிபெயர்க்கப்படும். நீங்கள் படிக்கும் மொழியில் உள்ளவை அப்படியே விடப்படும்.",
  "w383d7504": "உருவாக்கத்தில் · மதிப்பாய்வு செய்யப்படவில்லை",
  "w388ef77d": "நாள்காட்டியில் சேர்",
  "w3894d61e": "பட்டியலின் அளவை மாற்று",
  "w38962952": "ஆப்பைப் பூட்டு",
  "wcc8f0c19": "முதல் வரி முதல் கடைசி வரை அனைத்தையும் ஒட்டவும். எவரும் இதை Uplink-இல் அல்லது நிலையான கருவிகளுடன் சரிபார்க்கலாம்: \"கணக்குகள் எப்படி வேலை செய்கின்றன\" பக்கம் எப்படி என்று சொல்கிறது.",
  "w38d5c3ab": "அதன் CSS-ஐயும் பயன்படுத்து",
  "w38f39455": "Spotify",
  "w3902f681": "இந்த ஃபோன்",
  "w391c9a2f": "புதிய ஸ்பேஸ்",
  "w3930d631": "மேலும் சொல்லுங்கள்",
  "w3d258474": "பதிலாக Uplink-ஐ இயல்புநிலையாக்கு",
  "w39fbfb25": "அனைவருக்கும், அழைப்பில் இயக்குவதை நிறுத்து",
  "w3a1e488b": "பின்தொடர நினைவூட்டல்கள்",
  "w02df1303": "Google Messages-க்குப் பதிலாக Uplink-இன் அறிவிப்புகள்",
  "w3a92424c": "இரண்டு சேனல்கள்; முடக்கத்தில் ஒன்று அனுப்பும்.",
  "w3acb1348": "நிறுவனத்தின் பெயரில்",
  "w3ade6bf8": "ஃபோன் எண்",
  "w3affa0a4": "JSON, படங்கள் மற்றும் கோப்புகளுடன்",
  "w3b250031": "குழுவை நீக்கு",
  "w3b6e61f5": "எங்கே தேடுகிறது",
  "w3ba01f91": "இதை என்ன அழைப்பது",
  "wb9377939": "Uplink-இல் திற",
  "w3c334689": "கோப்புறையின் பெயரை மாற்று",
  "w3c4e7def": "எழுதுதல்",
  "w3c818941": "இது இங்கே ஏறவில்லை, எனவே இது என்ன செய்யும் என்று சொல்ல முடியாது: சரிபார்ப்புகளைப் பாருங்கள்.",
  "w3c8971e8": "உங்கள் அடையாளப்பெயர்",
  "w3cabe0e0": "இது இனி இல்லை.",
  "w3cd7077e": "இழையில் பதிலளி",
  "w3ce54284": "அதன் உள்நுழைவுத் திரையில் உள்ள குறியீட்டை ஸ்கேன் செய்யவும்",
  "w3d36c4b7": "குழு ஏற்றப்படுகிறது",
  "w3d7ce883": "இது எங்கே உள்ளது",
  "w3d815333": "ElevenLabs விசை",
  "w3d9a60a1": "செய்தி முன்னோட்டங்கள்",
  "w3d9cac04": "ஒரு நேரத்தில் ஒருவர்: குழு உரையாடல்களும் படங்களும் எப்போதும் போலவே செல்லும். விசைகள் குறுஞ்செய்தி மூலம் பயணிக்கின்றன, எனவே யாரும் ஒன்றை மாற்றவில்லை என்பதை உறுதிசெய்ய பாதுகாப்பு எண்ணை நேரில் அல்லது அழைப்பில் ஒப்பிடவும். முன்னோக்கு ரகசியம் இல்லை: இது Signal-இன் நெறிமுறை அல்ல. முத்திரையிட்ட குறுஞ்செய்தி நீளமானது, எனவே அதிகக் குறுஞ்செய்திகள் செலவாகலாம். வேறு எந்த ஆப்புக்கும் முத்திரையிட்ட குறுஞ்செய்தி ஒரு வரி எழுத்துகள்தான்.",
  "w3daa059c": "இந்தத் தொகுப்பு சந்தை பட்டியலிடுவது அல்ல. இதை அங்கீகரிக்க வேண்டாம்.",
  "w3dd9b2eb": "ஒரு பூட்டு",
  "w3de75d7a": "நட்புக் கோரிக்கையை ஏற்கவும்",
  "w3dfa3cdb": "சிறியது",
  "w3e142d5e": "உரை",
  "w3e24bc4e": "படத்தைப் பயன்படுத்து",
  "w3e61a915": "ஸ்பீக்கர் அல்லது ஹெட்செட்",
  "w3e6b0ae4": "வீடியோ அழைப்பு",
  "w3e6e40d9": "Google Messages-இல் உள்ள ஒவ்வொரு உரையாடலும், RCS மற்றும் குறுஞ்செய்திகள், அவற்றின் வரலாறு, படங்கள், எதிர்வினைகளுடன் இங்கே காட்டப்படும். இதற்கு ஒருமுறை, சில நிமிடங்கள் ஆகும்.",
  "w3e77ce7e": "பங்குகள்",
  "w3e892b4d": "தேர்ந்தெடு",
  "w3ea1ddb6": "Notion-இல், Settings › Connections › Develop or manage integrations-ஐத் திறந்து, உள்ளடக்கத்தைப் படிக்க மட்டுமே முடிந்த ஒரு உள் ஒருங்கிணைப்பை உருவாக்கி, அதன் ரகசியத்தை நகலெடுக்கவும். பின்னர், வட்டம் பார்க்க வேண்டிய ஒவ்வொரு பக்கம் அல்லது தரவுத்தளத்திலும் ••• › Connections-ஐத் திறந்து ஒருங்கிணைப்பைச் சேர்க்கவும்.",
  "w3eb6f4a6": "உத்தரவாதங்கள்",
  "w3ec8c276": "ஆப்பில் உள்ள நண்பர்கள், குறுஞ்செய்தி மூலம் எவரும், அல்லது இணைப்பு.",
  "w3f1acf5a": "உங்கள் கணினியில் Google Messages உதவியாளரை இயக்குவது, இயங்கவைத்திருப்பது எப்படி.",
  "w3f1d0df5": "வட்டத்தில் உள்ள அனைவருக்கும்",
  "w3f609f74": "ஒலியடக்கு",
  "w4fa02c6a": "Uplink அறிக்கை",
  "w6ec44673": "காலி: Uplink-இன் சொந்தம்.",
  "w3fe56f97": "கோப்பிலிருந்து நிறுவப்படும் ஒவ்வொரு ஆப்புக்கும் Android இதைச் செய்கிறது. ஒருமுறை மட்டுமே கேட்கப்படும்.",
  "w3ff50c63": "வகை",
  "w4007046f": "கருத்தைப் பகிர்",
  "w400d340b": "உங்கள் சொற்களைச் சரிபார்க்கவும்",
  "w400e3a19": "ஊகம்",
  "w40893334": "உங்கள் கணக்கு தயார்",
  "w409e0289": "கைரேகை அல்லது முகம் மூலம் திற",
  "w40ac694b": "ஸ்மார்ட் பரிந்துரைகள்",
  "w40dec4c0": "அழுத்திப் பேசு",
  "wd05c5d04": "உங்கள் செய்திகள் இந்தச் சாதனத்திற்கும் Microsoft-க்கும் இடையே மட்டுமே செல்கின்றன. Uplink-இன் சர்வர்கள் அவற்றைப் பார்ப்பதில்லை; Microsoft திருப்பித் தரும் உள்நுழைவு மட்டுமே இந்தச் சாதனத்தில் வைக்கப்படும்.",
  "w414eb5b3": "சுருக்கம்",
  "w415d5103": "ஒரு பதிலைச் சேர்",
  "w417197c7": "Signal மற்றும் Telegram",
  "w41aeab49": "இந்தச் சாதனங்களில் உள்நுழைந்துள்ளது",
  "wd14b6c34": "Uplink-இலிருந்து அகற்று",
  "w420c41bf": "ஒரு வரி, இதை வைத்திருக்கும் அனைவருக்கும் காட்டப்படும்: \"தேவையில்லாத குறுஞ்செய்திகளை ஒலியடக்குகிறது\".",
  "w4238f419": "இந்த ஃபோன் மற்றொன்றை அடையும் வழிகள், மேலிருந்து முயற்சிக்கப்படும். தோல்வியடையும் அல்லது பதில் கிடைக்காத ஒன்று அடுத்ததுக்கு வழிவிடும்.",
  "w426a7894": "இணைப்பு இருந்தாலும், நிரந்தரமாக வெளியே வைக்கப்பட்டது.",
  "w426d0f16": "இவற்றில் ஏதேனும் உள்ள குறுஞ்செய்தி, வேறு என்ன சொன்னாலும், ஒருபோதும் ஸ்பேம் அல்ல.",
  "w4278a9ab": "உங்களுக்கு அனுப்பப்பட்ட உள்நுழைவுக் குறியீடுகள், புதியவை முதலில், இங்கே காத்திருக்கும். ஒரு தட்டல் ஒன்றை நகலெடுக்கும்.",
  "w427dc9df": "ஒலியளவு, இரைச்சல் குறைப்பு, சாதனங்கள் இப்போதே மாறும்; மற்றவை நீங்கள் சேரும் அடுத்த அழைப்பிலிருந்து.",
  "w427dd82e": "இன்னும் இந்த ஆப்புக்கு இல்லை",
  "w42978f02": "பதிலாக ஐகானைப் பயன்படுத்து",
  "w42df4a3a": "உங்கள் செய்திகளைப் போலவே முத்திரையிடப்பட்டது",
  "w430d41c3": "உணவு டெலிவரி",
  "w4347fd2a": "@everyone",
  "w435b2c09": "அல்லது Google Messages மற்றும் RCS-ஐ வைத்திருங்கள்",
  "w436a48b8": "Android-இன் குமிழ் அமைப்பு",
  "w43da853a": "டோக்கனை நகலெடு",
  "w44037998": "மதிப்பாய்வு செய்யப்பட்டது",
  "w443efca6": "வணக்கம் என்பது ஒரு குறுஞ்செய்தியின் இறுதியில், எப்போதாவது, அதன் செலவைக் கூட்டாத இடங்களில் மட்டும் சேர்க்கப்படும் மூன்று கண்ணுக்குத் தெரியாத எழுத்துகள். மற்ற ஆப்கள் அவற்றைக் காட்டுவதில்லை. வேறு எதுவும் அனுப்பப்படாது: உங்களில் ஒருவர் இயக்கு என்பதைத் தட்டி ஒரு விசையை அனுப்பி, மற்றவர் ஏற்றால் மட்டுமே மறையாக்கம் தொடங்கும். நடுவில் யாரும் இல்லை என்பதை நீங்கள் சரிபார்க்கும் வழி பாதுகாப்பு எண்.",
  "w4473ce98": "இந்த ஃபோனிலிருந்தும் உங்கள் கணினியிலிருந்தும்.",
  "w44a25f95": "இங்கே புதியவரிடமிருந்து வரும் முதல் செய்தி அவர்களின் பதிலுக்காகக் காத்திருக்கும். ஏற்கனவே அங்குள்ள அரட்டைகளும் உங்கள் தொடர்புகளும் ஒருபோதும் நிறுத்திவைக்கப்படாது.",
  "w44dbc0af": "ஒரு கணினியை இணை",
  "w45570065": "இருள்",
  "w457da6e2": "Noto Color Emoji மற்றும் Noto Emoji © Google (SIL OFL 1.1). Twemoji © Twitter மற்றும் பங்களிப்பாளர்கள் (CC-BY 4.0). எல்லா எமோஜிகளும் திறந்த மூல எமோஜி மற்றும் ஐகான் திட்டமான OpenMoji வடிவமைத்தவை (CC BY-SA 4.0).",
  "w45854fe5": "ABC123",
  "w45a45a1a": "இந்தச் சரிபார்ப்பைத் தவிர்",
  "w45a493c1": "இணையம் வழியாக அனுப்பப்பட்டது",
  "w45b8fbd6": "பட்டியலில் வைத்திரு",
  "w45c847c3": "கோப்புகளைப் பதிவேற்று",
  "w45d0ca30": "ElevenLabs-இன் சொந்தக் குரல்களும், நீங்கள் அங்கே உருவாக்கிய அல்லது சேமித்தவையும். உங்கள் குரல் செய்திகள், நீங்கள் தேர்ந்தெடுக்கும் குரலில், நீங்கள் சொன்ன விதத்தை வைத்திருக்கும்.",
  "w45d455f7": "குறிப்பேடு சொல்வது",
  "w45e8590d": "ரிலேயை ஹோஸ்ட் செய்",
  "w46047125": "Messages-இல் வைத்திரு",
  "w460d8283": "நண்பர்களின் ஒவ்வொரு குழுவுக்கும் ஒரு ஸ்பேஸ் உண்டு. + மூலம் உங்களுக்கென ஒன்றை உருவாக்கி, பயனர்பெயர் மூலம் சேர்த்த நண்பர்களுடன் பகிருங்கள்.",
  "w460e705a": "ஒவ்வொரு கட்டளையும் அதன் விசைகளும்",
  "w4639c964": "சந்தையில் திற",
  "w46543360": "குறுஞ்செய்தி வரும்போது இயங்கும், அதன் அறிவிப்பின் ஒலியும் இதுவே. கேட்க ஒன்றைத் தட்டவும்.",
  "w58ff44c6": "நாட்டுக் குறியீட்டுடன் உங்கள் WhatsApp எண். Uplink WhatsApp-இலிருந்து எட்டு எழுத்துக் குறியீட்டைப் பெறும்: உங்கள் ஃபோனில் WhatsApp-இல், Settings › Linked devices › Link a device › Link with phone number instead, பின்னர் அதை அங்கே தட்டச்சு செய்யவும்.",
  "w4681fa0b": "புகார் செய்",
  "w46b35716": "வட்டத்தின் பக்கப்பட்டியின் மேலே ஒரு அகலமான படம்",
  "w46b51b11": "இந்த ஃபோனில் இல்லை",
  "w4732e1ad": "நீங்கள் சேர்க்காதவர்களிடமிருந்து அங்குள்ள அரட்டைகள், குறுஞ்செய்திகளைப் போல.",
  "w474dd088": "ஒரு நகலைச் சேமி",
  "w47615ad2": "@username மூலம் தேடு",
  "w476dd918": "இணைப்பிலிருந்து செருகுநிரலை ஏற்று",
  "w478d190e": "சரிபார்க்கப்படவில்லை",
  "w479ef2ba": "முடிவு",
  "w47b10f8f": "இந்த இணைப்பை வேறொரு திரையில் திறக்கவும்",
  "w482562f1": "உங்கள் குமிழ்கள்",
  "w483075a5": "புதுப்பிப்புகள்",
  "w4841b654": "நினைவூட்டல்கள்",
  "w48671743": "வேறொரு திரையில் காட்டு",
  "w48cba6f4": "அவர்களைத் தடுக்க எதுவும் தெரியவில்லை",
  "w48e6867b": "யாரும் உங்கள் திரையைப் பார்க்க முடியாது என்பதை உறுதிசெய்யவும். இந்த வரிசையில் அவற்றை எழுதிக்கொள்ளுங்கள்.",
  "w4918d3ff": "உங்கள் சொந்த வார்த்தைகள்",
  "w491dfa70": "எப்போதும் ஸ்பேம்: வார்த்தைகள்",
  "w49225a69": "இந்த இணைப்பை அகற்று",
  "w4930944f": "ஃபோன்",
  "w495b647f": "குரல் மற்றும் வீடியோ",
  "w49739e07": "@username",
  "w4a0b977a": "அதனுடன் வந்தவை",
  "w4a3c1d17": "அந்தக் குறியீட்டைப் பயன்படுத்த முடியவில்லை",
  "w4a4d97d4": "ஆப்பில் உள்ள ஒவ்வொரு வார்த்தையின் அளவு.",
  "w4a4f02e3": "ஒலி மற்றும் அதிர்வு",
  "w4a9dbd96": "ஸ்பேஸிலிருந்து வெளியேறு",
  "w4aa0c939": "அது சரியாகத் தெரியவில்லை",
  "w4acc8d6d": "வட்டத்தின் பெயரை மாற்று",
  "w4ae97e34": "இயங்கும்போது அது எழுப்பிய பிழைகள், அல்லது மறுக்கப்பட்டவை: புதியவை முதலில்.",
  "w4b058728": "அமைப்புகள்",
  "w4b0d0736": "உங்கள் ஃபோன் அனுப்புகிறது, பெறுகிறது",
  "w4b0e487e": "ஒரு சோதனையை அனுப்பி எந்த வழி அதைக் கொண்டுசெல்கிறது என்று பார்க்க ஒன்றை அழுத்தவும்.",
  "w4b73db5c": "படம், உங்கள் சேவை வழங்குநர் அனுமதிக்கும் அளவில், படச் செய்தியாகச் செல்லும்.",
  "w4b7d3589": "அது நின்றுவிட்டது",
  "w4b7f7705": "நிறுத்து",
  "w4baad7b9": "பின்னணி, மேற்பரப்பு, உரை, முதன்மை நிறங்களைத் தேர்ந்தெடுக்கவும்",
  "w4be168d5": "இன்னும் குறிப்புகள் இல்லை.",
  "w4be2a5e6": "கோப்புறையை நீக்கு, உள்ளே இருப்பதை வைத்திரு",
  "w4beb7b5f": "ஓய்வு அறிவிப்பை உருவாக்கு",
  "w4c08521d": "சந்தையில் தேடு",
  "w4c3db76c": "திருத்தத்தைச் சேமி",
  "w4c49a720": "ஏற்றப்பட்டது",
  "w4cb34ba8": "இன்னும் எந்தச் செருகுநிரலும் முழு வட்டத்திற்கும் வேலை செய்வதில்லை.",
  "wee028012": "இந்த ஃபோனில் Uplink-இலிருந்து Google Messages இணைப்பை நீக்கவா?",
  "w4cdfbf51": "இந்த ரிலேயைப் பயன்படுத்து",
  "wd044d74c": "ஃபோன் மூலம் ஒரு குறியீட்டை ஸ்கேன் செய்யவும். இணைக்கப்பட்டதும் Uplink மீண்டும் திறக்கும்.",
  "w4d03f766": "ஏதாவது கேளுங்கள்",
  "w4d2d5d68": "சேமி",
  "w5e8f8600": "இன்னும் யாரும் இல்லை. Uplink உள்ள ஒருவருடனான உரையாடல் இதை ஒரு பேனரில் வழங்கும், அல்லது எந்த உரையாடலையும் திறந்து, மேலே உள்ள பெயரைத் தட்டி, மறையாக்கம் என்பதைத் தேர்ந்தெடுக்கவும்.",
  "w4da2a5bd": "அதைப் பார்த்த அவர்களின் நண்பர்களுக்குத் தெரிவிக்கப்படும்; அது கணக்கில் சேராது",
  "w4e19c606": "வட்டத்தை நீக்கு",
  "w52fff3ec": "Uplink உள்ள ஒருவருடன், உங்கள் குறுஞ்செய்திகள் உங்கள் இரு ஃபோன்கள் மட்டுமே படிக்கும்படி முத்திரையிடப்பட்டுச் செல்லும். உங்கள் சேவை வழங்குநரும் அல்ல, எந்த ஃபோனிலும் உள்ள வேறு ஆப்பும் அல்ல.",
  "w4e3a55cb": "மைக்ரோஃபோன் அளவு",
  "w4e3af9c3": "கேட்கப்பட்டது",
  "w4e4f9879": "விரிதாள்",
  "w4eaa258a": "காத்திருப்பதை நிறுத்து",
  "w4eaf7c92": "தீம்",
  "w4ed3795c": "அவர்கள் பகிர்ந்தபடி அவர்களின் எண்",
  "w4ee3157e": "அறியப்பட்ட சேவைகள் மட்டும்",
  "w4ef0ddc5": "ஒலிகள்",
  "w4f0e0677": "இப்போது சரிபார்",
  "w4f34d900": "மேலும்",
  "w4f856dd8": "பகிர்",
  "w4fa961d2": "ஒரு எடுத்துக்காட்டிலிருந்து தொடங்கு",
  "w4fb346bc": "செய்தியின் வார்த்தைகள். முடக்கத்தில், அறிவிப்பு \"புதிய செய்தி\" என்றும் யாரிடமிருந்து என்றும் சொல்லும்.",
  "w4fe8ce16": "Mac அல்லது PC-இல்",
  "w4feff1ca": "அவை வர உங்கள் ஃபோன் இயக்கத்திலும் ஆன்லைனிலும் இருக்க வேண்டும். ஃபோன் இயக்கத்தில் இல்லாமலே இது Google Messages-ஐ அடைய வேண்டுமென்றால் இந்தக் கணினியையும் அமைக்கவும்.",
  "w50692b2d": "ரிலே சர்வர் இணைக்கப்படவில்லை, எனவே இந்த ஸ்பேஸின் அமைப்புகளை இப்போது அணுக முடியாது.",
  "w50b26149": "ஏற்கவும்",
  "w50d99212": "ஏன்?",
  "w50f96afb": "நெட்வொர்க்கில் உள்ள உங்கள் தொடர்புகள், நீங்கள் எழுதிய அரட்டை, நெட்வொர்க்கின் சொந்தக் கணக்கு மற்றும் பாட்கள் (உள்நுழைவுக் குறியீடுகள் அவற்றிலிருந்து வரும்).",
  "w514db25e": "உங்கள் செய்திகளை Android வைத்திருக்கிறது, இந்த ஆப் அல்ல: வேறொரு ஆப்பை இயல்புநிலையாக்கினாலும் ஒவ்வொன்றும் அங்கேயே இருக்கும்.",
  "w60c1fcc3": "ஒவ்வொரு Google Messages அறிவிப்பும் வரும்போதே மறைக்கப்படும், Uplink தனது அறிவிப்பைக் காட்டும். அதிலிருந்து பதிலளிப்பது Google Messages வழியாகச் செல்லும், அரட்டை RCS எனில் RCS ஆக.",
  "we53d3759": "உங்கள் சர்வரின் குரல் சேனல்கள் Messages-இல் ஸ்பேஸ்களின் குழுவாக, இப்போது ஒவ்வொன்றிலும் யார் இருக்கிறார்கள் என்பதுடன் தோன்றும். இங்கிருந்து சேர ஒன்றை அழுத்தவும்: Uplink-இன் பாட் ஒலியையும் அரட்டையையும் இருவழியிலும் கொண்டுசெல்லும்.",
  "w51c9b498": "என் மீட்பு சொற்களைக் காட்டு",
  "w52276a2e": "என் Android ஃபோனை இணை",
  "wd80deb6e": "கணினியில் Uplink காட்டும் குறியீட்டை ஸ்கேன் செய்யவும்.",
  "w5249c127": "எந்த விளையாட்டு இயங்குகிறது என்று ஃபோனால் பார்க்க முடியாது. உங்கள் நண்பர்கள் என்ன விளையாடுகிறார்கள் என்பதைக் காட்டும்.",
  "w52776c59": "இந்த நெட்வொர்க்கில் உள்ள சாதனங்கள்",
  "wb6ee6ed1": "Uplink-க்கான Android பக்கத்தைத் திற",
  "w52a26161": "ஒரு .ghostplugin கோப்பு: செருகுநிரலின் விதிகளும், அது தன்னைப் பற்றிச் சொல்வதும்.",
  "w52f50eae": "முகப்பு",
  "w5313f0c3": "இரண்டு டிக்குகள்",
  "w533c874e": "உறுப்பினர்கள் அல்லது பங்குகளைத் தேடு",
  "w533e823e": "மதிப்பாய்வாளருக்கு",
  "w5354638e": "டிக்குகள்",
  "w538b10e9": "திற",
  "w53af8357": "ஏற்றுகிறது",
  "w53b05655": "மொழிபெயர்ப்பு Android ஃபோனில் இயங்கும். இங்கே மொழிபெயர்க்க இந்த iPhone-ஐ ஒன்றுடன் இணைக்கவும்.",
  "w53bd4b7c": "உங்கள் மொழி",
  "w53c15d23": "உங்கள் ElevenLabs விசையைச் சேர்க்கவும்",
  "w53cc3579": "அதன் வார்த்தைகள், எங்கிருந்தும் நகலெடுக்கப்பட்டவை.",
  "w53d4ad44": "விற்பனை & விளம்பரதாரர்கள்",
  "w53dc6303": "QR குறியீட்டைக் காட்டு",
  "w53e1368c": "ஸ்பேஸ்களில் குறிப்பிடல்கள்",
  "w53eb4bfa": "இது அதன் முகவரி. இது உங்களுக்கு மட்டுமே உரியது, உங்கள் மீட்பு சொற்களை ஏற்கும் எந்த வாலட்டிலும் இதுவே இருக்கும்.",
  "w54960a28": "SMS ஸ்பேஸ்",
  "w54a7f7c2": "ஸ்பேஸை உருவாக்கு",
  "w54bc0377": "இந்த ஃபோனின் முகவரி",
  "w552dcf42": "ஸ்பேம், அரசியல் குறுஞ்செய்திகள், கடன் வசூலிப்பவர்கள், விற்பனையை அமைதிப்படுத்து",
  "w552dfeb9": "உங்கள் சர்வர்",
  "w553e4727": "கடைசியாகப் பெற்ற குறுஞ்செய்தி",
  "w553f2a4e": "உங்கள் படத்தை அகற்று",
  "w55585659": "தாளில், இந்த வரிசையில், பாதுகாப்பான இடத்தில் வைத்திருங்கள். இந்த 12 சொற்களே உங்கள் கணக்கு: இவற்றைக் கொண்டு கடவுச்சொல் இல்லாமல் உள்நுழையலாம், தொலைந்தால் யாராலும் திருப்பித் தர முடியாது.",
  "w558413c8": "எல்லா உரையாடல்களும்",
  "w55994575": "அரட்டையைத் திற",
  "w55be78f5": "சிக்கல்களை நகலெடு",
  "w5620c3f2": "உங்கள் படத்தில் நண்பர்களும் தொடர்புகளும் பார்ப்பது. கண்ணுக்குத் தெரியாதது ஆஃப்லைன் போலத் தோன்றும்; நீங்கள் இன்னும் செய்திகளை அனுப்பலாம், பெறலாம்.",
  "w563c2765": "உங்கள் கணக்கின் கடவுச்சொல் அல்ல, ஆப் கடவுச்சொல்லைப் பயன்படுத்தவும். Bluesky-இல் ஒன்றை உருவாக்கவும்: Settings › Privacy and security › App passwords › Add, \"Allow access to your direct messages\" டிக் செய்யப்பட்டு. அதை எப்போது வேண்டுமானாலும் அங்கே திரும்பப் பெறலாம்.",
  "w567e667f": "தொடர்பில் இருத்தல்",
  "w568337a3": "அனுப்பப்பட்டது.",
  "w568a960f": "எதிர்பார்ப்பவர்கள்",
  "w56920966": "ஒரு ஆப் எவ்வளவு ப்ராசஸரைப் பயன்படுத்துகிறது என்று அவை சொல்வதில்லை: அங்கே வரிசை நினைவகம், ஃப்ரேம்கள், தடங்கல்களைக் காட்டும்.",
  "w570b1811": "எல்லா ஸ்விட்சுகளும் இயக்கத்தில்",
  "w570eb3e4": "மெதுவாக. ஃபோனிலிருந்து நகலெடுத்த பதிவு, பாக்கெட்டில் இருந்தபோது ஆப் என்ன செய்தது என்று சொல்வது இப்படித்தான்.",
  "w57103a89": "இங்கே விவரிக்கவும்",
  "w7463f772": "Uplink-இல் சேர்",
  "w577ad4d7": "இந்த ரிலேயுடன் இணைந்திரு",
  "w5797ea6a": "நீக்கு",
  "w5830328b": "குறியீட்டுடன் RCS-ஐ முடக்கு",
  "w583f3ef6": "நான் இங்கே இருப்பதை நண்பர்களுக்குச் சொல்",
  "w586a260f": "நண்பர், குழு அல்லது ஸ்பேஸுடனான அரட்டையில்: குறிகள் தேர்ந்தெடுத்த வார்த்தைகளைச் சுற்றி இடப்படும். குறுஞ்செய்தி அவற்றை எழுதியபடியே காட்டும், எனவே அங்கே அவை சேர்க்கப்படாது.",
  "w586f52e3": "அனுமதிக்கப்பட்டது",
  "w5879a2d3": "ஸ்பேம் அல்ல",
  "w5897b738": "` இல் அழுத்திப் பேசு போல, ஒரே விசையில் உள்ள கட்டளை நீங்கள் தட்டச்சு செய்யும்போது காத்திருக்கும், எனவே அந்த விசை இன்னும் தட்டச்சு செய்யும். Cmd, Ctrl அல்லது Alt உள்ள கட்டளை எங்கும் வேலை செய்யும்.",
  "w58d5108a": "ஒவ்வொரு உரையாடலும் எந்த வழியில் உள்ளது",
  "w58de0b99": "இப்போதைய அதன் பட்டியல் பக்கம்",
  "w58de7b9a": "திரும்பப் பெறு",
  "w58e096de": "பற்றி",
  "w58e61b43": "சென்றது",
  "w58eaef39": "நிராகரி",
  "w32aab299": "RCS அமைக்கப்பட்டது. Uplink ஒவ்வொரு உரையாடலையும், RCS மற்றும் குறுஞ்செய்திகளைக் காட்டும், பதில்கள் Google Messages வழியாகச் செல்லும்.",
  "w592fdd05": "விளைவுகள்",
  "w5938f69b": "மீண்டும் இயக்கு",
  "w595ff4fd": "செய்தியை நீக்கு",
  "w59708c88": "இந்த ஃபோனில்",
  "w5971756a": "உங்கள் கணக்கு விசை",
  "w59997b30": "அழைப்பு அனுப்பு",
  "w59ad6e57": "அனைத்தையும் நீக்கு",
  "w59b1ca1b": "ஒரு நேரத்தில் ஒரு தாவல்",
  "w59b7d2c5": "உங்கள் உலாவியில்",
  "w59d5646b": "ஸ்லைடு செய்து நீக்கும் முன் கேள்",
  "w59f8a2fc": "கணக்கு",
  "w59fdbd70": "ஒத்திசைவை நிறுத்து",
  "w5a05d9b5": "காட்சி",
  "w5a1f318f": "Android ஃபோனை இணை",
  "w5a256c75": "அமைப்புகள் மற்றும் அனுமதிகள்",
  "w5a3b3d12": "அது எதிலும் தவறவில்லை",
  "w5a3f4ae6": "நீங்கள் பார்த்ததை வார்த்தைகளில் சொல்லுங்கள், அல்லது உங்கள் ஃபோன் அல்லது கணினியில் உள்ள ஆப்பிலிருந்து திரைப்பிடிப்புகளை அனுப்புங்கள்.",
  "w5a7bf6df": "இசையின் ஒலியளவு",
  "w5a91f77c": "சவுண்ட்போர்டு",
  "w5aa6e8e3": "அரட்டைக்கு அனுப்பு",
  "w5aa7eec3": "குழுவிலிருந்து அகற்று",
  "w60df8b2d": "Uplink id",
  "w5abe5677": "மேற்கோள்",
  "w5aff8be0": "நீண்ட இணைப்பு தொடர்ந்து வேலை செய்யும்.",
  "w5b60e265": "மதிப்பாய்வுக்கு எதுவும் காத்திருக்கவில்லை.",
  "w5b67c80c": "வீடியோ",
  "w5b8151eb": "உங்கள் ஃபோன் எண்ணுடன் இணை",
  "w5c0615b1": "https://… அல்லது you@example.com",
  "w5c14b1c3": "டீபக் பில்டுகளில் புதுப்பிப்புகள் முடக்கத்தில்.",
  "w5c2fec4d": "புதிய சாதனத்தை அடைகிறது",
  "w5c4c4278": "Authorization: Bearer <token>",
  "w5c6010b7": "உங்கள் ஃபோனில் Google Messages-ஐத் திறந்து, உங்கள் சுயவிவரப் படத்தைத் தட்டி, Device pairing, பின்னர் QR code scanner-ஐத் தட்டி, இந்தக் குறியீட்டை நோக்கிக் காட்டவும்.",
  "w5c745d53": "அறிவிப்பைக் காட்டாவிட்டால், திரை அணைந்த சில நிமிடங்களில் Android ஒரு ஆப்பை நிறுத்திவிடும், ஆப் அதை மறைக்கவும் அனுமதிக்காது. Android அனுமதிக்கும் அளவுக்கு இது அமைதியானது: அறிவிப்புப் பலகையின் அடியில் ஒரு வரி, ஐகான் இல்லை, ஒலி இல்லை. Android பக்கத்தில் அதை முடக்க அழுத்தவும்; கணினி இன்னும் ஃபோனை அடையும்.",
  "w5c8aa732": "அதன் முகம்",
  "w5ca266a6": "உங்கள் பங்கு",
  "w5cc2cc15": "உங்கள் தொடர்புகளைப் படிக்கிறது…",
  "w5ccea9ba": "ஆப் இல்லாதவர்கள் குறுஞ்செய்தி மூலம் இதில் இருப்பார்கள், உங்கள் ஃபோனிலிருந்தும் உங்கள் எண்ணிலிருந்தும் அனுப்பப்படும்.",
  "w5d7e4c90": "RCS-ஐ அமை",
  "w5d8e29e5": "உரிமங்கள்",
  "w5d9c9718": "கட்டுப்படுத்தப்பட்ட அமைப்புகளை அனுமதி",
  "w5db48b37": "கோப்புகளை வரிசைப்படுத்து",
  "w62ea5708": "இதை mautrix-gmessages (GNU AGPL) அடிப்படையிலான திறந்த மூல உதவியாளர் செய்கிறது, Uplink-இன் சர்வர்கள் வழியாக அல்ல, நேரடியாக Google-உடன் பேசுகிறது.",
  "w5dcdd537": "பதிப்பு",
  "w5ddb3d62": "ஸ்பேஸ்கள்",
  "w5e066c0e": "அழைப்புகளில் மற்ற ஒலிகளைக் குறை",
  "w5e439ffe": "மறையாக்க விரும்புகிறார்: உங்கள் ஒப்புதலுக்காகக் காத்திருக்கிறது",
  "w5e6a7440": "சந்தை",
  "w5e6abf3b": "Opus, அழைப்புகள் பயன்படுத்தும் கோடெக். 510 kb/s ஸ்டீரியோவே அது கொண்டுசெல்லும் அதிகபட்சம்: மைக்ரோஃபோனிலிருந்து காது வேறுபடுத்த முடிவதற்கும் மேல். நேரலை அழைப்பால் FLAC-ஐக் கொண்டுசெல்ல முடியாது.",
  "w5ebd2c27": "ஒரு சிறிய கணக்கு, ஒரு வாக்கியத்திலிருந்து தேர்ந்த ஒரு சொல், அல்லது ஒரு புதிர், ஒருமுறை அனுப்பப்பட்டு, இது உங்கள் ஆப்பின் தானியங்கு சரிபார்ப்பு என்று சொல்லும். சரியான பதில் அரட்டையை Messages-க்குக் கொண்டுவரும்; தவறான பதிலுக்கு இன்னொரு முயற்சி, பிறகு அது நிறுத்திவைக்கப்படும்.",
  "w5ef944a4": "நீங்கள் பயன்படுத்தும் தோற்றத்தின் மேல் உங்கள் சொந்த ஸ்டைல்களை எழுதுங்கள். ஆப் :root-இல் அமைக்கப்பட்ட --app-accent போன்ற CSS மாறிகளைப் படிக்கும். ஆப்பை வரைவதை அல்லது படிப்பதைத் தடுக்கும் எதுவும் விடப்பட்டு கீழே பட்டியலிடப்படும்.",
  "w5f010dc8": "பதிவில் எதுவும் இல்லை",
  "w5f146018": "Google மூலம் உள்நுழை",
  "w5f186b29": "படம்",
  "w5f74079c": "என் சாதனங்களில் செருகுநிரல்களை ஒத்திசை",
  "w5f7ba28a": "Discord சர்வரைச் சேர்",
  "w5fa0a1bc": "முகவரியை நகலெடு",
  "w5fae222e": "மைக்ரோஃபோன், கேமரா மற்றும் ஸ்பீக்கர்",
  "we7380e22": "கோப்புகள் ஸ்பேஸ்கள் இன்னும் உலாவியில் இல்லை. இது ஃபோன் அல்லது கணினியில் உள்ள Uplink-இல் திறக்கும்.",
  "w602f49ca": "பதிலாகக் குறியீட்டை ஒட்டு",
  "w60643421": "நகலெடுக்கும்போது படிக்கப்படும்",
  "w60649cb8": "புதிய விசையை அனுப்பினார்: அதைச் சரிபாருங்கள்",
  "w6072a740": "வரவேற்புச் செய்தி",
  "w609d253c": "அழைக்கப்பட்டார்",
  "w60b827ca": "குரல் மாற்றப்படும் முன் உங்களுக்குப் பின்னால் உள்ள அறையின் ஒலி நீக்கப்படும்.",
  "w60d0e94e": "ஆன்மாக்கள் மற்றும் பேட்ஜ்கள்",
  "w60e47df0": "இயக்கம்",
  "w610d5670": "பின்னணி இரைச்சலை நீக்கு",
  "w616a6784": "தானியங்கு",
  "w617f0a28": "ஸ்பேமில் உள்ள உரையாடல்களை ஒலியடக்கு",
  "w61e3374c": "இந்த உரையாடல்",
  "w61e6be1a": "இல்லை",
  "w61e9eac0": "எண்",
  "w4ee7b3f5": "Google Messages-இன் அறிவிப்புகளை அனுமதித்தே வைத்திருங்கள் (அமைதி என அமைக்கவும்): RCS அரட்டைகளைப் பார்க்க Uplink அவற்றைப் படிக்கிறது. முழுவதுமாக முடக்கினால், Uplink புதிதாக எதையும் பார்க்காது.",
  "w62889f8b": "இரவில் தெரியாதவர்களுக்கு அமைதி",
  "w6296794f": "அது தடுக்காதவை",
  "w62af68ae": "ரிலே முகவரி",
  "w62e395aa": "எப்போது வேண்டுமானாலும் மீண்டும் முடக்கலாம்.",
  "w630eebb5": "அதன் பட்டியல் பக்கம்",
  "w63156b2e": "கோப்புறையை நீக்கு",
  "w63496325": "ஸ்பேஸைச் சேர்",
  "w639e7cd0": "வட்டத்தின் பெயர்",
  "w63cc7b7a": "நண்பர்கள்",
  "w640b8949": "எங்கிருந்தும், நேரடி வழியாக",
  "w6426ce4b": "உரையை நகலெடு",
  "w6486c996": "சில வார்த்தைகள் (விருப்பத்தேர்வு)",
  "w64cb88d2": "பெரியது",
  "w64e30406": "ஆப் மூடியிருக்கும்போது",
  "w64ecd2ec": "இந்தத் தீமின் மேல் உங்கள் சொந்த ஸ்டைல்களை எழுதுங்கள்",
  "w650280c9": "அறிவிப்பு காட்டுவது",
  "w654f8e88": "அவை பொருந்தவில்லை",
  "w658f3664": "நகலெடு",
  "w66139a7e": "செருகுநிரலை ஒட்டவும்",
  "w66150877": "முடக்கத்தில்: புதுப்பிக்காத சாதனங்கள் அதை வைத்திருக்கும். இயக்கத்தில்: அவை ஒவ்வொன்றிலும் அது முடக்கப்படும்.",
  "w664022f4": "புதிய உறுப்பினர்கள் வந்து சேரும் இடம், வரவேற்பு காட்டப்படும் இடம்",
  "w66a27845": "உங்கள் ஃபோன் வழியாக RCS",
  "w66c48cc0": "குறுஞ்செய்தி மூலம் ஒருவரைச் சேர்",
  "w66de7a09": "விளக்கம்",
  "w66fdce0c": "இதற்குப் பிறகு பூட்டு",
  "w671a85e3": "எண்களுக்குப் பதிலாகப் பெயர்களும் படங்களும். இது இல்லாமல் மற்ற டெவலப்பர்களின் செருகுநிரல்கள் எதையும் பார்க்காது, ஏனெனில் உங்கள் தொடர்புகளையும் அந்நியர்களையும் அவற்றால் வேறுபடுத்த முடியாது.",
  "w674255c6": "சந்தையிடம் மீண்டும் கேள்",
  "w6756e280": "இந்த அழைப்பைப் பதிவு செய்",
  "w3dd4cc64": "உலாவியில் Uplink",
  "w67b18f6b": "இப்போதைக்கு உங்கள் சொந்தக் குரல்",
  "w67d59f13": "குறுஞ்செய்திகள் சாதனத்திலேயே மொழிபெயர்க்கப்படுகின்றன, ஒருபோதும் எங்கும் அனுப்பப்படுவதில்லை. ஒவ்வொரு மொழியின் மாடல் அளவு ",
  "w67e00bc7": "நான்",
  "w688c7c4a": "அனைத்தையும் அகற்று",
  "w688d41ff": "இன்னும் இதை ஏற்கும் சர்வர்களுக்கு. matrix.org மற்றும் Matrix Authentication Service பயன்படுத்தும் மற்றவை உலாவி மூலம் மட்டுமே உள்நுழையும்.",
  "w688e1aca": "இயல்புநிலை SMS ஆப் அல்ல",
  "w68b19886": "படித்த ரசீதுகள்",
  "w68e6cb10": "ஐகான்",
  "w691586d8": "உங்கள் பயனர்பெயர், கடவுச்சொல் அல்லது மீட்பு சொற்களுடன்",
  "w693d7cb7": "பக்கத்திலிருந்து குறியீடு",
  "w6966e24b": "நீங்கள் உள்ள ஸ்பேஸில் இருப்பவர்கள் அங்கே உங்கள் சுயவிவரத்தில் இதைப் பார்ப்பார்கள்.",
  "w6974ad65": "நெட்வொர்க்",
  "w698d2695": "உரையாடலை நீக்கு",
  "w69960bb6": "தோற்றம்",
  "w69975ed7": "பதிலை நகலெடு",
  "w69b2e45d": "எமோஜி தொகுப்பு",
  "w69c677b4": "உள்ளூர் நெட்வொர்க் மூலம் மட்டும்",
  "w6a75a25f": "பதிலுக்காகக் காத்திருக்கும் குறுஞ்செய்தியின் கீழ், எழுதும் பெட்டிக்கு மேலே மூன்று குறுகிய பதில்கள்.",
  "w6aadbedc": "இன்னும் பதிவுகள் இல்லை",
  "w6ac8ead1": "நிர்வாகி பயனர்பெயரும் கடவுச்சொல்லும். உங்கள் கணக்கு (@matt) மட்டுமே உள்நுழைய முடியும், இந்தச் சாதனம் இணைக்கப்பட்டிருக்கும்போது மட்டுமே.",
  "w6af21072": "அனைத்தையும் தேர்ந்தெடு",
  "w6b12f001": "வரவில்லை",
  "w6b190f49": "உள்நுழைவுக் குறியீடுகளுக்குத் தளர்வு",
  "w6710e4fc": "உங்கள் செய்திகள் இந்தச் சாதனத்திற்கும் Google-க்கும் இடையே மட்டுமே செல்கின்றன. Uplink-இன் சர்வர்கள் அவற்றைப் பார்ப்பதில்லை; Google திருப்பித் தரும் உள்நுழைவு மட்டுமே இந்தச் சாதனத்தில் வைக்கப்படும்.",
  "w6b3f7c19": "முறைகள்",
  "w6b489a0c": "ஒரு உரையாடல் திரையின் ஓரத்தில் குமிழாக இருந்து, நீங்கள் செய்வதன் மேலே திறக்கலாம்.",
  "w6b54192f": "உங்கள் நண்பர்களுக்கும், உங்கள் சுயவிவரத்தைத் திறக்கும் உங்கள் ஸ்பேஸ்கள், வட்டங்களில் உள்ளவர்களுக்கும் காட்டப்படும்.",
  "w6b871c31": "உங்கள் கணக்கைத் திறக்கிறது",
  "w6b91874f": "கடுமை நிலை",
  "w6bbc4b1a": "புதிய உறுப்பினர்கள் எங்கே வந்து சேர வேண்டும்?",
  "w6bc02927": "elevenlabs.io-இல், Developers › API keys-ஐத் திறந்து ஒன்றை உருவாக்கவும். அதைக் கட்டுப்படுத்தினால், Voice Changer பயன்படுத்தவும் Voices படிக்கவும் அனுமதிக்கவும்.",
  "w6c150a2f": "உங்கள் காப்புப்பிரதியைப் புதுப்பிக்கவும்",
  "w6c48f1fa": "இந்தக் கணக்கு உண்மையில் நீங்கள்தான் என்று ஒரு நண்பர் ஓராண்டுக்கு உத்தரவாதம் அளிக்கலாம். நீங்கள் வைத்திருக்கும் உத்தரவாதங்களை உங்கள் நண்பர்கள் பெறுவார்கள், ஒவ்வொருவரும் தங்கள் சொந்த நண்பர்கள் அளித்தவற்றை மட்டுமே எண்ணுவார்கள்: அனைவரின் மொத்த எண்ணிக்கை ஒருபோதும் காட்டப்படாது.",
  "w6c4bc446": "செய்தியின் மெனுவில் \"எனக்கு நினைவூட்டு\", மேலும் நீங்கள் ஏதாவது வாக்குறுதி அளிக்கும் குறுஞ்செய்திக்குப் பிறகு ஒரு பரிந்துரை.",
  "w440d1541": "Uplink-இல்",
  "w6ceb2d06": "வெள்ளை",
  "w6cef8c0f": "உறுதிப்படுத்தப்படவில்லை",
  "w6d06cd6d": "இந்தப் பதிப்பு",
  "w6d0cf831": "இவற்றை எழுதிக்கொள்ளுங்கள்",
  "w6d24a6aa": "ஒருவர் உங்களுக்கு அனுப்பிய அல்லது நீங்கள் சேமித்த .ghostlook",
  "w6d267c97": "அனைத்தையும் படித்ததாகக் குறி",
  "w6d37cd09": "Notion டோக்கன்",
  "w6d9a358c": "நீக்கு, மீண்டும் கேட்காதே",
  "w6dc2158f": "உள்நுழைவுக் குறியீடு, QR குறியீடாக",
  "w6de7fb69": "தோல்வியடையும் படச் செய்தி, உரையாடலில் அதன் கீழே காரணத்தைச் சொல்லும். தொடர்ந்து தோல்வியடைந்தால், அறிக்கையை நகலெடுத்து உதவுபவருக்கு அனுப்பவும்.",
  "w6e0b77c2": "இன்னும் எதுவும் அனுப்பப்படவில்லை. ஒன்றை உருவாக்கியதும் செருகுநிரலைச் சமர்ப்பிக்கவும்.",
  "w6e5157ff": "அமைதி இரவு 10–காலை 7",
  "w6e631bbc": "இந்தக் கலவையைப் புதிய பதிவாகச் சேமி",
  "w6e78b439": "மிக்ஸரை மூடு",
  "w6e828855": "மேலே உள்ள வரிகள் உரையாக. இதில் செய்திகள், பெயர்கள், எண்கள் இல்லை.",
  "w6e91c16e": "சேமி என்பது எண் நிரப்பப்பட்ட புதிய தொடர்பைத் திறக்கும்; தடு என்பது அதை Android-இன் தடுக்கப்பட்ட எண்களில் சேர்க்கும்; இப்போது வேண்டாம் என்பது அந்த உரையாடலுக்கு அந்த வரியை மறைக்கும்.",
  "w6ee050df": "API-ஐ வழங்கு",
  "w6eeeb86c": "டெலிவரிகள் & கண்காணிப்பு",
  "w6eeeddf4": "எண் சரிபார்க்கப்பட்டது",
  "w6efabaa4": "இணைப்பைப் பகிர்…",
  "w6f42681d": "கடைசியாக அனுப்பியது",
  "w6fcfdc72": "\"ஸ்பேமுக்கு நகர்த்து\" அனுப்புநரை எப்போதும் பட்டியலிலும், \"ஸ்பேம் அல்ல\" ஒருபோதும் பட்டியலிலும் சேர்க்கும்.",
  "w6fd020b4": "இடைநிறுத்தப்பட்டது: இது ஆப்பை மெதுவாக்கியது.",
  "w6fd69264": "புதிய சாதனத்தில் உள்நுழை",
  "w700560f3": "முகவரி",
  "w7013fdad": "ஒரு வட்டம் சிலரையும் அவர்களின் ஸ்பேஸ்களையும் ஒன்றாக வைத்திருக்கும்: அரட்டை மற்றும் குரலுக்கு, குறுஞ்செய்திக்கு, அல்லது கோப்புகளுக்கு.",
  "w7046920d": "Play Store-இல் வரும் வரை",
  "w704c607e": "யாருமில்லை",
  "w707cd633": "Google Messages-உடன் சேர்ந்து பயன்படுத்து",
  "w708e8f26": "நேரடி இணைப்பு மூலம் மட்டும்",
  "w70927964": "என் குரல்களை மீண்டும் படி",
  "w70ad7706": "புதுப்பிப்புகளைச் சரிபார்",
  "w70b70268": "தொடர்போ இல்லையோ, ஒருபோதும் ஸ்பேம் அல்லாத எண்கள், மின்னஞ்சல் முகவரிகள் அல்லது பெயர்கள்.",
  "w70c44780": "Telegram, Signal மற்றும் பல",
  "w70f0c463": "அறிக்கையை நகலெடு",
  "w70f81095": "சேவை வழங்குநரால் அறிவிக்கப்பட்டு இன்னும் பெறப்படாதவை. ஆப் திறக்கும் ஒவ்வொரு முறையும் மீண்டும் கேட்கப்படும்; இப்போதே கேட்கத் தட்டவும்.",
  "w710d76d5": "உள்நுழையும்போது திறத்தல், விழித்திருத்தல்: வழிகாட்டி.",
  "w71945ea4": "ஃபோன் கண்டறியப்படவில்லை என்றால்",
  "w71d55b4d": "அவற்றின் வரிசையும் தலைப்புகளும்",
  "w71fd4acf": "செயல்தவிர்",
  "w7c602f92": "இன்னும் எதுவும் இல்லை. கணினியில் உள்ள Uplink இந்த ஃபோனின் உரையாடல்களைக் காட்டி, அதன் வழியாகக் குறுஞ்செய்திகளை அனுப்பும். குறுஞ்செய்தி அனுப்புவது ஃபோன் மட்டுமே.",
  "w722bbd7c": "இந்த ஃபோனுக்குப் புதிய விசையை உருவாக்கவா? ஒவ்வொரு உரையாடலும் மீண்டும் பரிமாறப்படும் வரை அனைவருடனும் மறையாக்கம் முடிவடையும், பழைய விசையில் முத்திரையிட்ட குறுஞ்செய்திகளை அதன் பிறகு திறக்க முடியாது.",
  "w722c85cd": "நெட்வொர்க் எதுவும் தேர்ந்தெடுக்கப்படவில்லை",
  "w72430853": "இயக்கு",
  "w724acd86": "நண்பர்கள், குறுஞ்செய்தி அல்லது இணைப்பு",
  "w728f78a8": "இந்த ஃபோனில் மட்டும் மாற்று",
  "w72b479cf": "குறியீடு உள்ள குறுஞ்செய்திக்கு இன்னும் ஒரு அடையாளம் தேவை: உண்மையான குறியீடுகள் பெரும்பாலும் இணைப்புக்கு அருகில் \"இது நீங்கள் இல்லையென்றால், உடனே செயல்படுங்கள்\" என்று சொல்லும். கடுமை அல்லது மிகக் கடுமையில் இல்லை.",
  "w72c64ad8": "இன்னும் உலாவியில் இல்லை",
  "w72dd87c3": "RCS",
  "w7341967e": "இணைக்கப்பட்ட கணினிகள்",
  "w7363d9be": "உள்ளூர் நெட்வொர்க்",
  "w73690b65": "காப்பகப்படுத்து",
  "w736b33b8": "Discord-இல் திற",
  "we4bc19fe": "Uplink உள்ளவர்களைக் கண்டறியவும்",
  "w744be623": "உள்நுழை",
  "w748c09c2": "ஒரு வரிக்கு ஒரு விளையாட்டின் பெயர், காட்டப்படுவது போல.",
  "w74aa0307": "கணக்கு விசையைப் பகிர்",
  "w74f576af": "ஒலியளவு",
  "w75244c0a": "உங்கள் ElevenLabs குரல்கள்",
  "w755d6675": "நீங்களே இயக்கியது போல, அதன் அமைப்புகளின் ஸ்விட்சுகள் அனைத்தும் இயக்கத்தில்.",
  "w758add25": "குறியீடுகள்",
  "w75afe364": "அனைத்தும்",
  "w75c5531a": "குரல் செய்தியை அனுப்பு",
  "w75ceeba7": "சவுண்ட்போர்டு ஒலியளவு",
  "w75dd326a": "விருப்பத்தேர்வு · இணைக்கப்படவில்லை",
  "w75e9d1ad": "ஒவ்வொரு செருகுநிரலின் அமைப்புகளும் சந்தையில் அதன் பக்கத்தில் உள்ளன.",
  "w75fa677f": "ஒவ்வொரு புதிய உறுப்பினரும் இதை வரவேற்பு ஸ்பேஸின் மேலே பார்ப்பார். {name} என்பது அவரின் பெயர். எதுவும் வேண்டாமெனில் காலியாக விடவும்.",
  "w76139e92": "Android இதற்கான ஃபோனுக்குள் உள்ள மாடலை Wi-Fi மூலம் பதிவிறக்குகிறது. அது வந்ததும் சுருக்கங்கள் தொடங்கும்; எதுவும் எங்கும் அனுப்பப்படாது.",
  "w7617834a": "என்னை இப்படிக் காட்டு",
  "w76419bf3": "சோதித்துப் பார்க்க ஒரு குறுஞ்செய்தி",
  "w7664c180": "மதிப்பாய்வு வரிசையிலிருந்து வெளியே.",
  "w769d4ae8": "புகார்கள்",
  "w76a95f12": "அடுத்த வாரம் வரை (திங்கள், காலை 9)",
  "w7747493b": "சிறப்புத் தேர்வுகள்",
  "w77488b99": "உலாவியில்",
  "w7788402d": "ஒவ்வொரு மொழியும் சுமார் 30 MB, ஒரு குறுஞ்செய்திக்கு முதல் முறை தேவைப்படும்போது ஒருமுறை பதிவிறக்கப்படும்.",
  "w77b3e4d1": "அரட்டைப் பின்னணி",
  "w7809558c": "அழைப்பைத் தொடங்கு",
  "w7845047b": "முன்னோட்டம் எப்படி உருவாகிறது",
  "w786bc275": "இன்னும் எதுவும் இல்லை.",
  "w786e98a7": "அதைப் படிக்கும் ஆப்பில்",
  "w7892ced8": "புதியவர்கள்",
  "w789cf411": "ஏன் (அவர்கள் பார்ப்பார்கள்): \"Windows செயலிழப்பைக் கண்டுபிடித்தார்\"",
  "w78d564d5": "சிலரிடமிருந்து குறுஞ்செய்திகள் வரவில்லை",
  "w78e3e875": "மொழிபெயர்",
  "w7936ddf6": "செருகுநிரலின் பக்க அளவை மாற்று",
  "w7966645f": "முழு ஆப்பும் எப்படித் தோன்றுகிறது. ஒவ்வொரு தோற்றமும் உங்கள் குமிழ்களுக்குத் தனக்கென ஒரு நிறத்தைக் கொண்டுவரும், அதைக் கீழே இன்னும் மாற்றலாம். நான்கு நிறங்கள், ஒரு எழுத்துருவிலிருந்து உங்களுடையதை உருவாக்கி, குறியீடாக அல்லது கோப்பாகப் பகிருங்கள்.",
  "w79832240": "சேர்க்கப்பட்டதும், அதன் அமைப்புகள் இங்கே இருக்கும்.",
  "w79da5575": "படத்தை ஒட்டு",
  "w79de40e1": "ஸ்பேஸிலிருந்து அகற்று",
  "w7a640fec": "Android அனுமதித்தவை",
  "w7a669d4a": "உறுப்புகள் (button, div), எளிய பண்புகள் (color: red) பற்றிய விதிகள் எதுவும் செய்யாது: ஆப் மாறிகளிலிருந்து வரையப்படுகிறது. எழுத்துருக்கள் ஆப்பில் உள்ளவையாக மட்டுமே இருக்கலாம்.",
  "w7a711071": "குறுஞ்செய்திகள் வரும்போதே மொழிபெயர்",
  "w7aa6f0e7": "API",
  "w7ab059ae": "முதலில் அதன் சிக்கல்களைச் சரிசெய்யவும்.",
  "w7b21c29c": "ஆன்மாக்களை வழங்கு",
  "w7b254006": "ஒருபோதும் ஸ்பேம் அல்ல: அனுப்புநர்கள்",
  "w7b297afa": "அதை அகற்று",
  "w7b6d407f": "புதுப்பித்த நிலையில்",
  "w7b8038d9": "ஏன்",
  "w7b8411a2": "சேர்த்து குறுஞ்செய்தி அனுப்பு",
  "w7b8e39a1": "இது முடக்கத்தில் இருக்கும்போது, குறுஞ்செய்தியின் மெனுவிலிருந்து மொழிபெயர் என்பதைத் தேர்ந்தெடுப்பீர்கள்.",
  "w7b99a035": "எதுவுமில்லை: அனைத்தும் சரியாக உள்ளது.",
  "w7bb8f761": "படிக்காத உரையாடல்களைச் சுருக்கு",
  "w7bc5539d": "ஆன்மாக்கள் அட்டை, மீண்டும்",
  "wa0b3b730": "Google Messages ஒரு நேரத்தில் ஒரு வலை அமர்வை மட்டுமே வைத்திருக்கும், உங்கள் ஃபோனில் உள்ள Uplink அதை வைத்திருக்கிறது. இந்தக் கணினி உங்கள் ஃபோன் வழியாக அதே உரையாடல்களைக் காட்டுகிறது.",
  "w7bf69370": "இணைக்கப்பட்டது",
  "w7bfbbbbc": "நேரடி",
  "w7cb6b6f8": "வேறு ஆப் மூலம் அனுப்பு",
  "w7cec082b": "இன்னும் உலாவியிலிருந்து இல்லை",
  "w7cf7aeb3": "ghostapi1:… இது உள்ள எவரும் API-ஐ அழைக்கலாம்: கடவுச்சொல்லைப் போலவே பாதுகாக்கவும்.",
  "w7cfd61b2": "கேள்",
  "w7d0d3efe": "ஒவ்வொரு பதிவும் சேமிக்கப்படும்போது எழுத்தாக்கு",
  "w7d66c7d7": "உரையாடல் அமைப்புகள்",
  "w7db1a648": "என் எண்ணையும் இணைக்கப்பட்ட கணக்குகளையும் நண்பர்களுக்குக் காட்டு",
  "w7dbf917d": "படத்தைத் தேர்ந்தெடுக்கவும்",
  "w7dcce3a5": "இதைப் பகிர்",
  "w7de460ef": "இந்த ஃபோனின் வால்பேப்பரிலிருந்து Android எடுக்கும் நிறங்கள், ஃபோனின் சொந்த ஆப்களும் இவற்றையே பயன்படுத்துகின்றன. வால்பேப்பர் மாறும்போது இதுவும் மாறும்.",
  "w7e09f19b": "இதை இங்கே திரும்பக் கொண்டுவா",
  "w7e11c46d": "உங்களைச் சேர்க்கும் இணைப்பு, QR குறியீடாக",
  "w7e288acb": "எனக்கு மட்டும் ஒலியடக்கு",
  "w7e34b97f": "குறுஞ்செய்தி சொன்னால், குறியீடு அதன் எண்ணுக்குப் பதிலாக அது வந்த நிறுவனத்தின் பெயரால் (Coinbase, Discover) அழைக்கப்படும்.",
  "w7e45c4c5": "வட்டங்களுக்கு",
  "w7eb08fad": "புதியவர் உங்களைச் சேர்த்த குழுவும் நிறுத்திவைக்கப்பட்டு கேட்கப்படும்.",
  "w7eeb8efd": "நீங்கள் இந்த வட்டத்திலிருந்து வெளியேறினீர்கள்.",
  "w7f0282c4": ":root { --app-accent: #ff5c8a; }",
  "w7f18690f": "இன்னும் குரல்கள் இல்லை. உங்கள் விசையைச் சேர்க்கவும், அல்லது அவற்றை மீண்டும் படிக்கவும்.",
  "w7f2c35ea": "இங்கே இயக்கினால், யாரும் சேர்க்காமலேயே இந்த வட்டத்தின் ஸ்பேஸ்களில் ஒவ்வொரு உறுப்பினருக்கும் செருகுநிரல் வேலை செய்யும்.",
  "w7f948750": "எனக்குக் குறியீட்டைக் குறுஞ்செய்தியில் அனுப்பு",
  "w7f97edaa": "இசைக்காக, மைக்ரோஃபோன் அப்படியே: எதிரொலி நீக்கம், இரைச்சல் குறைப்பு, ஆதாயம் இல்லை, நிலையான விகிதத்தில் 510 kb/s ஸ்டீரியோ. ஹெட்ஃபோன்களைப் பயன்படுத்தவும்.",
  "w80324733": "இப்போது நீங்கள் உள்ள இடத்தில் முழுமையாக்கு",
  "w80595241": "ஸ்பேஸ்களுக்கும் வட்டங்களுக்கும் சொல்",
  "w8062364f": "Mastodon-இல் உள்நுழை",
  "w80848996": "Microsoft-இன் பக்கத்தில் நீங்கள் அங்கீகரிக்கக் காத்திருக்கிறது…",
  "w80bbfee7": "இவராகச் சேரு",
  "w80c5c254": "இப்போது இதில் உள்ள எவரும் புதியதில் மீண்டும் உள்நுழைவார்கள்.",
  "w80d8dbd0": "டெவலப்பர் பயன்முறை",
  "w810f664e": "அனுமதிகளை அழி",
  "w812746a9": "வட்டம்",
  "w8128be8c": "குறியீட்டை நகலெடு",
  "w812abd0e": "உங்கள் பள்ளி, உங்கள் வேலை",
  "w812b46de": "உங்களிடம் உள்ள கணக்கிலிருந்து தொடங்கு",
  "w81abc3d7": "என்னைப் பற்றிய அனைத்தையும் அகற்று",
  "w394a471e": "விசை, புதிய விசை, Uplink உள்ளவர்களைக் கண்டறிதல் ஆகியவை ஃபோனில், அமைப்புகள் › மறையாக்கம்-இல் அமைக்கப்படும்.",
  "w81f51acc": "ஆப்",
  "w8210607e": "இந்த ஆப்பில் எமோஜிகள் எப்படி வரையப்படுகின்றன. மற்றவர் பார்ப்பதை அவரின் ஃபோனே வரையும்.",
  "w82241975": "உடனடியானது, இலவசம். ஒரு விளைவு: ஆழமானது, உயர்ந்தது, ரோபோ மற்றும் பல.",
  "w82278ca8": "எதுவும் காப்பகப்படுத்தப்படவில்லை",
  "w824bbd4c": "உங்கள் செய்திகள் Android-இன் சொந்தச் செய்திச் சேமிப்பில் இருக்கும், எனவே வேறொரு ஆப்புக்கு மாறினாலும் அவை அனைத்தும் அங்கேயே இருக்கும்.",
  "w8268ce50": "அதன் அறிவிப்புகளில் எவை இன்னும் ஒலி எழுப்புகின்றன, அவற்றின் கடைசிச் செய்தியின்படி, ஒவ்வொன்றையும் அமைதிப்படுத்தும் வழியுடன்: அதன் உள்வரும் செய்திகள், தனக்கென ஒலி உள்ள எந்த உரையாடலும்.",
  "w826f7f7c": "பதிவேற்று",
  "w829f4dad": "நண்பரைச் சேர்",
  "w82b317a8": "நிர்வாகிகள் மட்டுமே இவற்றை மாற்ற முடியும்.",
  "w82e16a26": "எந்த அடையாளமும் எண்ணப்படும் முன் இவை முடிவு செய்யும். ஒருபோதும் என்பது எப்போதும் என்பதை வெல்லும்.",
  "w8313d4fa": "பதிவை நிறுத்து",
  "w83658a3a": "அதன் நிறங்களும் எழுத்துருவும் மட்டும்",
  "w83666356": "ஒன்றுக்கு மேல் தேர்வு செய்ய அனுமதி",
  "w83787b9a": "தானியங்கு புதுப்பிப்புகள்",
  "w8390060e": "நபர்கள்",
  "w8393950d": "பிழைகள், ஒவ்வொரு படச் செய்தியும்: அது எதுவாக மாற்றப்பட்டது, எவ்வளவு பெரியது, சேவை வழங்குநர் என்ன பதிலளித்தது. கடைசி 300 வரிகள் வைக்கப்படும்.",
  "w839b241a": "இப்போது நீங்கள் எதில் கேட்கிறீர்கள் என்று சொல்லுங்கள், இழப்பில்லாத ஒலி அதற்கு இயங்கும்.",
  "w844f7eb8": "இந்த பில்டில் கிடைக்காது",
  "w847d7bcb": "செருகுநிரல்கள்",
  "w84b358d7": "உள்நுழைவுக் குறியீடு உள்ள குறுஞ்செய்திக்கு அதை நகலெடுக்கும் பொத்தான் கிடைக்கும்.",
  "w8aa21ca7": "Uplink உங்கள் குறுஞ்செய்திகள் இல்லாமலே வேலை செய்யும்: நண்பர்கள், வட்டங்கள், Telegram, Signal. உங்கள் குறுஞ்செய்தி ஆப்பாக அல்லது Google Messages-உடன் சேர்ந்து, இங்கேயும் குறுஞ்செய்திகளைப் படிக்கவும் அனுப்பவும் குறுஞ்செய்திகளை இயக்கவும்.",
  "w84c2de12": "சொற்களை நகலெடு",
  "w84c561ff": "தடையை நீக்கு",
  "w84e87f42": "கேட்பதை முடக்கு",
  "w850360c9": "பதிவை நகலெடு",
  "w855fc3fb": "மெதுவான பயன்முறை",
  "w8570fe3a": "சிறிதாக்கு",
  "w85722a69": "இந்த ஃபோன் ஆஃப்லைனில் உள்ளது. அடுத்த முறை ஆப் முன்னணியில் வரும்போது மீண்டும் பார்க்கும்.",
  "w85e4b82f": "சரி",
  "w86041405": "வார்த்தைகளில் எழுதிய ஃபோன் எண்; உள்நுழைவுக் குறியீடு.",
  "w8b4c37fd": "Uplink இன்னும் இயல்புநிலை அல்ல",
  "w86522cd9": "ஐகான்கள்",
  "w867866f0": "மோசடியாக இருக்கலாம்",
  "w8700fd83": "அனுமதிகள்",
  "w872d71b7": "Google கணக்கில் உள்நுழையாத Google Messages-க்கு, Device pairing-இல் இன்னும் QR code scanner உள்ள இடத்தில்: குறியீட்டை வேறொரு திரையில் காட்டும்.",
  "w878c122d": "உங்கள் குறுஞ்செய்திகளை இங்கே ஒட்ட வேண்டாம்.",
  "w8794388d": "சமீபத்தில் வழங்கியவை",
  "w87a5ea1d": "அமைப்புகள் › டெவலப்பர்-இல் அவற்றை ஏற்றி நிர்வகிக்கவும்",
  "w87e5eacf": "அமைக்கப்படவில்லை",
  "w87f62cb7": "சரிபார்க்கிறது…",
  "w87f6bf6e": "கடவுச்சொல்லை மாற்று",
  "w8815b64f": "அதை இங்கே பயன்படுத்த முடியாது",
  "w881c63cf": "நேரலை",
  "w883c2766": "இந்த எண்ணுக்கு ஒரு குறியீடு குறுஞ்செய்தியில் அனுப்பப்படும், அது திரும்பி வருவது எண் இந்த ஃபோனுடையது என்று காட்டும். ரிலே சர்வரும் அது பயன்படுத்தும் குறுஞ்செய்திச் சேவையும் எண்ணைப் பார்க்கும். வேறு யாருக்கும் சொல்லப்படாது.",
  "w885a2668": "உங்கள் ஃபோன் விசையை வைத்திருக்கிறது",
  "w8882ef8f": "இந்த பில்டில் இல்லை",
  "w88b3c0ac": "படத்தை அகற்று",
  "w88bfa09e": "Lucide (ISC உரிமம்).",
  "w88da30bb": "Signal-ஐ இணை",
  "w8947b567": "WhatsApp-இடம் குறியீடு கேட்கிறது…",
  "w898f1bc6": "மாதிரிகளின் படத்தைச் சேர்க்கவும்",
  "w89a480eb": "உங்கள் எண்",
  "w89af3e62": "அனுமதிக்கப்படவில்லை",
  "w89ffa9c0": "இந்த ஃபோனின் விசை",
  "w8a3dc53e": "ஒரு குழு உங்களை அழைக்கும்போது இயங்கும். கேட்க ஒன்றைத் தட்டவும்.",
  "w8a8f1ae7": "உங்கள் கையொப்பமிட்ட அறிக்கை",
  "w8aa8a89d": "அழைப்புகளில் உங்கள் குரல் எப்படி மாற்றப்பட வேண்டும்?",
  "w8aac0f18": "அவர்களின் உரையாடல்கள் வரும்போதே ஒலியடக்கப்படும். \"ஸ்பேம் அல்ல\" போன்றவை அவற்றை மீண்டும் இயக்கும்.",
  "w8ab96d08": "முன் அல்லது பின்",
  "w8ad2f8cf": "வெளிச்சம்",
  "w8adf1a5f": "ஒரு மணிநேரத்திற்கு",
  "w8ae40328": "இந்தப் பதிவை நீக்கவா? இதைச் செயல்தவிர்க்க முடியாது.",
  "w8af577ef": "உதவிக்கு நன்றி",
  "w8b08b7bb": "புதிய குறியீடு",
  "w8b242db1": "புதியது",
  "w8b3dc597": "இப்போது",
  "w8b4f3c70": "வெளியேறு",
  "w8b838f34": "மீண்டும் ஸ்கேன் செய்",
  "w8b87dd90": "சரிபார்ப்பை அகற்று",
  "w8b8a0c85": "@you:matrix.org",
  "w8b928666": "பாடலின் இணைப்பை ஒட்டவும்",
  "w8b97f7a7": "குறுஞ்செய்திகளைப் பெற விசைப்பலகைக்கு Android-இன் அனுமதி தேவை, புதிய பதிப்புகள் ஸ்டோருக்கு வெளியே உள்ள ஆப்களுக்கு அதை மறுக்கின்றன, மேலும் Android 17 இயல்புநிலை SMS ஆப் தவிர எல்லா ஆப்களிடமிருந்தும் குறியீட்டுக் குறுஞ்செய்திகளை நிறுத்திவைக்கிறது. இந்த ஆப் இயல்புநிலை SMS ஆப், எனவே அதற்குக் குறியீடு உடனே கிடைக்கும்.",
  "w8ba6ad99": "எல்லாம் எப்படி வேலை செய்கிறது, படிப்படியாக, gogho.st/docs-இல்.",
  "w8bbfa856": "குறுஞ்செய்திகள் இங்கேயே பார்க்கப்படுகின்றன, எங்கும் அனுப்பப்படுவதில்லை. எதுவும் நீக்கப்படுவதில்லை அல்லது தடுக்கப்படுவதில்லை: ஸ்பேமில் உள்ள உரையாடல் மற்றவை போலவே திறக்கும், \"ஸ்பேம் அல்ல\" அதை நிரந்தரமாகத் திருப்பி வைக்கும்.",
  "w8c080543": "1. பாட்டைச் சேர்க்கவும்",
  "w8c6744af": "அதன் கடவுச்சொற்றொடர்",
  "w8c7b596f": "முழுவதும் ஸ்லைடு செய்யப்பட்ட உரையாடல் முதலில் கேட்கும். முடக்கத்தில், உடனே நீக்கப்படும்.",
  "w8c848ead": "இதை இங்கே நகர்த்து",
  "w8c856dd1": "Markdown, படங்கள் மற்றும் கோப்புகளுடன்",
  "w8c87fca6": "சேரும் நண்பர்கள்",
  "w8cb56c02": "இந்த ஃபோனின் இணைப்பை நீக்கு",
  "w8d2937a1": "பட்டியலிடு",
  "w8d4bcec1": "ஒரு அறிக்கையைச் சரிபார்",
  "w8d7930b6": "ஒரு படம்",
  "w8d80552f": "யார்",
  "w8d881f4f": "நிர்வாகி உள்நுழைவு",
  "w8d9097e6": "செருகுநிரல் மதிப்பாய்வு",
  "w8d93945f": "உருவாக்கத்தில் உள்ள செருகுநிரல்கள்",
  "w8dd31791": "முடிந்தது",
  "w8de6774a": "விசைகளை மாற்று",
  "w8deb7e3a": "இந்த நகல்",
  "w8deb8e24": "அமைப்புகளை மூடு",
  "w8debcab6": "இங்குள்ள ஒவ்வொரு செய்தியும், இழைகளும், Markdown அல்லது JSON ஆக, விரும்பினால் அதன் கோப்புகளுடன்.",
  "w8e15cbd9": "ஸ்பேஸ்கள், வட்டங்களில் அவர்களின் பெயருக்கு அருகிலும், அவர்களின் சுயவிவரத்திலும் காட்டப்படும்.",
  "w8e2a9ee6": "மிக்ஸரில் திற",
  "w8e483945": "அனுப்புகிறது.",
  "w8e9060c2": "பட மற்றும் குழுச் செய்திகளில்.",
  "w8eafa59a": "Google Messages-இல் உள்ள ஒவ்வொரு உரையாடலும், RCS மற்றும் குறுஞ்செய்திகள், அவற்றின் வரலாறு, படங்களுடன் இங்கே காட்டப்படும். உங்கள் ஃபோன் இயக்கத்திலும் ஆன்லைனிலும் இருக்க வேண்டும்: செய்திகள் அதன் வழியாகச் செல்கின்றன.",
  "w8eba1d51": "முடக்கத்தில், YouTube, Spotify, SoundCloud, Vimeo, TikTok, X, Reddit போன்றவற்றுக்கான இணைப்புகளுக்கு மட்டுமே அட்டை கிடைக்கும்.",
  "w8f037c2f": "ஆப் முன்னணியில் இருக்கும்போதெல்லாம் புதிய பதிப்பைத் தேடும்.",
  "w8f3184bc": "சிஸ்டம்",
  "w8f4719c7": "இது gogho.st-இலிருந்து தானாகப் புதுப்பித்துக்கொள்ளும்: புதிய பதிப்பு பின்னணியில் பதிவிறக்கப்பட்டு, மறுதொடக்கம் செய்யும்போது அல்லது அடுத்த முறை வெளியேறும்போது நிறுவப்படும்.",
  "w8f517045": "செயல்திறன்",
  "w8f9b3774": "இது ஒருவரின் ஆப்பில் இயங்குகிறது",
  "w901b914f": "திரைப்பிடிப்புகள் இல்லை.",
  "w902b7e39": "பங்கு",
  "w964afed9": "Uplink-இல் Google Messages-ஐ அமை",
  "w90a9ee82": "பதிவுகளுக்கான கோப்புறை",
  "w90e40fab": "உள்நுழைவுக் குறியீடுகளை Ghost Keyboard-க்கு வழங்கு",
  "w9110ee5d": "அதன் முகவரி: https, அல்லது adb reverse உடன் http://127.0.0.1.",
  "w91460811": "அறிக்கை",
  "w915bf322": "கோப்பு",
  "w91a8315d": "ஆன்மாக்களைத் திரும்பப் பெறு",
  "w91d126d8": "செருகுநிரலை உருவாக்குவது எப்படி",
  "w91dad0f8": "எங்கே",
  "w91e91987": "அரட்டையை மூடு",
  "w91ee7fb9": "விரைவில்",
  "wfd6579c8": "உங்கள் செய்திகள் இந்தச் சாதனத்திற்கும் உங்கள் Matrix சர்வருக்கும் இடையே மட்டுமே செல்கின்றன. Uplink-இன் சர்வர்கள் அவற்றைப் பார்ப்பதில்லை, உங்கள் கடவுச்சொல்லும் வைக்கப்படுவதில்லை: உங்கள் சர்வர் திருப்பித் தரும் அமர்வும், இந்தச் சாதனத்தின் மறையாக்க விசைகளும் மட்டுமே.",
  "w9202088e": "இணைப்புகள்",
  "w924e07cc": "எதுவும் இயக்கத்தில் இல்லை",
  "w924f3271": "தோற்றத்தின் குறியீட்டை ஒட்டு",
  "w929d346a": "எமோஜி தொகுப்புகள்",
  "w92aea8e8": "இந்தச் சாதனத்தில் வைக்கப்பட்டது",
  "w92c02e76": "இதை அழை",
  "w932ed2b7": "வழிகள்",
  "w93461f34": "நேரத்தைத் தேர்ந்தெடுக்கவும்…",
  "w934adc9f": "இந்தச் சாதனத்தில் உங்கள் ElevenLabs விசையை மறக்கவா?",
  "w934cec55": "நீங்கள் நகர்த்துவதிலிருந்து கற்றுக்கொள்",
  "w93508a2b": "முகவரியை நகலெடு",
  "w935a806b": "எனக்கு யார் உத்தரவாதம் அளிக்கிறார்கள் என்று நண்பர்களுக்குக் காட்டு",
  "w935f1a4b": "வேறு ஆப் மூலம் திற",
  "w9381f8d8": "எங்கிருந்து",
  "w8871815a": "Google Messages இயல்புநிலை SMS ஆப், RCS-ஐ வைத்திருக்கிறது. Uplink உங்கள் குறுஞ்செய்திகளை Android-இலிருந்தும், RCS அரட்டைகளை Google Messages-இன் அறிவிப்புகளிலிருந்தும் படித்து, அதன் வழியாகப் பதிலளிக்கும்.",
  "w93e63edc": "நீங்கள் யாரையும் புகார் செய்யவில்லை",
  "w9413bf3d": "உங்கள் படங்களிலிருந்து.",
  "w943664b7": "செருகுநிரல்",
  "w943e12da": "மற்றவர்கள் இயக்குவதைக் கேள்",
  "w947704ea": "சமீபத்தில்",
  "w9480a318": "உருவாக்கத்தில் உள்ள செருகுநிரல் இயக்கத்தில் · அமைப்புகள் › டெவலப்பர்",
  "w94acf0ab": "உங்கள் தொடர்புகளில் உள்ள எவருக்கும், குறுஞ்செய்தி மூலம்",
  "w94d75031": "relay.example.com",
  "w9501c510": "பில்கள், ரசீதுகள், பார்சல்கள், இதுபோன்ற எந்தச் செருகுநிரலும் தொடக்கூடாத குறுஞ்செய்திகள்: உள்நுழைவுக் குறியீடு, நண்பரின் கேள்வி, சந்திப்பு, பரிசு மோசடி, அரசியல் குறுஞ்செய்தி.",
  "w1c308a82": "உங்கள் ஃபோனில் WhatsApp-இல்: Settings › Linked devices › Link a device, பின்னர் இந்தக் குறியீட்டை நோக்கிக் காட்டவும். WhatsApp Web போல Uplink உங்கள் மற்றொரு சாதனமாகும், உங்கள் சமீபத்திய அரட்டைகள் வந்து சேரும்.",
  "w95afdf0e": "ஸ்பேமுக்கு நகர்த்து",
  "w95d20bf1": "Google-இன் பக்கத்தை மீண்டும் திற",
  "w95dc3445": "அழைப்பிலிருந்து வெளியேறு",
  "w95fbfac0": "மறையாக்கத்தை முடக்கு",
  "w95fdfd9f": "தட்டச்சுப் புள்ளிகள், படித்த ரசீதுகள், முழு அளவுப் படங்கள், குழு அரட்டைகள் இணையம் வழியாக, Google Messages மூலம். சில படிகள், ஒவ்வொன்றாக.",
  "w960209c3": "இந்த ரிலே, QR குறியீடாக",
  "w962cd7ec": "கண்டறியப்படுதல்",
  "w963b0473": "தேர்ந்தெடுத்த உரையாடல்கள்",
  "w968f7c61": "இந்த ஆப் படிப்பதும் காட்டுவதும். இந்த எண்கள் சரியாகவும் பட்டியல் தவறாகவும் இருந்தால், மீண்டும் படிக்கப் பட்டியலைக் கீழே இழுக்கவும்.",
  "w96913f28": "பெயர்கள் உரையின் சொந்த நிறத்தையே வைத்திருக்கும்",
  "w977bf4cb": "முதலில் உங்கள் PIN",
  "w97af2cdc": "ஸ்பேஸின் பெயர்",
  "w97cb0637": "வேறிடத்தில் உள்ள எந்தக் கணக்கு உங்களுடையது என்று சொல்லி, கையொப்பமிட்ட பகுதியை அங்கே ஒட்டவும்: பயோவில், பதிவில் அல்லது பக்கத்தில். வார்த்தைகள் இந்தக் கணக்கிலிருந்து வந்தன என்பதையும், எப்போது என்பதையும் அது காட்டும்.",
  "w97ecbef1": "யாருடையது என்று பார்க்க ஒன்றை ஒட்டவும்",
  "w97f4a04f": "பழையது உள்ளவர் வெளியே வைக்கப்படுவார்.",
  "w982f5c27": "உங்கள் குரலின் சத்தத்தைச் சமன் செய்கிறது. முடக்கத்தில் உங்கள் சொந்த அளவை வைத்திருக்கும்.",
  "w983277c4": "1 நிமிடம்",
  "w987a959b": "PIN-ஐ மறந்துவிட்டீர்களா?",
  "w987c7d5f": "தடையை நீக்கு",
  "w98a0bb1b": "உங்கள் தொடர்புகளில் இல்லாத எண்ணிலிருந்து வரும் ஒவ்வொரு குறுஞ்செய்தியும் கீழே உள்ள அடையாளங்களுக்காகப் பார்க்கப்படும். எத்தனை தேவை:",
  "w98d42939": "பங்கைச் சேர்",
  "w98f2ba3a": "இணைப்பை நீக்கு",
  "w98f9c5f8": "UPS, USPS அல்லது FedEx கண்காணிப்பு எண்: அதற்கான கூரியர் நிறுவனத்தின் பக்கம்.",
  "w991624d5": "புதிதாக ஒன்றைத் தொடங்கு",
  "w992c5ed8": "Telegram தொடங்குகிறது…",
  "w9964e50a": "இதைப் பயன்படுத்தாதே",
  "w996b50e4": "வட்டத்தை மாற்றக்கூடியவர் ஒன்றைத் தேர்ந்தெடுக்கலாம்.",
  "w9970a07a": "இந்தச் சாதனம் உள்ள நெட்வொர்க்கில் சாதனங்களுக்கு இடையே நேரடியாக, சர்வர் இல்லாமல், இணையம் இல்லாமல். ரிலே சர்வரால் ஏதாவது கொண்டுசெல்ல முடியாதபோதும், இணையமே இல்லாத இடத்தில் தனியாகவும் பயன்படுத்தப்படும்.",
  "w99a275b3": "உங்கள் கணினியில் உங்கள் குறுஞ்செய்திகள்",
  "w99d8db05": "இங்கே சேரு",
  "w99ef423f": "இந்த ஃபோன் என்ன, படச் செய்திகள் எந்த நிலையில் உள்ளன, கீழே உள்ள பதிவு, உரையாக.",
  "w9a06a894": "சுயவிவரத்தைத் திற",
  "w9a166f9d": "சொல் சொல் சொல் …",
  "w9a340434": "பாடலைச் சேர்",
  "w9a3443cc": "அதன் பிறகு யார் வேண்டுமானாலும் அதை எடுக்கலாம். உங்கள் நண்பர்கள் உங்கள் நண்பர்களாகவே இருப்பார்கள்.",
  "w9a73db9b": "மொழி",
  "w9a9b2a58": "வரிசை",
  "w9aab7b72": "WhatsApp இதை ஆதரிக்கவில்லை",
  "w9ad2489c": "இடம்",
  "w9ad59e86": "திரைப்பிடிப்புகள்",
  "w9b0eb1cd": "இந்தச் சாதனம் சரிபார்க்கப்பட்டது",
  "w9b22be74": "உரிமையாளர்",
  "w9b26c187": "இதில் புதிய கோப்புறை",
  "w9b294ce8": "உங்கள் தொடர்புகளில் இல்லாதவரிடமிருந்து இவற்றில் ஏதேனும் உள்ள குறுஞ்செய்தி ஸ்பேம்.",
  "w9b988fce": "உங்களையே கேளுங்கள்",
  "w9c0541b4": "இந்தச் சாதனத்தில் மட்டும்",
  "w9c4ee94e": "ஆப் ஒதுக்கி வைக்கப்பட்டாலும் இது தொடர்ந்து படிக்கும்",
  "w9c5f1f57": "குழுக்களும்",
  "w9ca62efb": "மொழிகளை Wi-Fi-இல் மட்டும் பதிவிறக்கு",
  "w9cae8a40": "மற்ற ரிலேக்களில் உள்ள நண்பர்கள் உங்களை அடைய முடியாது",
  "w9cbc1f86": "அதன் நகல் இந்தச் சாதனத்திலிருந்து நீக்கப்படும். மீண்டும் ஏற்றும்போதுக்காக அதற்கான உங்கள் தேர்வுகள் வைக்கப்படும்.",
  "w9d68dbac": "பெரும்பாலான Matrix அரட்டைகள் முனைக்கு-முனை மறையாக்கப்பட்டவை. உங்கள் மற்ற சாதனங்கள் தங்கள் விசைகளை இதனுடன் பகிர்ந்ததும் புதிய செய்திகள் இந்தச் சாதனத்தை அடையும். உங்கள் மீட்பு விசை (Element அதை Security Key என்கிறது) மீதியைத் திறக்கும்: இந்தச் சாதனம் உங்களுடையது எனச் சரிபார்க்கப்படும், உள்நுழைவதற்கு முந்தைய செய்திகளுக்கான விசைகள் உங்கள் சர்வரின் விசைக் காப்புப்பிரதியிலிருந்து வரும். இது ஒருமுறை பயன்படுத்தப்படும், வைக்கப்படாது.",
  "w9d902c5a": "நடந்து செல்",
  "w9da98904": "இந்த விசைக்கு ஓய்வு அறிவிப்பை உருவாக்கவா?",
  "w9dc3aa14": "சேர்",
  "w9dc73f98": "இதை ஹோஸ்ட் செய்",
  "w9de87776": "இந்த விளையாட்டுகளை ஒருபோதும் காட்டாதே",
  "w9dfc3f83": "புதுப்பித்த நிலையில்.",
  "w9e13ea41": "இந்த விசையால் கையொப்பமிடப்பட்டு, ஆஃப்லைனில் வைக்க நகலெடுக்கப்பட்டது. எதுவும் அனுப்பப்படாது.",
  "w9e47dd8f": "அந்தப் பெயரில் எதுவும் இல்லை",
  "w9e48b282": "படங்கள் மற்றும் கோப்புகள்",
  "w9e63c76b": "நட்பு முடியும்; உங்களுக்கான அவர்களின் நட்புக் கோரிக்கைகளும் செய்திகளும் கைவிடப்படும்.",
  "w9eb9d54a": "எதிர்வினையைச் சேர்",
  "w9ee242a8": "கேமராவை மாற்று",
  "w9eeb56ea": "ஒன்று முதல் நான்கு வரை: இவற்றின் மூலம் மக்கள் அதைக் கண்டறிவார்கள்.",
  "w9f0f4c8f": "ஸ்பேம் வடிகட்டி அப்படிச் சொல்லும் இடத்தில் ஸ்பேமாக இருக்கலாம்; குறுகிய குறியீடு, மின்னஞ்சல் முகவரி, அல்லது \"Reply STOP\", \"உங்கள் ஆர்டர்\" போன்ற வார்த்தைகளுக்கு ஒரு வணிகம்; இல்லையெனில் உங்களுக்குத் தெரிந்திருக்கக்கூடிய ஒருவர்.",
  "w9f6e27c6": "xxxx-xxxx-xxxx-xxxx",
  "w9f867905": "அனுமதிக்கப்பட்டது · முன்னோட்டங்கள் மறைக்கப்படும்",
  "w9fd463b4": "எல்லா அரட்டைகளையும் போல",
  "w9fd66c0b": "புதிய குறுஞ்செய்தி",
  "w9ff5be3a": "ஸ்பேம், விற்பனை அமைதியில்",
  "w9ff92f39": "Ghost Keyboard இந்த ஃபோனில் உள்ளது. அதன் சொந்த ஸ்விட்ச் அதன் Settings › Row tools-இல் உள்ளது.",
  "wa012932d": "எது குறியீடாகக் கருதப்படும்",
  "wa04ccb84": "அனைவருக்கும் மேலாக, கீழே உருவாக்கப்படும்",
  "wa070f107": "உங்கள் கணக்கை மாற்றக்கூடிய எதையும் இந்த உலாவி வைத்திருப்பதில்லை, எனவே இந்தப் பக்கத்திற்கு உங்கள் கடவுச்சொல் அதைத் திறக்கும்.",
  "wa0c28cf6": "ஒவ்வொரு வகைக்கும் உறுதியான அடையாளங்களும் சிறியவையும் உண்டு. ஒரு குறுஞ்செய்தியை வகைப்படுத்த எத்தனை தேவை:",
  "wa0da59a3": "தொகுப்பை நகலெடு",
  "wa1388e5d": "உங்கள் CSS",
  "wa14b85b2": "Android விசைப்பலகைகளிடமிருந்து குறியீடுகளை மறைக்கிறது",
  "wa167b1eb": "இங்கே",
  "wa1b7e43b": "பெயர்கள், நிறம் உள்ள அவர்களின் மிக உயர்ந்த பங்கின் நிறத்தில் காட்டப்படும்.",
  "wa1d4fef8": "வெளியேறி நீக்கு",
  "wa1dd7bf1": "பதிவு",
  "wa1eafd4a": "உங்கள் கடவுச்சொல்லுக்குப் பிறகு, இந்த உலாவியிலிருந்து உங்கள் சுயவிவரம், நண்பர்கள், வட்டங்கள்",
  "wa233bb96": "இணைப்புச் சரத்தை நகலெடு",
  "wa2349012": "சொல்லை அகற்று",
  "wa271253d": "இந்த ஆப்புக்கு இதைப் பயன்படுத்து",
  "wa2cce835": "கடவுச்சொற்றொடர்",
  "wa2de4b90": "அனைவருக்கும் ஒலியடக்கப்பட்டது",
  "wa2eecf15": "எடுத்துக்காட்டை நகலெடு",
  "wa2f6a367": "ஸ்பேம் போலத் தோன்றும் குறுஞ்செய்தி டெலிவரி, நினைவூட்டல் அல்லது சந்திப்பாக வகைப்படுத்தப்படாது, எனவே போலியான \"உங்கள் பார்சல் நிறுத்தப்பட்டுள்ளது, கட்டணம் செலுத்தவும்\" ஸ்பேமிலேயே மறைந்திருக்கும்.",
  "wa2f8bba2": "கோப்புகளைத் தேடு",
  "wa3292a0c": "உங்கள் காப்புப்பிரதி இதனால் மீண்டும் முத்திரையிடப்படும். உங்கள் மீட்பு சொற்கள் அப்படியே இருக்கும்.",
  "wa33ff897": "இந்தச் சாதனத்தின் மதிப்பாய்வு விசையால் இங்கே திறக்கப்பட்டது: ரிலே அவற்றை முத்திரையிட்டே வைத்திருக்கும், அவை என்ன சொல்கின்றன என்பதைப் பார்ப்பதில்லை.",
  "wa3583899": "பெரிதாக்கு",
  "wa35f6e29": "மீண்டும் பட்டியலிடு",
  "wa3742172": "இணைப்பை நீக்கு",
  "wa3ce4cb3": "நபர்களுக்கு அழைப்பு அனுப்பு",
  "wa3e5f1e1": "அனுப்பாதே",
  "wa3f9baec": "அட்டவணையிடு",
  "wa408a225": "உறுப்பினருக்கும் மாடரேட்டருக்கும் இடையே",
  "wa43809e0": "படிக்கப் புகார்கள் இல்லை.",
  "wa4461406": "அழைப்புகள் எப்படி மாற்றப்படுகின்றன",
  "wa46af788": "உள்நுழைந்த ஒவ்வொரு சாதனமும் ஒரே நேரத்தில் உங்கள் கணக்காக இணைக்கப்படும், ஒவ்வொன்றும் உங்களுக்கு அனுப்பப்படுவதைப் பெறும். நீங்கள் உள்நுழையும் ஒவ்வொரு உலாவியும், ஒவ்வொரு தனிப்பட்ட சாளரமும், வெளியேறும் வரை அல்லது நீங்கள் அகற்றும் வரை இங்கே தனிச் சாதனம்; ஒரு கணக்கில் 20-க்கு இடம் உண்டு.",
  "wa4780039": "பங்குகள் எதுவாக இருந்தாலும், வட்டத்தில் உள்ள அனைவரும் செய்யக்கூடியவை. ஒரு ஸ்பேஸ் தனக்காக இதை அதன் அனுமதிகளில் மாற்றலாம்.",
  "wa48c839b": "இந்த ஃபோனுக்குப் புதிய விசை உள்ளது",
  "wa49dd09e": "நிறுத்திவைக்கப்பட்டது",
  "wa4bfdc90": "இதனுடன் இணைக்கப்பட்டது",
  "wa4c7cb05": "நட்புக் கோரிக்கையை அனுப்பு",
  "wa4f16c75": "அவர்களை எதிர்பார்ப்பதை நிறுத்து",
  "wa5048dbb": "அறிக்கையை நகலெடு",
  "wa505ab01": "ஆப் உள்ள மற்ற ஃபோன்களை நேரடியாக அடை",
  "wa5159374": "curl 'https://messages.google.com/web/config' …",
  "wa5281d04": "உங்கள் தொடர்புகளில் யாரும் இல்லாத குழுவும் பார்க்கப்படும்.",
  "wa53136e6": "சந்தைக்குச் செருகுநிரலைச் சமர்ப்பி",
  "wa55af8c4": "இணைக்கப்பட்ட கணக்குகள்",
  "wa59ba5bf": "இங்கேயே உருவாக்கப்பட்டு மதிப்பிடப்படும்; அந்த அரட்டையில் அனுப்பப்படும் கேள்வி தவிர, அரட்டை பற்றி எதுவும் எங்கும் செல்லாது.",
  "wa5d2a900": "குரல் மற்றும் வீடியோவைப் பதிவு செய்",
  "wa62cba32": "\"இதனுடன் இணைக்கப்பட்டது…\" அறிவிப்பு",
  "wa63b9813": "உங்களுடன் பகிரப்பட்ட பின்னணிகளைப் பயன்படுத்து",
  "wa6a08b6d": "Google-இன் பக்கம் உங்கள் எண்ணைக் கேட்டு ஆறு இலக்கக் குறியீட்டைக் குறுஞ்செய்தியில் அனுப்பும். குறுஞ்செய்தி இங்கே வரும். குறியீட்டை அங்கே தட்டச்சு செய்தால் உங்கள் எண்ணுக்கு RCS முடக்கப்படும். ஆப்களை மாற்ற வேண்டியதில்லை.",
  "wa6f720e8": "வீடியோவை இயக்கு",
  "wa7234b24": "அவர்களிடம் ஆப் வந்து நீங்கள் ஒருவருக்கொருவர் குறுஞ்செய்தி அனுப்பியதும், உங்களுக்கிடையே மறையாக்கத்தை இயக்க இது முன்வரும். அதிலிருந்து வழிகள் அவர்களை அடையும்.",
  "wa73c373d": "இது எப்படிப் பட்டியலிடப்பட்டுள்ளது",
  "wa73d406a": "எப்போது வேண்டுமானாலும் இதை இயக்கி மீண்டும் உள்நுழையலாம்.",
  "wa77a5eb0": "எழுத்துரு",
  "wa783e348": "இழையை மூடு",
  "wa787c3dc": "ஒரு டிக்",
  "wa7947b84": "அரட்டை, குரல் அரட்டை அல்லது கோப்புகள் ஸ்பேஸ்",
  "wa7c3b223": "அழைப்பு இணைப்பை நகலெடு",
  "wa7fac1f4": "ஏதாவது சொல்லுங்கள்",
  "wa82cc636": "பட்டியலிலிருந்து நீக்கு",
  "wa85b644b": "இன்னும் விசை இல்லை.",
  "wa8a60c11": "ஒரு மணிநேரத்தில்",
  "wa8a83328": "ஸ்பேம்",
  "wa8dc0817": "இணைக்கப்படவில்லை",
  "wa902f0f9": "ஒவ்வொரு செய்தியும் Markdown அல்லது JSON ஆக, விரும்பினால் அதன் படங்கள், கோப்புகளுடன்.",
  "wa92a53a2": "உதவி மற்றும் ஆவணங்கள்",
  "wa9442aa9": "Finder-இல் காட்டு",
  "wa957e4ee": "இந்தச் சாதனம் வேறொரு சாதனத்திலிருந்து உங்கள் கணக்கிலிருந்து வெளியேற்றப்பட்டது.",
  "wa96b5711": "பிழை வெகுமதிகளுக்கு",
  "wa987c2f5": "வைத்திரு",
  "wa99d62c2": "அறிவிப்புகள் & ரசீதுகள்",
  "wa9daa9a0": "நகலெடுக்கும்போது படித்ததாகக் குறி",
  "wa9e8e16c": "ஒரு உரையாடலில்",
  "waa2fc90d": "பேட்டரி பயன்பாடு",
  "waa47fa3b": "இந்த ஃபோனில் உள்ள மொழிகள்",
  "waa55a56e": "மேலே பின் செய்",
  "w62a66cf0": "Uplink",
  "waa7d6ae8": "வலுவான அடையாளங்கள் இரட்டிப்பாகக் கணக்கிடப்படும்",
  "waaad5b41": "ஆப்பில் நீங்கள் எப்படிச் சுற்றி வருகிறீர்கள். இரண்டு புதிய வழிகளும் எல்லாப் பக்கங்களிலும் ஒன்றே; Discord, Slack போல, ரெயில் உங்கள் வட்டங்களை இடதுபுறம் சேர்க்கும்.",
  "waab6fb83": "குறுஞ்செய்திகள் இங்கேயே பார்க்கப்படுகின்றன, எங்கும் அனுப்பப்படுவதில்லை. எதுவும் நீக்கப்படுவதில்லை அல்லது தடுக்கப்படுவதில்லை, உங்கள் தொடர்புகள் ஒருபோதும் வகைப்படுத்தப்படுவதில்லை. உரையாடலில் \"… அல்ல\" என்பது அதை நிரந்தரமாக Messages-க்குத் திருப்பும்.",
  "waacf0937": "ஆன்மாக்கள்",
  "waaff8ec9": "இதை விட்டுவிடு",
  "wab05c8bd": "இன்னும் பங்குகள் இல்லை: பங்குகளில் அவற்றை உருவாக்கவும்",
  "wab20d49c": "ரிலே வழியாக",
  "waba47927": "தடையை நீக்க ஒருவரைத் தட்டவும்.",
  "wabdeb84b": "ஒவ்வொருவருக்கும் கடைசியாக ஏதாவது கொண்டுசென்ற வழி, அவரிடமிருந்து கடைசியாக ஏதாவது கொண்டுவந்த வழி. ஒரு குழு ஒவ்வொருவராகச் செல்லும்: அதன் ஒவ்வொருவரும் தனக்கென ஒரு வழியால் அடையப்படுவார்.",
  "wac28cd0d": "குரலைத் தேர்ந்தெடுக்கவும்",
  "wac635393": "அழைப்புகளில் என் குரலை மாற்று",
  "wac68ec76": "Enter அனுப்பும்",
  "wacaa5298": "ஒரே தலைப்புள்ள ஸ்பேஸ்கள் ஒன்றாகப் பட்டியலிடப்படும். எதுவும் வேண்டாமெனில் காலியாக விடவும்.",
  "wacaafd84": "இந்தச் செருகுநிரலைப் புகார் செய்",
  "wacac5fef": "இங்கிருந்து முடியாது: சந்தை அனுப்பிய அதன் நகல் இந்தச் சாதனத்தில் சரிபார்ப்பில் தேறவில்லை.",
  "wacec3801": "5 நிமிடங்கள்",
  "wad692f00": "இப்போது வெளியேறுவார்கள், மீண்டும் அழைக்கப்பட்டால் திரும்ப வரலாம்",
  "wad6ed245": "நிர்வாகிகள்",
  "wad736a52": "இந்தத் திரையின் ஒலியளவு",
  "wfaf63e7a": "இதிலிருந்து வெளியேற, மேலே உள்ள Uplink-இன் ரிலேக்குத் திரும்பவும், அல்லது இதை முடக்கவும்.",
  "wad9ef205": "இந்த ஃபோனில் வைக்கப்பட்டது",
  "wadc3ab5e": "இந்த ஃபோனில் ஆப் ஒரு நகலை வைத்திருக்கும். செய்திகள் படிக்க எளிதாக இருக்க, அது லேசான திரையின் கீழ் காட்டப்படும்.",
  "wadc589d7": "முயற்சி செய்",
  "wae047875": "PDF",
  "wae04cce8": "சேர்க்க ஏதாவது உள்ளதா?",
  "wae23786f": "ஒவ்வொரு குறுஞ்செய்தியும் வரும்போது ஃபோனில் முடிவு செய்யப்படும். அமைதியான குறுஞ்செய்தி இன்னும் அமைதி நேரம் அறிவிப்புச் சேனலில் காட்டப்படும்.",
  "wae98f10a": "பெரிய எமோஜி",
  "waeb6a612": "பிட் விகிதம்",
  "waf3e4446": "இரண்டாவது தாவல் முதல் தாவலிடமிருந்து பொறுப்பேற்க முன்வரும், எனவே ஒவ்வொரு செய்தியும் ஒருமுறை மட்டுமே வரும்.",
  "waf5c5293": "காப்பகப்படுத்தப்பட்டது",
  "w1619bac2": "மற்ற ஆப்களுக்கு Signal-இல் API இல்லை: Signal Desktop செய்வது போல, திறந்த மூல mautrix-signal (GNU AGPL) மூலம் Uplink இணைகிறது. உங்கள் செய்திகள் இந்தச் சாதனத்திற்கும் Signal-க்கும் இடையே மட்டுமே செல்லும், Uplink-இன் சர்வர்கள் வழியாக ஒருபோதும் இல்லை.",
  "wafb3e591": "வகை",
  "wb00d141c": "பயனர்பெயர் மூலம் சேர்ந்த நண்பர்கள் உங்கள் சுயவிவரத்தில் இதைப் பார்ப்பார்கள்.",
  "wb015ebb9": "ஒருபோதும் மொழிபெயர்க்கப்படாது.",
  "wb01cfe54": "அமைப்புகள் › API, கீழே உருவாக்கத்தில் உள்ள செருகுநிரல்கள், சந்தையின் உருவாக்கத்தில் ஆகியவற்றைக் காட்டும்.",
  "wb0280b9e": "நண்பர்களை அழைத்து வாருங்கள்",
  "wb03589e8": "ரிலே சர்வரை அடைய முடியவில்லை",
  "wb0732013": "மதிப்பாய்வாளருக்கான குறிப்புகள் (விருப்பத்தேர்வு): எப்படி முயற்சிப்பது, என்ன மாறியது",
  "wb0992fa8": "உண்மையான நபர் போல ஒலிக்கும், ஆனால் நீங்கள் பேசிய ஓரிரு வினாடிகளுக்குப் பிறகு கேட்கும். உங்கள் ElevenLabs விசை தேவை.",
  "wb0a55bd7": "நீங்கள் விரும்பும் விசைகளை ஒன்றாக அழுத்தவும். Esc அதை இருந்தபடியே விடும்.",
  "wb11803fb": "ஸ்பேஸ் விருப்பங்கள்",
  "wb14ef6fb": "இன்று மாலை வரை (மாலை 6)",
  "wb1546e14": "கடைசியாகப் பெற்றது",
  "wb1acc0db": "இல்லையெனில், பதிவுகளில் அதன் மெனுவிலிருந்து.",
  "wb20bc9d2": "கோப்பைத் திறக்கிறது",
  "wb218d5b0": "என்ன நடந்தது",
  "wb23f00c7": "பதிலளிப்பதை நிறுத்து",
  "wb2a15753": "எந்த நெட்வொர்க்கிலிருந்தும், ரிலே சர்வர் வழியாக API. கோரிக்கைகளும் பதில்களும் இணைப்புச் சரத்தின் விசையால் முத்திரையிடப்படும்: ரிலே அவற்றைக் கடத்தும், படிக்க முடியாது. ஆப் இயங்கிக்கொண்டிருக்க வேண்டும்.",
  "wb2d46890": "வீடியோ எங்கே உள்ளது",
  "wb2e743b7": "Maps-இல் திற",
  "wb2fa8fdb": "சொற்களைப் படியுங்கள்",
  "wb311f3b0": "குரல் மற்றும் வீடியோ அமைப்புகள்",
  "wb330074a": "கடவுச்சொற்றொடர் கேட்காதே",
  "wb34a0288": "ஒட்டு",
  "wb35c3185": "சேர்க்கப்பட்டது",
  "wb3a43630": "ஆம்",
  "wb3a772d9": "எல்லாக் கணக்குகளையும் துண்டித்து உங்கள் எதிர்பார்ப்புப் பட்டியலை அழிக்கவா? நீங்கள் இங்கே இருப்பது இனி நண்பர்களுக்குச் சொல்லப்படாது.",
  "wb3b03247": "பயன்படுத்தப்படவில்லை",
  "wb3ca9a34": "ஒலி",
  "wb3f14fb0": "இழப்பில்லாத இசை",
  "wf47fcd5b": "உங்கள் Uplink கணக்கில் உள்நுழையவும்",
  "wb42b7af3": "இந்த முந்தைய படத்தை மறக்கவா?",
  "wce59649b": "இணைப்பு இந்தக் கணினிக்கு மட்டுமே உரியது: செய்திகள் இதற்கும் Google-க்கும் இடையே செல்கின்றன, Uplink-இன் சர்வர்கள் வழியாக ஒருபோதும் இல்லை. உதவியாளர் mautrix-gmessages (GNU AGPL) அடிப்படையிலான திறந்த மூலம்.",
  "wb4519085": "ஒருபோதும் கேட்கப்படவில்லை",
  "wb453bfed": "படத்தை ஆப்பின் மேல் வைத்திரு",
  "wb47499ba": "உரிமையாளரும் நிர்வாகிகளும் மட்டுமே இவற்றில் பதிவிட முடியும்: அறிவிப்புகள், விதிகள், சிஸ்டம் செய்திகள். ரிலேயும் மற்ற அனைவரையும் இதற்குக் கட்டுப்படுத்துகிறது. ஒரு ஸ்பேஸை அதன் அமைப்புகளில் படிக்க மட்டுமானதாக்கவும்.",
  "wb50a96d7": "குறியீடுகளுக்கு நகர்த்து",
  "wb52330a2": "சமீபத்தில் முடிவு செய்யப்பட்டவை",
  "wb52aa576": "டெலிவர் ஆனது. நிறத்தில்: படிக்கப்பட்டது.",
  "wb53018dc": "தரநிலைகள்",
  "wb5bdd13c": "நீங்கள்",
  "wb5c51d5f": "பதிவுகளைச் சேமிக்கும் இடம்",
  "wb5e8e80f": "இணைக்கப்படவில்லை",
  "wb61190f3": "கோப்புறையை ஒத்திசை",
  "wb6473d88": "Google Messages-இன் அறிவிப்புகளை அமைதியாக்கு",
  "wb651bded": "பதிவுகள்",
  "wb6996066": "ஒவ்வொன்றும் அதைத் தூண்டுவதுடன். இங்கே இயக்க ஒன்றைத் தட்டவும்.",
  "wb7309f03": "வழங்கப்பட்டதுமே, காரணத்துடன், இணைப்பில் இருந்தால் அவர்களுக்குச் சொல்லப்படும்; இல்லையெனில் அடுத்த முறை இணையும்போது.",
  "wb753bebd": "இங்கே உங்கள் குமிழ்கள்",
  "wb7b07b89": "நான் அவற்றை எழுதிக்கொண்டேன்",
  "wb7b3f75a": "புதிய குழு",
  "wb7d6a318": "இந்த இணைப்பைச் சேர்",
  "wb7e3830e": "உங்கள் பயனர்பெயர், பெயர், படம், நிலையை உங்களுக்காக நிரப்பும். அவற்றில் எதையும் மாற்றலாம்.",
  "wb7f41ea7": "இதை உங்கள் ஃபோன் மூலம் ஸ்கேன் செய்யவும்",
  "wb88a2d0e": "புதிய விசை அனைவருடனும் மறையாக்கத்தை முடிக்கும். தொடர ஒவ்வொரு உரையாடலும் மீண்டும் பரிமாறப்படும், பழைய விசையில் முத்திரையிட்ட குறுஞ்செய்திகளை இனி திறக்க முடியாது.",
  "wb89df01a": "உதவி",
  "wb8a58f76": "டெவலப்பர்",
  "wb8a72650": "அவற்றில் மூன்றைத் தட்டச்சு செய்யவும்",
  "wb933b49a": "குழு எதற்காக: ஒரு விளையாட்டு, ஒரு திரைப்படம், ஒரு அமைதியான மூலை.",
  "wb954bc92": "சுங்கக் கட்டணங்கள், அபராதச் சீட்டுகள், Y எனப் பதிலளிக்கும் தந்திரம், மறைந்த எழுத்துகள் உண்மையான குறுஞ்செய்தியில் கிட்டத்தட்ட ஒருபோதும் இருப்பதில்லை: ஒன்றே இரண்டுக்குச் சமம்.",
  "wb974e859": "அழைப்புகளில் பேச ஒரு விசையைப் பிடித்திருங்கள்",
  "wb9aefad3": "அசலைக் காட்டு",
  "wb9e345a8": "இந்தத் தருணத்தைக் குறி",
  "wb9f0bb1d": "எண்ணை நகலெடு",
  "wba2214ab": "குரல் அழைப்பு",
  "wba4accbc": "குறுகிய வரி: இது என்ன செய்கிறது, சில வார்த்தைகளில்",
  "wba5e7635": "இந்த அழைப்பு உங்கள் மற்றொரு சாதனத்திற்கு நகர்ந்தது",
  "wba6691ff": "கிரிப்டோ, பரிசுப் போட்டிகள்",
  "wbafdfdbe": "மறையும் செய்திகள்",
  "wbb709d23": "உங்கள் குறியீடு",
  "wbbc1cbbc": "வட்டம் அவர்களுக்காகத் திறக்கும் வரவேற்பு ஸ்பேஸின் மேலே, ஒவ்வொரு புதிய உறுப்பினருக்கும் காட்டப்படும். அவர்களின் பெயர் வரும் இடத்தில் {name} என்று எழுதவும்.",
  "wbc1269bd": "இன்னும் ரிலேயுடன் இணைக்கப்படவில்லை. சிறிது நேரத்தில் மீண்டும் முயற்சிக்கவும்.",
  "wbd00747c": "இன்னும் எதுவுமில்லை",
  "wbd074002": "தடு",
  "wbd09d27a": "ஒத்திவைத்த செய்தியைக் காட்டு",
  "wbd9ab8b9": "ஒட்டி மாற்ற, ஆப் படிக்கும் எல்லாப் பெயர்களும் அவற்றின் தற்போதைய மதிப்புகளுடன்",
  "wbdad31b7": "அவை பொருந்துகின்றன, உள்நுழையச் செய்",
  "wbdbffe24": "நேரடி வழியாக",
  "wbdde13bc": "இன்னும் எதுவும் தவறாகவில்லை.",
  "wbdde90c6": "பங்கை நீக்கு",
  "wbdf328a0": "எங்கும் ஒட்டக்கூடிய வார்த்தைகள், இவை இந்தக் கணக்கிலிருந்து வந்தவை என்பதைக் காட்டும்",
  "wbe177772": "ஒரு மாடரேட்டர் அவர்களை ஒலியடக்கினார். ஒரு மாடரேட்டர் மட்டுமே ஒலியடக்கத்தை நீக்க முடியும்.",
  "wbe2e8955": "அழைப்பு எழுதப்பட்ட புதிய அரட்டையைத் திறக்கும். யாருக்கு என்று தேர்ந்தெடுத்து, விரும்பினால் வார்த்தைகளை மாற்றி, எந்தக் குறுஞ்செய்தி போலவும் அனுப்பவும்.",
  "wbe4315d9": "விருப்பத்தேர்வு: வட்டத்தின் முகப்பில் உங்களுடைய ஒரு படம்.",
  "wbe7d3874": "படித்ததாகக் குறி",
  "wbe9293da": "அழைப்பில் செவிடாக்கப்பட்டிருந்தால், எப்படியும் எதையும் கேட்க மாட்டீர்கள்.",
  "wbec15935": "வெளியேற்று அல்லது தடைசெய்",
  "wbec1fd30": "வகைகள்",
  "wbf1e5bf5": "உரையாடல் குமிழ்கள்",
  "wbf3201de": "கைவிடு",
  "wbfbc51a6": "தடைசெய்",
  "wbfcd37aa": "gogho.st",
  "wbfdd0c85": "திருத்துவதை நிறுத்து",
  "wbfe4a3af": "மீட்பு சொற்கள்",
  "wbff40186": "ஒரு நிறத்தைக் கலக்கு",
  "wc0654ded": "Google கணக்கில் உள்நுழையாத Google Messages-க்கு, Device pairing-இல் இன்னும் QR code scanner உள்ள இடத்தில்.",
  "wc07d8654": "நீங்கள்தான் என்று நண்பர்கள் அறிய, முதலில் பயனர்பெயரைத் தேர்ந்தெடுக்கவும் (அமைப்புகள் › நான் › சுயவிவரம்).",
  "wc0ae2136": "அமைப்புகளில் தேடு",
  "wc0cfb680": "அதன் பெயர்",
  "wc0eead51": "கேமராவைத் திருப்பு",
  "wc105629f": "அழைப்பில் உடனே பயன்படுத்தப்படும். சிஸ்டத்தினுடையது சாதனம் பயன்படுத்துவதைப் பின்பற்றும்.",
  "wc1058ddb": "புதிய செய்திகள்",
  "wc11a25bb": "விளையாடுபவர்களுக்கான ஒரு வட்டம்",
  "wc13df462": "சிக்கல்கள் எதுவும் இல்லை",
  "wc144334a": "அதனுடன் செல்வது",
  "wc16e73d7": "மின்னஞ்சல், குறிப்பு அல்லது வேறு ஆப்புக்கு.",
  "wc17ae7b3": "நண்பர்களுக்குச் சொல்",
  "wc197c7e2": "தவிர்",
  "wc1a60017": "மீண்டும் பெயரிடு",
  "wc1b55ffd": "வட்டத்திலிருந்து வெளியே வைக்கப்பட்டு, அதில் கேட்கப்படமாட்டார். தடை நீக்கப்பட்டால், மீண்டும் அழைக்கப்பட்டால் திரும்ப வரலாம்.",
  "wc1c43225": "ஸ்பேஸ்",
  "wc1e3e8ff": "செய்திகளுடன் எதிர்வினைகளை இணை",
  "wc1fbed7a": "தேட வேண்டிய அடையாளங்கள்",
  "wc22d821c": "இணைப்புக் குறியீட்டைக் காட்டு",
  "wc2389e47": "பங்குகளும் அனுமதிகளும்",
  "wc24ae3f4": "Notion-ஐப் படிக்கிறது…",
  "wc24e3f8b": "ஸ்பேஸில் யாரும் அவர்களைக் கேட்க மாட்டார்கள், அவர்களால் ஒலியடக்கத்தை நீக்க முடியாது.",
  "wc255b228": "இணைக்கப்பட்டது",
  "wc266d43b": "உருவாக்கத்தில்",
  "wc2762327": "விளையாட்டு",
  "wc27b360e": "PIN-ஐ மாற்று",
  "wc289f685": "ஸ்பேமைப் படித்ததாகக் குறி",
  "wc2954bc2": "பின்செல்",
  "wc2c76cb1": "திருத்து",
  "wc31ec050": "எத்தனை",
  "wc36d6374": "பட்டியலைப் படிக்கிறது…",
  "wc3ef1644": "டெவலப்பர்களிடமிருந்து",
  "wc41ac952": "72975, alerts@bank.example",
  "wc44fca23": "விரும்பினால், ஒரு குறிப்பு",
  "wc46ad58b": "எல்லாப் பங்குகளுக்கும் மேலே: எல்லாவற்றையும் செய்யலாம், எந்தப் பங்கையும் வழங்கலாம், நிர்வாகிகளை நியமிக்கலாம், வட்டத்தை நீக்கலாம்.",
  "wc47c37c8": "ஆஃப்லைன்",
  "wc49a8049": "ஸ்பேஸின் மேற்பகுதி",
  "wc4b6e54a": "குறுஞ்செய்தி மூலம் நபர்கள்",
  "wc501e3bc": "பங்கு இல்லாமல், உரிமையாளரால் நியமிக்கப்பட்டவர்: உரிமையாளருக்குச் சற்றுக் கீழே, வட்டத்தை நீக்குவது, நிர்வாகிகளை நியமிப்பது தவிர எல்லாவற்றையும் செய்யலாம்.",
  "wc50cd8bb": "முன்பு",
  "wc52bb2d7": "சமீபத்திய அழைப்புகள்",
  "wc52dee0b": "புதிய வட்டம்",
  "wc56b7a50": "இணைப்புள்ள செய்தி காட்டப்படும்போது, இந்த ஃபோன் அந்த இணைப்பு என்ன என்று தளத்திடம் கேட்கும், இணைப்பைத் தவிர வேறு எதையும் கொடுக்காமல். அது பதிலளிப்பது ஆப் திறந்திருக்கும் வரை வைக்கப்படும்.",
  "wc5968038": "இந்தச் சாதனத்தில் மதிப்பாய்வாளரின் விசைக்கு முத்திரையிடப்பட்டது: ரிலே உட்பட வேறு யாராலும் திறக்க முடியாது. யார் புகார் செய்தார் என்று அந்த நபருக்குச் சொல்லப்படாது.",
  "wc5bec0a2": "Word ஆவணம்",
  "wc5d369a9": "வட்டத்தைச் சேர்",
  "wc5dfc4a6": "நீங்கள் அறிய விரும்பும் அடையாளப்பெயர்கள். Discord, Telegram, X ஆகியவை உங்கள் நண்பர்களையோ பின்தொடர்பவர்களையோ ஒரு ஆப் படிக்க அனுமதிப்பதில்லை, எனவே அவற்றை நீங்களே சேர்க்கவும்.",
  "wc654aa9c": "அனைவருக்கும் ஒலியடக்கு",
  "wc67ebdad": "இது உள்ளடக்காதவை",
  "wc6b13ea8": "இந்தப் படியைத் தவிர்",
  "wc6d560e9": "ஒன்றை உருவாக்கிச் சோதிப்பது எப்படி",
  "wc6f8a78b": "இன்னும் தொலைவிலிருந்து கண்டறிய முடியாது",
  "wc71eb4ea": "Microsoft Teams-இல் உள்நுழை",
  "wc782d54a": "இரைச்சல் குறைப்பு",
  "wc78db4d2": "உங்கள் உரையாடல்களையும் படங்களையும் படிக்கலாம், இந்த ஃபோன் வழியாகக் குறுஞ்செய்திகளை அனுப்பலாம், படித்ததாகக் குறிக்கலாம், பின் செய்யலாம், ஒலியடக்கலாம், காப்பகப்படுத்தலாம். நீக்கவோ, தடுக்கவோ, மறையாக்கத்தை மாற்றவோ முடியாது. குறுஞ்செய்திகள் கணினியின் வட்டில் வைக்கப்படுவதில்லை.",
  "wc79ea429": "தேர்வை நிறுத்து",
  "wc7f41969": "மைக்ரோஃபோன்",
  "wc80631f3": "பெயர் மாற்று",
  "wc8080054": "உரையாடலைத் திற",
  "wc82fae4e": "உங்கள் ஃபோன்",
  "wc8352b3c": "மறையாக்கம்",
  "wc85d74b2": "ஸ்பேஸ் அமைப்புகள்",
  "wc8636fa0": "குறியீட்டை ஸ்கேன் செய்யவும்",
  "wc89721e5": "சரிபார்க்கப்பட்டது",
  "wc8ae1110": "தொடர்புகள்",
  "wc8c2ac08": "இந்தக் கணினி Google Messages உரையாடல்களைக் காட்டுவதை நிறுத்தும். அதுவரை Google Messages இதை Device pairing-இன் கீழ் பட்டியலிடும்.",
  "wc8ec83ed": "எல்லா மாறிகளையும் நகலெடு",
  "wc99fc588": "புதியவர்கள் இவ்வாறு சேருவார்கள்",
  "wc9b5e9b9": "வரவேற்பு ஸ்பேஸ்",
  "wca024b74": "செருகுநிரல் கோப்பைத் தேர்ந்தெடுக்கவும்",
  "wca09cd18": "உங்களுக்குத் தெரிந்தவர்கள் சேரும்போது அறியுங்கள்",
  "wca5e631d": "புதிய அரட்டை",
  "wca602c21": "குறியீடு",
  "wcaa917ae": "முனைக்கு-முனை முத்திரையிடப்பட்டது",
  "wcab92486": "எதிர்வினையின் ஒலி, இந்த ஒலியளவில்.",
  "wcadb8866": "நீங்கள் உள்ள வட்டத்தில் புதியவர் சேரும்போது சொல்லப்படும்.",
  "wcb0ba2da": "உள்நுழைவுக் குறியீடுகள்",
  "wcb162480": "இங்கே புதிய குழு",
  "wcb185723": "தேர்ந்தெடுக்கப் பதில்கள்",
  "wcb691d8e": "கூடுதல்கள்",
  "wcb7fbec6": "தரம்",
  "wcbeb9acc": "நிர்வாகியாக்கு",
  "wcbec09bd": "Signal-இடம் குறியீடு கேட்கிறது…",
  "wcc5fb98c": "ஃபோனிலேயே, எண் மற்றும் வார்த்தைகளிலிருந்து ஊகிக்கப்பட்டது.",
  "wcc70c353": "இன்னும் அழைப்புச் சொல் இல்லை",
  "wcc785525": "வெளியேறி இங்குள்ள அனைத்தையும் நீக்கு",
  "wcc8e6982": "டெவலப்பர் பயன்முறை ஏற்கனவே இயக்கத்தில்: அமைப்புகள் › டெவலப்பர்.",
  "wcc95070a": "Zip கோப்பு",
  "wa8c69f7d": "அவர்கள் இருக்கும் இடத்திலேயே தடுக்கப்படுவார்கள்: உங்கள் ஃபோனில் ஒரு எண், அந்த நெட்வொர்க்கிலேயே ஒரு Telegram அல்லது Signal நபர், எனவே அவர்களின் ஆப்களிலும் இது பொருந்தும். அரட்டையில் ஒருவரின் பெயரை நீண்ட நேரம் அழுத்தி அவரைத் தடுக்கவும்; Uplink நபரை, அவரைப் புகார் செய்யும்போது.",
  "wccd6c9d6": "புதிய சாதனம் அதே ஆறு இலக்கங்களைக் காட்டுகிறதா?",
  "wcd17328e": "சுயவிவரம்",
  "wcd86acc3": "மூடு",
  "wcd98d2a2": "உள்நுழையும் முன் இதைப் படியுங்கள்.",
  "wcda28730": "யாருடைய வார்த்தைகளையும் புரிந்துகொள்ள முடியவில்லை.",
  "wcdb9cea9": "யாரிடம் கேட்கப்படும்",
  "wcde554d0": "படங்கள்",
  "wcdf20c41": "இந்தச் சாதனத்தில் ரிலேயை ஹோஸ்ட் செய்வதை நிறுத்தவா?",
