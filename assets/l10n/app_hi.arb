  "w5a7bf6df": "म्यूज़िक की आवाज़",
  "w5a91f77c": "साउंडबोर्ड",
  "w5aa6e8e3": "किसी चैट में भेजें",
  "w5aa7eec3": "ग्रुप से हटाएं",
  "w60df8b2d": "Uplink ID",
  "w5abe5677": "कोट करें",
  "w5aff8be0": "लंबा लिंक काम करता रहता है।",
  "w5b60e265": "समीक्षा के लिए कुछ बाकी नहीं।",
  "w5b67c80c": "वीडियो",
  "w5b8151eb": "अपने फ़ोन नंबर से लिंक करें",
  "w5c0615b1": "https://… या you@example.com",
  "w5c14b1c3": "डीबग बिल्ड में अपडेट बंद हैं।",
  "w5c2fec4d": "नए डिवाइस से जुड़ रहा है",
  "w5c4c4278": "Authorization: Bearer <token>",
  "w5c6010b7": "अपने फ़ोन पर Google Messages खोलें, अपनी प्रोफ़ाइल फ़ोटो टैप करें, फिर डिवाइस पेयरिंग, फिर QR कोड स्कैनर, और इसे इस कोड पर रखें।",
  "w5c745d53": "स्क्रीन बंद होने के कुछ मिनट बाद Android किसी ऐप को रोक देता है जब तक वह सूचना न दिखाए, और ऐप को उसे छिपाने नहीं देता। यह उतनी शांत है जितना Android अनुमति देता है: शेड के नीचे एक लाइन, न आइकन, न आवाज़। Android के पेज पर इसे बंद करने के लिए दबाएं; कंप्यूटर फिर भी फ़ोन तक पहुँचता है।",
  "w5c8aa732": "इसका चेहरा",
  "w5ca266a6": "आपकी भूमिका",
  "w5cc2cc15": "आपके संपर्क पढ़े जा रहे हैं…",
  "w5ccea9ba": "जिनके पास ऐप नहीं है, वे SMS से इसमें हैं, जो आपके फ़ोन और आपके नंबर से भेजे जाते हैं।",
  "w5d7e4c90": "RCS सेट करें",
  "w5d8e29e5": "लाइसेंस",
  "w5d9c9718": "प्रतिबंधित सेटिंग की अनुमति दें",
  "w5db48b37": "फ़ाइलें इस हिसाब से छांटें",
  "w62ea5708": "यह mautrix-gmessages (GNU AGPL) पर बने एक ओपन-सोर्स हेल्पर से होता है, जो सीधे Google से बात करता है, कभी Uplink के सर्वर से होकर नहीं।",
  "w5dcdd537": "वर्शन",
  "w5ddb3d62": "स्पेस",
  "w5e066c0e": "कॉल में दूसरी आवाज़ें धीमी करें",
  "w5e439ffe": "एन्क्रिप्ट करना चाहते हैं: आपकी हाँ का इंतज़ार",
  "w5e6a7440": "मार्केटप्लेस",
  "w5e6abf3b": "Opus, वह कोडेक जो कॉल इस्तेमाल करती हैं। 510 kb/s स्टीरियो इसकी सबसे ऊँची सीमा है: इतना कि कान माइक्रोफ़ोन से फ़र्क नहीं कर सकता। FLAC लाइव कॉल में नहीं जा सकता।",
  "w5ebd2c27": "एक छोटा सा जोड़, किसी वाक्य से चुना शब्द, या पहेली, एक बार भेजी जाती है और बताती है कि यह आपके ऐप की अपने-आप होने वाली जाँच है। सही जवाब चैट को Messages में ले आता है; गलत जवाब पर एक और मौका मिलता है, फिर वह रुकी रहती है।",
  "w5ef944a4": "आप जो लुक इस्तेमाल कर रहे हैं, उस पर अपनी स्टाइल लिखें। ऐप :root पर सेट CSS वैरिएबल पढ़ता है, जैसे --app-accent। जो कुछ भी ऐप को दिखने या पढ़े जाने से रोके, उसे छोड़ दिया जाता है और नीचे लिस्ट किया जाता है।",
  "w5f010dc8": "लॉग में कुछ नहीं",
  "w5f146018": "Google से साइन इन करें",
  "w5f186b29": "तस्वीर",
  "w5f74079c": "मेरे डिवाइस पर प्लगइन सिंक करें",
  "w5f7ba28a": "Discord सर्वर जोड़ें",
  "w5fa0a1bc": "पता कॉपी करें",
  "w5fae222e": "माइक्रोफ़ोन, कैमरा और स्पीकर",
  "we7380e22": "फ़ाइल स्पेस अभी ब्राउज़र में नहीं हैं। यह फ़ोन या कंप्यूटर पर Uplink में खुलता है।",
  "w602f49ca": "इसके बजाय कोड पेस्ट करें",
  "w60643421": "कॉपी करने पर पढ़ा गया",
  "w60649cb8": "नई कुंजी भेजी: इसकी समीक्षा करें",
  "w6072a740": "स्वागत मैसेज",
  "w609d253c": "न्योता भेजा",
  "w60b827ca": "आवाज़ बदलने से पहले आपके पीछे के कमरे की आवाज़ हटा दी जाती है।",
  "w60d0e94e": "सोल्स और बैज",
  "w60e47df0": "चालू",
  "w610d5670": "बैकग्राउंड का शोर हटाएं",
  "w616a6784": "अपने-आप",
  "w617f0a28": "स्पैम में बातचीत म्यूट करें",
  "w61e3374c": "यह बातचीत",
  "w61e6be1a": "नहीं",
  "w61e9eac0": "नंबर",
  "w4ee7b3f5": "Google Messages की सूचनाओं की अनुमति रखें (उन्हें साइलेंट पर रखें): RCS चैट देखने के लिए Uplink उन्हें पढ़ता है। पूरी तरह बंद होने पर Uplink को कुछ नया नहीं दिखता।",
  "w62889f8b": "रात में अनजान लोग शांत",
  "w6296794f": "इससे क्या नहीं रुकता",
  "w62af68ae": "रिले का पता",
  "w62e395aa": "जब चाहें फिर से बंद करें।",
  "w630eebb5": "इसकी लिस्टिंग",
  "w63156b2e": "फ़ोल्डर मिटाएं",
  "w63496325": "स्पेस जोड़ें",
  "w639e7cd0": "सर्कल का नाम",
  "w63cc7b7a": "दोस्त",
  "w640b8949": "कहीं से भी, डायरेक्ट के ज़रिए",
  "w6426ce4b": "टेक्स्ट कॉपी करें",
  "w6486c996": "कुछ शब्द (वैकल्पिक)",
  "w64cb88d2": "बड़ा",
  "w64e30406": "जब ऐप बंद हो",
  "w64ecd2ec": "इस थीम पर अपनी स्टाइल लिखें",
  "w650280c9": "सूचना क्या दिखाती है",
  "w654f8e88": "ये मेल नहीं खाते",
  "w658f3664": "कॉपी करें",
  "w66139a7e": "प्लगइन पेस्ट करें",
  "w66150877": "बंद: जिन डिवाइस ने अपडेट नहीं किया वे इसे रखते हैं। चालू: यह हर एक पर बंद कर दिया जाता है।",
  "w664022f4": "नए सदस्य कहाँ पहुँचते हैं, और स्वागत कहाँ दिखता है",
  "w66a27845": "आपके फ़ोन से RCS",
  "w66c48cc0": "किसी को SMS से जोड़ें",
  "w66de7a09": "विवरण",
  "w66fdce0c": "इतने समय बाद लॉक करें",
  "w671a85e3": "नंबरों की जगह नाम और फ़ोटो। इसके बिना दूसरे डेवलपर के प्लगइन कुछ नहीं देखते, क्योंकि वे आपके संपर्कों और अनजान लोगों में फ़र्क नहीं कर सकते।",
  "w674255c6": "मार्केटप्लेस से फिर पूछें",
  "w6756e280": "यह कॉल रिकॉर्ड करें",
  "w3dd4cc64": "ब्राउज़र में Uplink",
  "w67b18f6b": "अभी के लिए आपकी अपनी आवाज़",
  "w67d59f13": "SMS का अनुवाद डिवाइस पर ही होता है और उन्हें कभी कहीं नहीं भेजा जाता। हर भाषा का मॉडल है ",
  "w67e00bc7": "मैं",
  "w688c7c4a": "सब कुछ हटाएं",
  "w688d41ff": "उन सर्वर के लिए जो अब भी इसे लेते हैं। matrix.org और Matrix Authentication Service वाले दूसरे सर्वर सिर्फ़ ब्राउज़र से साइन इन करते हैं।",
  "w688e1aca": "डिफ़ॉल्ट SMS ऐप नहीं",
  "w68b19886": "पढ़ने की रसीद",
  "w68e6cb10": "आइकन",
  "w691586d8": "अपने यूज़रनेम और पासवर्ड से, या अपने रिकवरी शब्दों से",
  "w693d7cb7": "पेज का कोड",
  "w6966e24b": "आप जिस स्पेस में हैं, उसके लोग इसे वहाँ आपकी प्रोफ़ाइल पर देखते हैं।",
  "w6974ad65": "नेटवर्क",
  "w698d2695": "बातचीत मिटाएं",
  "w69960bb6": "लुक",
  "w69975ed7": "जवाब कॉपी करें",
  "w69b2e45d": "इमोजी सेट",
  "w69c677b4": "सिर्फ़ लोकल नेटवर्क से",
  "w6a75a25f": "जवाब का इंतज़ार कर रहे SMS के नीचे, लिखने की जगह के ऊपर तीन छोटे जवाब।",
  "w6aadbedc": "अभी कोई रिकॉर्डिंग नहीं",
  "w6ac8ead1": "एडमिन यूज़रनेम और पासवर्ड। सिर्फ़ आपका खाता (@matt) साइन इन कर सकता है, और सिर्फ़ तब जब यह डिवाइस कनेक्ट हो।",
  "w6af21072": "सभी चुनें",
  "w6b12f001": "नहीं आया",
  "w6b190f49": "साइन-इन कोड के साथ थोड़ी ढील दें",
  "w6710e4fc": "आपके मैसेज सिर्फ़ इस डिवाइस और Google के बीच जाते हैं। Uplink के सर्वर उन्हें कभी नहीं देखते; इस डिवाइस पर सिर्फ़ वह साइन-इन रखा जाता है जो Google लौटाता है।",
  "w6b3f7c19": "तरीके",
  "w6b489a0c": "कोई बातचीत बबल बनकर स्क्रीन के किनारे रह सकती है और आप जो भी कर रहे हों उसके ऊपर खुल सकती है।",
  "w6b54192f": "आपके दोस्तों को, और आपके स्पेस और सर्कल के उन लोगों को दिखता है जो आपकी प्रोफ़ाइल खोलते हैं।",
  "w6b871c31": "आपका खाता खुल रहा है",
  "w6b91874f": "सख्ती",
  "w6bbc4b1a": "नए सदस्य कहाँ पहुँचें?",
  "w6bc02927": "elevenlabs.io पर Developers › API keys खोलें और एक बनाएं। अगर आप इसे सीमित करें, तो इसे Voice Changer इस्तेमाल करने और Voices पढ़ने दें।",
  "w6c150a2f": "अपना बैकअप अपडेट करें",
  "w6c48f1fa": "कोई दोस्त एक साल के लिए गवाही दे सकता है कि यह खाता सच में आपका है। आपके दोस्तों को आपकी गवाहियाँ मिलती हैं, और हर कोई सिर्फ़ अपने दोस्तों की गवाहियाँ गिनता है: सबकी गिनती कभी नहीं।",
  "w6c4bc446": "मैसेज के मेन्यू में मुझे याद दिलाएं, और आपके किसी ऐसे SMS के बाद एक सुझाव जिसमें आपने कुछ वादा किया हो।",
  "w440d1541": "Uplink पर",
  "w6ceb2d06": "सफ़ेद",
  "w6cef8c0f": "पुष्टि नहीं हुई",
  "w6d06cd6d": "यह वर्शन",
  "w6d0cf831": "इन्हें लिख लें",
  "w6d24a6aa": "किसी का भेजा हुआ .ghostlook, या आपका सेव किया हुआ",
  "w6d267c97": "सभी को पढ़ा हुआ मार्क करें",
  "w6d37cd09": "Notion टोकन",
  "w6d9a358c": "मिटाएं, और फिर न पूछें",
  "w6dc2158f": "साइन-इन कोड, QR कोड के रूप में",
  "w6de7fb69": "जो तस्वीर वाला मैसेज फ़ेल होता है, वह बातचीत में अपने नीचे कारण बताता है। अगर वे फ़ेल होते रहें, तो रिपोर्ट कॉपी करें और जो भी मदद कर रहा है उसे भेजें।",
  "w6e0b77c2": "अभी कुछ नहीं भेजा। प्लगइन बना लेने पर उसे सबमिट करें।",
  "w6e5157ff": "रात 10–सुबह 7 शांत",
  "w6e631bbc": "इस मिक्स को नई रिकॉर्डिंग के रूप में सेव करें",
  "w6e78b439": "मिक्सर बंद करें",
  "w6e828855": "ऊपर की लाइनें टेक्स्ट के रूप में। इसमें कोई मैसेज, नाम या नंबर नहीं हैं।",
  "w6e91c16e": "सेव करें नंबर भरा हुआ नया संपर्क खोलता है; ब्लॉक करें उसे Android के ब्लॉक किए गए नंबरों में जोड़ता है; अभी नहीं उस बातचीत के लिए लाइन हटा देता है।",
  "w6ee050df": "API चलाएं",
  "w6eeeb86c": "डिलीवरी और ट्रैकिंग",
  "w6eeeddf4": "नंबर सत्यापित",
  "w6efabaa4": "लिंक शेयर करें…",
  "w6f42681d": "आखिरी भेजा गया",
  "w6fcfdc72": "\"स्पैम में ले जाएं\" भेजने वाले को हमेशा वाली सूची में डालता है, \"स्पैम नहीं\" कभी नहीं वाली सूची में।",
  "w6fd020b4": "रुका हुआ: यह ऐप को धीमा कर रहा था।",
  "w6fd69264": "नए डिवाइस में साइन इन करें",
  "w700560f3": "पता",
  "w7013fdad": "सर्कल कुछ लोगों और उनके स्पेस को एक साथ रखता है: चैट और वॉइस के लिए, SMS के लिए, या फ़ाइलों के लिए।",
  "w7046920d": "जब तक यह Play Store पर न आ जाए",
  "w704c607e": "कोई नहीं",
  "w707cd633": "Google Messages के साथ इस्तेमाल करें",
  "w708e8f26": "सिर्फ़ सीधे लिंक से",
  "w70927964": "मेरी आवाज़ें फिर से पढ़ें",
  "w70ad7706": "अपडेट देखें",
  "w70b70268": "नंबर, ईमेल पते या नाम जो कभी स्पैम नहीं होते, संपर्क हों या नहीं।",
  "w70c44780": "Telegram, Signal और भी बहुत कुछ",
  "w70f0c463": "रिपोर्ट कॉपी करें",
  "w70f81095": "कैरियर ने बताया, पर अभी डाउनलोड नहीं हुए। हर बार ऐप खुलने पर इन्हें फिर से माँगा जाता है; अभी माँगने के लिए टैप करें।",
  "w710d76d5": "लॉगिन पर खोलना, और जागे रहना: गाइड।",
  "w71945ea4": "अगर फ़ोन न मिले",
  "w71d55b4d": "उनका क्रम और हेडिंग",
  "w71fd4acf": "पहले जैसा करें",
  "w7c602f92": "अभी कोई नहीं। कंप्यूटर पर Uplink इस फ़ोन की बातचीत दिखाता है और इसके ज़रिए SMS भेजता है। SMS सिर्फ़ फ़ोन ही भेजता है।",
  "w722bbd7c": "इस फ़ोन के लिए नई कुंजी बनाएं? हर बातचीत में फिर से कुंजियों का आदान-प्रदान होने तक सभी के साथ एन्क्रिप्शन खत्म हो जाता है, और पुरानी कुंजी से सील किए SMS बाद में नहीं खोले जा सकते।",
  "w722c85cd": "कोई नेटवर्क नहीं चुना",
  "w72430853": "चलाएं",
  "w724acd86": "दोस्त, SMS या लिंक",
  "w728f78a8": "सिर्फ़ इस फ़ोन पर बदलें",
  "w72b479cf": "कोड वाले SMS को एक संकेत और चाहिए: असली कोड अक्सर लिंक के साथ \"अगर यह आप नहीं थे, तो अभी कार्रवाई करें\" कहते हैं। सख्त या सबसे सख्त पर नहीं।",
  "w72c64ad8": "अभी ब्राउज़र में नहीं",
  "w72dd87c3": "RCS",
  "w7341967e": "पेयर किए गए कंप्यूटर",
  "w7363d9be": "लोकल नेटवर्क",
  "w73690b65": "आर्काइव करें",
  "w736b33b8": "Discord में खोलें",
  "we4bc19fe": "Uplink वाले लोगों को ढूंढें",
  "w744be623": "साइन इन करें",
  "w748c09c2": "हर लाइन में एक गेम का नाम, जैसा वह दिखता है।",
  "w74aa0307": "खाता कुंजी शेयर करें",
  "w74f576af": "वॉल्यूम",
  "w75244c0a": "आपकी ElevenLabs आवाज़ें",
  "w755d6675": "इसकी सेटिंग के सारे स्विच चालू, जैसे आपने चालू किए हों।",
  "w758add25": "कोड",
  "w75afe364": "सभी",
  "w75c5531a": "वॉइस मैसेज भेजें",
  "w75ceeba7": "साउंडबोर्ड की आवाज़",
  "w75dd326a": "वैकल्पिक · लिंक नहीं",
  "w75e9d1ad": "हर प्लगइन की सेटिंग मार्केटप्लेस में उसके पेज पर है।",
  "w75fa677f": "हर नया सदस्य इसे स्वागत स्पेस में सबसे ऊपर देखता है। {name} उनका नाम है। कुछ न दिखाने के लिए खाली छोड़ें।",
  "w76139e92": "Android इसके लिए फ़ोन पर चलने वाला मॉडल Wi-Fi से डाउनलोड कर रहा है। इसके आते ही सारांश शुरू हो जाएंगे; कुछ भी कहीं नहीं भेजा जाता।",
  "w7617834a": "मुझे ऐसे दिखाएं",
  "w76419bf3": "इसे आज़माने के लिए एक SMS",
  "w7664c180": "समीक्षा कतार से बाहर।",
  "w769d4ae8": "रिपोर्ट",
  "w76a95f12": "अगले हफ़्ते तक (सोमवार, सुबह 9 बजे)",
  "w7747493b": "चुनिंदा",
  "w77488b99": "ब्राउज़र में",
  "w7788402d": "हर भाषा लगभग 30 MB की है, जो एक बार डाउनलोड होती है, पहली बार जब किसी SMS को उसकी ज़रूरत हो।",
  "w77b3e4d1": "चैट बैकग्राउंड",
  "w7809558c": "कॉल शुरू करें",
  "w7845047b": "प्रीव्यू कैसे बनता है",
  "w786bc275": "अभी कोई नहीं।",
  "w786e98a7": "उस ऐप में जो इसे पढ़ता है",
  "w7892ced8": "नए लोग",
  "w789cf411": "क्यों (उन्हें दिखता है): \"Windows का क्रैश ढूंढा\"",
  "w78d564d5": "कुछ लोगों के SMS नहीं आ रहे",
  "w78e3e875": "अनुवाद करें",
  "w7936ddf6": "प्लगइन के पेज का आकार बदलें",
  "w7966645f": "पूरा ऐप कैसा दिखता है। हर लुक आपके बबल के लिए अपना रंग लाता है, जिसे आप नीचे फिर भी बदल सकते हैं। चार रंगों और एक फ़ॉन्ट से अपना लुक बनाएं, और उसे कोड या फ़ाइल के रूप में शेयर करें।",
  "w79832240": "जुड़ने के बाद, इसकी सेटिंग यहाँ होंगी।",
  "w79da5575": "तस्वीर पेस्ट करें",
  "w79de40e1": "स्पेस से हटाएं",
  "w7a640fec": "Android ने किसकी अनुमति दी है",
  "w7a669d4a": "एलिमेंट (button, div) और सादी प्रॉपर्टी (color: red) के नियम कुछ नहीं करते: ऐप वैरिएबल से बनता है। फ़ॉन्ट सिर्फ़ वही हो सकते हैं जो ऐप में हैं।",
  "w7a711071": "आते ही SMS का अनुवाद करें",
  "w7aa6f0e7": "API",
  "w7ab059ae": "पहले इसकी समस्याएं ठीक करें।",
  "w7b21c29c": "सोल्स दें",
  "w7b254006": "कभी स्पैम नहीं: भेजने वाले",
  "w7b297afa": "इसे हटाएं",
  "w7b6d407f": "अप टू डेट",
  "w7b8038d9": "क्यों",
  "w7b8411a2": "जोड़ें और SMS भेजें",
  "w7b8e39a1": "बंद होने पर, आप SMS के मेन्यू से अनुवाद करें चुनते हैं।",
  "w7b99a035": "कोई नहीं: सब सही है।",
  "w7bb8f761": "न पढ़ी गई बातचीत का सारांश बनाएं",
  "w7bc5539d": "सोल्स कार्ड, दोहराया गया",
  "wa0b3b730": "Google Messages एक समय में एक ही वेब सेशन रखता है, और वह आपके फ़ोन पर Uplink के पास है। यह कंप्यूटर आपके फ़ोन के ज़रिए वही बातचीत दिखाता है।",
  "w7bf69370": "कनेक्ट है",
  "w7bfbbbbc": "डायरेक्ट",
  "w7cb6b6f8": "किसी दूसरे ऐप से भेजें",
  "w7cec082b": "अभी ब्राउज़र से नहीं",
  "w7cf7aeb3": "ghostapi1:… जिसके पास यह है वह API कॉल कर सकता है: इसे पासवर्ड की तरह संभालकर रखें।",
  "w7cfd61b2": "पूछें",
  "w7d0d3efe": "हर रिकॉर्डिंग सेव होने पर उसे लिखें",
  "w7d66c7d7": "बातचीत की सेटिंग",
  "w7db1a648": "दोस्तों को मेरा नंबर और लिंक किए खाते दिखाएं",
  "w7dbf917d": "एक तस्वीर चुनें",
  "w7dcce3a5": "इसे शेयर करें",
  "w7de460ef": "वे रंग जो Android इस फ़ोन के वॉलपेपर से लेता है, जिन्हें फ़ोन के अपने ऐप भी अपनाते हैं। वॉलपेपर बदलने पर यह बदलता है।",
  "w7e09f19b": "इसे यहाँ वापस लाएं",
  "w7e11c46d": "मुझे जोड़ने का आपका लिंक, QR कोड के रूप में",
  "w7e288acb": "मेरे लिए म्यूट करें",
  "w7e34b97f": "जहाँ SMS में लिखा हो, वहाँ कोड को उसके नंबर की जगह उस कंपनी के नाम से दिखाया जाता है जिससे SMS आया है (Coinbase, Discover)।",
  "w7e45c4c5": "सर्कल के लिए",
  "w7eb08fad": "किसी नए व्यक्ति ने आपको जिस ग्रुप में जोड़ा, उसे भी रोककर पूछा जाता है।",
  "w7eeb8efd": "आपने यह सर्कल छोड़ दिया।",
  "w7f0282c4": ":root { --app-accent: #ff5c8a; }",
  "w7f18690f": "अभी कोई आवाज़ नहीं। अपनी कुंजी जोड़ें, या उन्हें फिर से पढ़ें।",
  "w7f2c35ea": "यहाँ चालू करने पर, प्लगइन इस सर्कल के स्पेस में हर सदस्य के लिए काम करता है, बिना किसी के जोड़े।",
  "w7f948750": "मुझे SMS से कोड भेजें",
  "w7f97edaa": "माइक्रोफ़ोन जैसा है वैसा, म्यूज़िक के लिए: न इको कैंसलेशन, न नॉइज़ सप्रेशन, न गेन, स्थिर दर पर 510 kb/s स्टीरियो। हेडफ़ोन इस्तेमाल करें।",
  "w80324733": "आप अभी जहाँ हैं, उसके आसपास",
  "w80595241": "स्पेस और सर्कल को बताएं",
  "w8062364f": "Mastodon में साइन इन करें",
  "w80848996": "Microsoft के पेज पर आपकी मंज़ूरी का इंतज़ार है…",
  "w80bbfee7": "इस रूप में शामिल हों",
  "w80c5c254": "जो भी अभी इस पर है, वह नए पर फिर से साइन इन करता है।",
  "w80d8dbd0": "डेवलपर मोड",
  "w810f664e": "अनुमतियाँ साफ़ करें",
  "w812746a9": "सर्कल",
  "w8128be8c": "कोड कॉपी करें",
  "w812abd0e": "आपका स्कूल, आपका काम",
  "w812b46de": "अपने किसी मौजूदा खाते से शुरू करें",
  "w81abc3d7": "मेरे बारे में सब कुछ हटाएं",
  "w394a471e": "कुंजी, नई कुंजी, और Uplink वाले लोगों को ढूंढना, फ़ोन पर सेटिंग › एन्क्रिप्शन में सेट होते हैं।",
  "w81f51acc": "ऐप",
  "w8210607e": "इस ऐप में इमोजी कैसे दिखते हैं। दूसरे व्यक्ति को जो दिखता है वह उनका अपना फ़ोन बनाता है।",
  "w82241975": "तुरंत और मुफ़्त। एक इफ़ेक्ट: भारी, पतली, रोबोट और भी बहुत कुछ।",
  "w82278ca8": "कुछ आर्काइव नहीं",
  "w824bbd4c": "आपके मैसेज Android के अपने मैसेज स्टोर में रहते हैं, इसलिए किसी दूसरे ऐप पर वापस जाने पर भी सब वहीं रहते हैं।",
  "w8268ce50": "इसकी कौन सी सूचनाएं अब भी आवाज़ करती हैं, उनके आखिरी मैसेज के अनुसार, हर एक के साथ उसे शांत करने का तरीका: इसके आने वाले मैसेज, और अपनी अलग आवाज़ वाली कोई भी बातचीत।",
  "w826f7f7c": "अपलोड करें",
  "w829f4dad": "दोस्त जोड़ें",
  "w82b317a8": "इन्हें सिर्फ़ एडमिन बदल सकते हैं।",
  "w82e16a26": "ये किसी भी संकेत के गिने जाने से पहले फ़ैसला करते हैं। “कभी नहीं” सूची, “हमेशा” सूची पर भारी पड़ती है।",
  "w8313d4fa": "रिकॉर्डिंग रोकें",
  "w83658a3a": "सिर्फ़ इसके रंग और फ़ॉन्ट",
  "w83666356": "लोगों को एक से ज़्यादा चुनने दें",
  "w83787b9a": "अपने-आप अपडेट",
  "w8390060e": "लोग",
  "w8393950d": "एरर, और हर तस्वीर वाला मैसेज: उसे किसमें बदला गया, कितना बड़ा था, और कैरियर ने क्या जवाब दिया। आखिरी 300 लाइनें रखी जाती हैं।",
  "w839b241a": "बताएं कि आप अभी इसे किस पर सुन रहे हैं, और उस पर लॉसलेस चलेगा।",
  "w844f7eb8": "इस बिल्ड में उपलब्ध नहीं",
  "w847d7bcb": "प्लगइन",
  "w84b358d7": "साइन-इन कोड वाले SMS में उसे कॉपी करने का बटन आता है।",
  "w8aa21ca7": "Uplink आपके SMS के बिना भी काम करता है: दोस्त, सर्कल, Telegram और Signal। अपने SMS यहाँ भी पढ़ने और भेजने के लिए SMS चालू करें, अपने SMS ऐप के रूप में या Google Messages के साथ।",
  "w84c2de12": "शब्द कॉपी करें",
  "w84c561ff": "बैन हटाएं",
  "w84e87f42": "सुनना बंद करें",
  "w850360c9": "लॉग कॉपी करें",
  "w855fc3fb": "स्लो मोड",
  "w8570fe3a": "ज़ूम आउट करें",
  "w85722a69": "यह फ़ोन ऑफ़लाइन है। अगली बार ऐप सामने आने पर यह फिर देखेगा।",
  "w85e4b82f": "ठीक है",
  "w86041405": "शब्दों में लिखा कोई फ़ोन नंबर; कोई साइन-इन कोड।",
  "w8b4c37fd": "Uplink अभी डिफ़ॉल्ट नहीं है",
  "w86522cd9": "आइकन",
  "w867866f0": "संभावित धोखाधड़ी",
  "w8700fd83": "अनुमतियाँ",
  "w872d71b7": "उस Google Messages के लिए जिसमें Google खाते से साइन इन नहीं है, जहाँ डिवाइस पेयरिंग में अब भी QR कोड स्कैनर है: कोड दूसरी स्क्रीन पर दिखाता है।",
  "w878c122d": "अपने SMS यहाँ पेस्ट न करें।",
  "w8794388d": "हाल में दिए",
  "w87a5ea1d": "इन्हें सेटिंग › डेवलपर में लोड और मैनेज करें",
  "w87e5eacf": "सेट नहीं है",
  "w87f62cb7": "जाँच हो रही है…",
  "w87f6bf6e": "पासवर्ड बदलें",
  "w8815b64f": "इसे यहाँ इस्तेमाल नहीं किया जा सकता",
  "w881c63cf": "लाइव",
  "w883c2766": "इस नंबर पर SMS से एक कोड भेजा जाता है, और उसका वापस आना दिखाता है कि नंबर इसी फ़ोन का है। रिले सर्वर और वह जिस SMS सेवा का इस्तेमाल करता है, नंबर देखते हैं। किसी और को नहीं बताया जाता।",
  "w885a2668": "कुंजी आपके फ़ोन के पास है",
  "w8882ef8f": "इस बिल्ड में नहीं",
  "w88b3c0ac": "तस्वीर हटाएं",
  "w88bfa09e": "Lucide (ISC लाइसेंस)।",
  "w88da30bb": "Signal लिंक करें",
  "w8947b567": "WhatsApp से कोड माँगा जा रहा है…",
  "w898f1bc6": "सैंपल की एक तस्वीर जोड़ें",
  "w89a480eb": "आपका नंबर",
  "w89af3e62": "अनुमति नहीं",
  "w89ffa9c0": "इस फ़ोन की कुंजी",
  "w8a3dc53e": "जब कोई ग्रुप आपको कॉल करे तब बजती है। सुनने के लिए किसी एक को टैप करें।",
  "w8a8f1ae7": "आपका हस्ताक्षर किया बयान",
  "w8aa8a89d": "कॉल में आपकी आवाज़ कैसे बदली जाए?",
  "w8aac0f18": "इनकी बातचीत आते ही म्यूट हो जाती है। \"स्पैम नहीं\" जैसे विकल्प इन्हें फिर से चालू करते हैं।",
  "w8ab96d08": "आगे या पीछे",
  "w8ad2f8cf": "लाइट",
  "w8adf1a5f": "एक घंटे के लिए",
  "w8ae40328": "यह रिकॉर्डिंग मिटाएं? इसे वापस नहीं लाया जा सकता।",
  "w8af577ef": "मदद के लिए धन्यवाद",
  "w8b08b7bb": "नया कोड",
  "w8b242db1": "नया",
  "w8b3dc597": "अभी",
  "w8b4f3c70": "साइन आउट करें",
  "w8b838f34": "फिर से स्कैन करें",
  "w8b87dd90": "सत्यापन हटाएं",
  "w8b8a0c85": "@you:matrix.org",
  "w8b928666": "किसी गाने का लिंक पेस्ट करें",
  "w8b97f7a7": "कीबोर्ड को SMS पाने के लिए Android की अनुमति चाहिए, जो नए वर्शन स्टोर के बाहर के ऐप को नहीं देते, और Android 17 कोड वाले SMS डिफ़ॉल्ट SMS ऐप के अलावा हर ऐप से रोक लेता है। यह ऐप डिफ़ॉल्ट SMS ऐप है, इसलिए इसे कोड तुरंत मिल जाता है।",
  "w8ba6ad99": "सब कुछ कैसे काम करता है, कदम-दर-कदम, gogho.st/docs पर।",
  "w8bbfa856": "SMS यहीं जाँचे जाते हैं और कहीं नहीं भेजे जाते। कुछ भी मिटाया या ब्लॉक नहीं किया जाता: स्पैम में बातचीत किसी दूसरी की तरह ही खुलती है, और \"स्पैम नहीं\" उसे हमेशा के लिए वापस रख देता है।",
  "w8c080543": "1. बॉट जोड़ें",
  "w8c6744af": "इसका पासफ़्रेज़",
  "w8c7b596f": "पूरी तरह स्लाइड करने पर बातचीत मिटाने से पहले पूछा जाता है। बंद होने पर, यह तुरंत मिट जाती है।",
  "w8c848ead": "इसे यहाँ ले जाएं",
  "w8c856dd1": "Markdown, तस्वीरों और फ़ाइलों के साथ",
  "w8c87fca6": "शामिल हो रहे दोस्त",
  "w8cb56c02": "यह फ़ोन अनपेयर करें",
  "w8d2937a1": "लिस्ट करें",
  "w8d4bcec1": "बयान जाँचें",
  "w8d7930b6": "एक तस्वीर",
  "w8d80552f": "कौन",
  "w8d881f4f": "एडमिन साइन-इन",
  "w8d9097e6": "प्लगइन समीक्षा",
  "w8d93945f": "डेवलपमेंट में प्लगइन",
  "w8dd31791": "हो गया",
  "w8de6774a": "कुंजियाँ बदलें",
  "w8deb7e3a": "यह कॉपी",
  "w8deb8e24": "सेटिंग बंद करें",
  "w8debcab6": "यहाँ का हर मैसेज, थ्रेड भी, Markdown या JSON के रूप में, चाहें तो उसकी फ़ाइलों के साथ।",
  "w8e15cbd9": "स्पेस, सर्कल में और उनकी प्रोफ़ाइल पर उनके नाम के पास दिखता है।",
  "w8e2a9ee6": "मिक्सर में खोलें",
  "w8e483945": "भेजा जा रहा है।",
  "w8e9060c2": "तस्वीर और ग्रुप मैसेज पर।",
  "w8eafa59a": "Google Messages की हर बातचीत यहाँ दिखती है, RCS और SMS, उनके इतिहास और तस्वीरों के साथ। आपका फ़ोन चालू और ऑनलाइन होना चाहिए: मैसेज उसी से होकर जाते हैं।",
  "w8eba1d51": "बंद होने पर, सिर्फ़ YouTube, Spotify, SoundCloud, Vimeo, TikTok, X, Reddit जैसे लिंक को कार्ड मिलता है।",
  "w8f037c2f": "जब भी ऐप सामने हो, नया वर्शन देखता है।",
  "w8f3184bc": "सिस्टम",
  "w8f4719c7": "यह gogho.st से खुद को अपडेट करता है: नया वर्शन पीछे से डाउनलोड होता है और रीस्टार्ट करने पर, या अगली बार बंद करने पर लग जाता है।",
  "w8f517045": "परफ़ॉर्मेंस",
  "w8f9b3774": "यह किसी के ऐप में चलता है",
  "w901b914f": "कोई स्क्रीनशॉट नहीं।",
  "w902b7e39": "भूमिका",
  "w964afed9": "Uplink में Google Messages सेट करें",
  "w90a9ee82": "रिकॉर्डिंग का फ़ोल्डर",
  "w90e40fab": "Ghost Keyboard को साइन-इन कोड दें",
  "w9110ee5d": "इसका पता: https, या adb reverse के साथ http://127.0.0.1।",
  "w91460811": "बयान",
  "w915bf322": "फ़ाइल",
  "w91a8315d": "सोल्स वापस लें",
  "w91d126d8": "प्लगइन कैसे बनाएं",
  "w91dad0f8": "कहाँ",
  "w91e91987": "चैट बंद करें",
  "w91ee7fb9": "जल्द आ रहा है",
  "wfd6579c8": "आपके मैसेज सिर्फ़ इस डिवाइस और आपके Matrix सर्वर के बीच जाते हैं। Uplink के सर्वर उन्हें कभी नहीं देखते, और आपका पासवर्ड नहीं रखा जाता: सिर्फ़ वह सेशन जो आपका सर्वर लौटाता है, और इस डिवाइस की एन्क्रिप्शन कुंजियाँ।",
  "w9202088e": "लिंक",
  "w924e07cc": "कोई चालू नहीं",
  "w924f3271": "किसी लुक का कोड पेस्ट करें",
  "w929d346a": "इमोजी सेट",
  "w92aea8e8": "इस डिवाइस पर रखा गया",
  "w92c02e76": "इसे कॉल करें",
  "w932ed2b7": "रूट",
  "w93461f34": "समय चुनें…",
  "w934adc9f": "इस डिवाइस पर अपनी ElevenLabs कुंजी भूल जाएं?",
  "w934cec55": "आप जो दूसरी जगह ले जाते हैं, उससे सीखें",
  "w93508a2b": "पता कॉपी करें",
  "w935a806b": "दोस्तों को दिखाएं कि मेरी गवाही कौन देता है",
  "w935f1a4b": "किसी दूसरे ऐप से खोलें",
  "w9381f8d8": "कहाँ से",
  "w8871815a": "Google Messages डिफ़ॉल्ट SMS ऐप है और RCS रखता है। Uplink आपके SMS Android से और RCS चैट Google Messages की सूचनाओं से पढ़ता है, और उसी से जवाब देता है।",
  "w93e63edc": "आपने किसी को रिपोर्ट नहीं किया",
  "w9413bf3d": "आपकी फ़ोटो से।",
  "w943664b7": "प्लगइन",
  "w943e12da": "दूसरे जो चलाते हैं वह सुनें",
  "w947704ea": "हाल में",
  "w9480a318": "डेवलपमेंट वाला एक प्लगइन चालू है · सेटिंग › डेवलपर",
  "w94acf0ab": "आपके संपर्कों में किसी को भी, SMS से",
  "w94d75031": "relay.example.com",
  "w9501c510": "बिल, रसीदें और पार्सल, और ऐसे SMS जिन्हें ऐसे किसी प्लगइन को नहीं छूना चाहिए: साइन-इन कोड, किसी दोस्त का सवाल, अपॉइंटमेंट, इनाम वाली धोखाधड़ी, राजनीतिक SMS।",
  "w1c308a82": "अपने फ़ोन के WhatsApp में: Settings › Linked devices › Link a device, फिर इसे इस कोड पर रखें। Uplink आपके डिवाइस में से एक बन जाता है, जैसे WhatsApp Web है, और आपकी हाल की चैट आ जाती हैं।",
  "w95afdf0e": "स्पैम में ले जाएं",
  "w95d20bf1": "Google का पेज फिर से खोलें",
  "w95dc3445": "कॉल छोड़ें",
  "w95fbfac0": "एन्क्रिप्शन बंद करें",
  "w95fdfd9f": "टाइपिंग डॉट, पढ़ने की रसीद, पूरे आकार की तस्वीरें और इंटरनेट पर ग्रुप चैट, Google Messages के ज़रिए। कुछ कदम, एक-एक करके।",
  "w960209c3": "यह रिले, QR कोड के रूप में",
  "w962cd7ec": "खोजे जाना",
  "w963b0473": "चुनी गई बातचीत",
  "w968f7c61": "यह ऐप क्या पढ़ता और दिखाता है। अगर ये संख्याएं सही हैं और सूची नहीं, तो सूची को फिर से पढ़ने के लिए नीचे खींचें।",
  "w96913f28": "नाम टेक्स्ट का अपना रंग रखते हैं",
  "w977bf4cb": "पहले आपका PIN",
  "w97af2cdc": "स्पेस का नाम",
  "w97cb0637": "बताएं कि कहीं और कौन सा खाता आपका है, और हस्ताक्षर किया ब्लॉक वहाँ पेस्ट करें: बायो, पोस्ट या पेज में। यह दिखाता है कि शब्द इसी खाते से आए, और कब।",
  "w97ecbef1": "किसका है यह देखने के लिए एक पेस्ट करें",
  "w97f4a04f": "जिसके पास पुराना है, वह बाहर हो जाता है।",
  "w982f5c27": "आपकी आवाज़ की तीव्रता बराबर करता है। बंद होने पर आपका अपना लेवल रहता है।",
  "w983277c4": "1 मिनट",
  "w987a959b": "PIN भूल गए?",
  "w987c7d5f": "अनब्लॉक करें",
  "w98a0bb1b": "आपके संपर्कों से बाहर के नंबर से आए हर SMS में नीचे दिए संकेत देखे जाते हैं। कितने चाहिए:",
  "w98d42939": "भूमिका जोड़ें",
  "w98f2ba3a": "अनपेयर करें",
  "w98f9c5f8": "UPS, USPS या FedEx ट्रैकिंग नंबर: उसके लिए कैरियर का पेज।",
  "w991624d5": "कुछ नया शुरू करें",
  "w992c5ed8": "Telegram शुरू हो रहा है…",
  "w9964e50a": "इसका इस्तेमाल न करें",
  "w996b50e4": "जो सर्कल बदल सकता है, वह एक चुन सकता है।",
  "w9970a07a": "इस डिवाइस के नेटवर्क पर डिवाइस के बीच सीधे, बिना सर्वर और बिना इंटरनेट के। तब इस्तेमाल होता है जब रिले सर्वर कुछ न ले जा सके, और अकेले वहाँ जहाँ इंटरनेट बिल्कुल न हो।",
  "w99a275b3": "आपके कंप्यूटर पर आपके SMS",
  "w99d8db05": "यहाँ शामिल हों",
  "w99ef423f": "यह फ़ोन क्या है, तस्वीर वाले मैसेज की स्थिति क्या है, और नीचे का लॉग, टेक्स्ट के रूप में।",
  "w9a06a894": "प्रोफ़ाइल खोलें",
  "w9a166f9d": "शब्द शब्द शब्द …",
  "w9a340434": "गाना जोड़ें",
  "w9a3443cc": "इसके बाद कोई भी इसे ले सकता है। आपके दोस्त आपके दोस्त बने रहते हैं।",
  "w9a73db9b": "भाषा",
  "w9a9b2a58": "कतार",
  "w9aab7b72": "WhatsApp इसे सपोर्ट नहीं करता",
  "w9ad2489c": "जगह",
  "w9ad59e86": "स्क्रीनशॉट",
  "w9b0eb1cd": "यह डिवाइस सत्यापित है",
  "w9b22be74": "मालिक",
  "w9b26c187": "इसमें नया फ़ोल्डर",
  "w9b294ce8": "आपके संपर्कों से बाहर के किसी व्यक्ति का SMS, जिसमें इनमें से कुछ भी हो, स्पैम है।",
  "w9b988fce": "खुद को सुनें",
  "w9c0541b4": "सिर्फ़ इस डिवाइस पर",
  "w9c4ee94e": "ऐप हटाने के बाद भी यह पढ़ता रहता है",
  "w9c5f1f57": "ग्रुप भी",
  "w9ca62efb": "भाषाएं सिर्फ़ Wi-Fi पर डाउनलोड करें",
  "w9cae8a40": "दूसरे रिले पर मौजूद दोस्त आप तक नहीं पहुँच सकते",
  "w9cbc1f86": "इसकी कॉपी इस डिवाइस से हट जाती है। आपकी पसंद तब के लिए रखी जाती है जब आप इसे फिर से लोड करें।",
  "w9d68dbac": "ज़्यादातर Matrix चैट एंड-टू-एंड एन्क्रिप्टेड होती हैं। आपके दूसरे डिवाइस इस डिवाइस के साथ अपनी कुंजियाँ शेयर करें, तो नए मैसेज यहाँ आते हैं। आपकी रिकवरी कुंजी (Element इसे Security Key कहता है) बाकी को अनलॉक करती है: यह डिवाइस आपके डिवाइस के रूप में सत्यापित हो जाता है, और साइन इन से पहले के मैसेज की कुंजियाँ आपके सर्वर के कुंजी बैकअप से आती हैं। यह एक बार इस्तेमाल होती है और रखी नहीं जाती।",
  "w9d902c5a": "पैदल जाएं",
  "w9da98904": "इस कुंजी को रिटायर करने का नोटिस बनाएं?",
  "w9dc3aa14": "जोड़ें",
  "w9dc73f98": "इसे होस्ट करें",
  "w9de87776": "ये गेम कभी न दिखाएं",
  "w9dfc3f83": "अप टू डेट।",
  "w9e13ea41": "इस कुंजी से हस्ताक्षर किया गया, ऑफ़लाइन रखने के लिए कॉपी किया गया। कुछ नहीं भेजा जाता।",
  "w9e47dd8f": "इस नाम से कुछ नहीं",
  "w9e48b282": "फ़ोटो और फ़ाइलें",
  "w9e63c76b": "दोस्ती खत्म होती है; उनके दोस्ती के अनुरोध और आपको भेजे मैसेज छोड़ दिए जाते हैं।",
  "w9eb9d54a": "रिएक्शन जोड़ें",
  "w9ee242a8": "कैमरा बदलें",
  "w9eeb56ea": "एक से चार: लोग इन्हीं से इसे ढूंढते हैं।",
  "w9f0f4c8f": "संभावित स्पैम जहाँ स्पैम फ़िल्टर ऐसा कहे; छोटे कोड, ईमेल पते, या \"Reply STOP\" या \"आपका ऑर्डर\" जैसे शब्दों पर कोई कारोबार; वरना कोई जिसे आप शायद जानते हों।",
  "w9f6e27c6": "xxxx-xxxx-xxxx-xxxx",
  "w9f867905": "अनुमति है · प्रीव्यू छिपे हैं",
  "w9fd463b4": "हर चैट जैसा",
  "w9fd66c0b": "नया SMS",
  "w9ff5be3a": "स्पैम और सेल्स शांत",
  "w9ff92f39": "Ghost Keyboard इस फ़ोन पर है। इसका अपना स्विच इसकी Settings › Row tools में है।",
  "wa012932d": "कोड किसे माना जाता है",
  "wa04ccb84": "सबसे नीचे बनती है, सबके ऊपर",
  "wa070f107": "यह ब्राउज़र ऐसा कुछ नहीं रखता जो आपका खाता बदल सके, इसलिए आपका पासवर्ड इस पेज के लिए इसे खोलता है।",
  "wa0c28cf6": "हर प्रकार के पक्के संकेत और छोटे संकेत होते हैं। किसी SMS को छांटने के लिए कितने चाहिए:",
  "wa0da59a3": "पैकेज कॉपी करें",
  "wa1388e5d": "आपकी CSS",
  "wa14b85b2": "Android कोड को कीबोर्ड से दूर रखता है",
  "wa167b1eb": "यहाँ",
  "wa1b7e43b": "नाम उनकी सबसे ऊँची रंग वाली भूमिका के रंग में दिखते हैं।",
  "wa1d4fef8": "साइन आउट करें और मिटाएं",
  "wa1dd7bf1": "लॉग",
  "wa1eafd4a": "इस ब्राउज़र से आपकी प्रोफ़ाइल, दोस्त और सर्कल, आपके पासवर्ड के बाद",
  "wa233bb96": "कनेक्शन स्ट्रिंग कॉपी करें",
  "wa2349012": "शब्द हटाएं",
  "wa271253d": "इसे इस ऐप के लिए इस्तेमाल करें",
  "wa2cce835": "पासफ़्रेज़",
  "wa2de4b90": "सभी के लिए म्यूट",
  "wa2eecf15": "एक उदाहरण कॉपी करें",
  "wa2f6a367": "जो SMS स्पैम जैसा दिखे उसे डिलीवरी, रिमाइंडर या अपॉइंटमेंट के रूप में नहीं छांटा जाता, ताकि नकली \"आपका पार्सल रुका है, फ़ीस भरें\" स्पैम में छिपा रहे।",
  "wa2f8bba2": "फ़ाइलें खोजें",
  "wa3292a0c": "आपका बैकअप इससे फिर से सील किया जाता है। आपके रिकवरी शब्द वही रहते हैं।",
  "wa33ff897": "यहाँ इस डिवाइस की समीक्षा कुंजी से खोले गए: रिले उन्हें सील रखता है और कभी नहीं देखता कि उनमें क्या लिखा है।",
  "wa3583899": "ज़ूम इन करें",
  "wa35f6e29": "फिर से लिस्ट करें",
  "wa3742172": "अनलिंक करें",
  "wa3ce4cb3": "लोगों को न्योता दें",
  "wa3e5f1e1": "न भेजें",
  "wa3f9baec": "शेड्यूल करें",
  "wa408a225": "सदस्य और मॉडरेटर के बीच",
  "wa43809e0": "पढ़ने के लिए कोई रिपोर्ट नहीं।",
  "wa4461406": "कॉल कैसे बदली जाती हैं",
  "wa46af788": "साइन इन किया हर डिवाइस एक साथ आपके खाते के रूप में जुड़ा रहता है, और हर एक को वह मिलता है जो आपको भेजा जाता है। जिस भी ब्राउज़र में आप साइन इन करें, और हर प्राइवेट विंडो, यहाँ एक अलग डिवाइस है जब तक वह साइन आउट न करे या आप उसे हटा न दें; एक खाते में 20 की जगह है।",
  "wa4780039": "सर्कल में हर कोई क्या कर सकता है, चाहे उनकी भूमिका कुछ भी हो। कोई स्पेस इसे अपने लिए अपनी अनुमतियों में बदल सकता है।",
  "wa48c839b": "इस फ़ोन की नई कुंजी है",
  "wa49dd09e": "रोका गया",
  "wa4bfdc90": "इससे पेयर किया गया",
  "wa4c7cb05": "दोस्ती का अनुरोध भेजें",
  "wa4f16c75": "इनका इंतज़ार बंद करें",
  "wa5048dbb": "रिपोर्ट कॉपी करें",
  "wa505ab01": "ऐप वाले दूसरे फ़ोन तक सीधे पहुँचें",
  "wa5159374": "curl 'https://messages.google.com/web/config' …",
  "wa5281d04": "ऐसा ग्रुप भी देखा जाता है जिसमें कोई आपके संपर्कों में नहीं है।",
  "wa53136e6": "मार्केटप्लेस में प्लगइन सबमिट करें",
  "wa55af8c4": "लिंक किए गए खाते",
  "wa59ba5bf": "यहीं बनाया और जाँचा जाता है; चैट के बारे में कुछ भी कहीं नहीं जाता सिवाय सवाल के, जो उसी चैट में भेजा जाता है।",
  "wa5d2a900": "आवाज़ और वीडियो रिकॉर्ड करें",
  "wa62cba32": "\"इससे पेयर किया गया…\" सूचना",
  "wa63b9813": "आपके साथ शेयर किए गए बैकग्राउंड लगाएं",
  "wa6a08b6d": "Google का पेज आपका नंबर माँगता है और आपको छह अंकों का कोड SMS करता है। SMS यहाँ आता है। वहाँ कोड टाइप करें और आपके नंबर के लिए RCS बंद हो जाएगा। ऐप बदलने की ज़रूरत नहीं।",
  "wa6f720e8": "वीडियो चलाएं",
  "wa7234b24": "जब उनके पास ऐप हो और आप एक-दूसरे को SMS करें, तो यह आपके बीच एन्क्रिप्शन चालू करने का सुझाव देता है। तब से रूट उन तक पहुँचते हैं।",
  "wa73c373d": "यह कैसे लिस्ट होता है",
  "wa73d406a": "आप इसे कभी भी चालू करके फिर से साइन इन कर सकते हैं।",
  "wa77a5eb0": "फ़ॉन्ट",
  "wa783e348": "थ्रेड बंद करें",
  "wa787c3dc": "एक टिक",
  "wa7947b84": "चैट, वॉइस चैट, या फ़ाइल स्पेस",
  "wa7c3b223": "न्योता लिंक कॉपी करें",
  "wa7fac1f4": "कुछ कहें",
  "wa82cc636": "लिस्ट से हटाएं",
  "wa85b644b": "अभी कोई कुंजी नहीं है।",
  "wa8a60c11": "एक घंटे में",
  "wa8a83328": "स्पैम",
  "wa8dc0817": "लिंक नहीं",
  "wa902f0f9": "हर मैसेज Markdown या JSON के रूप में, चाहें तो उसकी तस्वीरों और फ़ाइलों के साथ।",
  "wa92a53a2": "सहायता और दस्तावेज़",
  "wa9442aa9": "Finder में दिखाएं",
  "wa957e4ee": "इस डिवाइस को किसी दूसरे डिवाइस से आपके खाते से साइन आउट किया गया।",
  "wa96b5711": "बग बाउंटी के लिए",
  "wa987c2f5": "इसे रखें",
  "wa99d62c2": "सूचनाएं और रसीदें",
  "wa9daa9a0": "कॉपी करने पर पढ़ा हुआ मार्क करें",
  "wa9e8e16c": "किसी बातचीत में",
  "waa2fc90d": "बैटरी इस्तेमाल",
  "waa47fa3b": "इस फ़ोन पर भाषाएं",
  "waa55a56e": "ऊपर पिन करें",
  "w62a66cf0": "Uplink",
  "waa7d6ae8": "पक्के संकेत दोगुने गिने जाते हैं",
  "waaad5b41": "आप ऐप में कैसे घूमते हैं। दोनों नए तरीके हर पेज पर एक जैसे हैं; रेल आपके सर्कल को बाईं ओर जोड़ती है, जैसे Discord और Slack में होता है।",
  "waab6fb83": "SMS यहीं जाँचे जाते हैं और कहीं नहीं भेजे जाते। कुछ भी मिटाया या ब्लॉक नहीं किया जाता, और आपके संपर्कों को कभी नहीं छांटा जाता। किसी बातचीत पर \"… नहीं\" उसे हमेशा के लिए Messages में वापस रखता है।",
  "waacf0937": "सोल्स",
  "waaff8ec9": "इसे छोड़ दें",
  "wab05c8bd": "अभी कोई भूमिका नहीं: भूमिकाएं में बनाएं",
  "wab20d49c": "रिले के ज़रिए",
  "waba47927": "किसी को अनब्लॉक करने के लिए उसे टैप करें।",
  "wabdeb84b": "वह रूट जिसने आखिरी बार हर व्यक्ति तक कुछ पहुँचाया, और वह जो आखिरी बार उनसे कुछ लाया। ग्रुप हर व्यक्ति के हिसाब से चलता है: उसके हर व्यक्ति तक उसके अपने रूट से पहुँचा जाता है।",
  "wac28cd0d": "आवाज़ चुनें",
  "wac635393": "कॉल में मेरी आवाज़ बदलें",
  "wac68ec76": "Enter से भेजें",
  "wacaa5298": "एक जैसी हेडिंग वाले स्पेस साथ में लिस्ट होते हैं। कुछ न रखने के लिए खाली छोड़ें।",
  "wacaafd84": "इस प्लगइन को रिपोर्ट करें",
  "wacac5fef": "यहाँ से नहीं हो सकता: मार्केटप्लेस की भेजी कॉपी इस डिवाइस पर सही नहीं निकलती।",
  "wacec3801": "5 मिनट",
  "wad692f00": "वे अभी चले जाते हैं, और फिर से न्योता मिलने पर वापस आ सकते हैं",
  "wad6ed245": "एडमिन",
  "wad736a52": "इस स्क्रीन की आवाज़ का वॉल्यूम",
  "wfaf63e7a": "इसे छोड़ने के लिए, ऊपर Uplink के रिले पर वापस जाएं, या इसे बंद करें।",
  "wad9ef205": "इस फ़ोन पर रखा गया",
  "wadc3ab5e": "ऐप इस फ़ोन पर एक कॉपी रखता है। यह एक हल्के परदे के नीचे दिखती है ताकि मैसेज पढ़ने में आसान रहें।",
  "wadc589d7": "आज़माएं",
  "wae047875": "PDF",
  "wae04cce8": "कुछ और जोड़ना है?",
  "wae23786f": "हर SMS आते ही फ़ोन पर तय होता है। शांत SMS फिर भी दिखता है, शांत समय वाले सूचना चैनल पर।",
  "wae98f10a": "बड़े इमोजी",
  "waeb6a612": "बिट रेट",
  "waf3e4446": "दूसरा टैब पहले वाले की जगह लेने का सुझाव देता है, ताकि हर मैसेज एक ही बार आए।",
  "waf5c5293": "आर्काइव किया गया",
  "w1619bac2": "Signal में दूसरे ऐप के लिए कोई API नहीं है: Uplink उसी तरह लिंक होता है जैसे Signal Desktop, ओपन-सोर्स mautrix-signal (GNU AGPL) के ज़रिए। आपके मैसेज सिर्फ़ इस डिवाइस और Signal के बीच जाते हैं, कभी Uplink के सर्वर से होकर नहीं।",
  "wafb3e591": "कैटेगरी",
  "wb00d141c": "यूज़रनेम से जुड़े दोस्त इसे आपकी प्रोफ़ाइल पर देखते हैं।",
  "wb015ebb9": "कभी अनुवाद नहीं होता।",
  "wb01cfe54": "सेटिंग › API, नीचे डेवलपमेंट वाले प्लगइन, और मार्केटप्लेस का डेवलपमेंट में दिखाता है।",
  "wb0280b9e": "दोस्तों को लाएं",
  "wb03589e8": "रिले सर्वर तक नहीं पहुँचा जा सकता",
  "wb0732013": "समीक्षक के लिए नोट (वैकल्पिक): इसे कैसे आज़माएं, क्या बदला",
  "wb0992fa8": "असली इंसान जैसी लगती है, पर आपके बोलने के एक-दो सेकंड बाद सुनाई देती है। आपकी ElevenLabs कुंजी चाहिए।",
  "wb0a55bd7": "जो कुंजियाँ चाहिए, सब एक साथ दबाएं। Esc इसे पहले जैसा छोड़ देता है।",
  "wb11803fb": "स्पेस के विकल्प",
  "wb14ef6fb": "आज शाम तक (6 बजे)",
  "wb1546e14": "आखिरी मिला",
  "wb1acc0db": "वरना, रिकॉर्डिंग में उसके मेन्यू से।",
  "wb20bc9d2": "फ़ाइल खुल रही है",
  "wb218d5b0": "क्या हुआ",
  "wb23f00c7": "जवाब देना बंद करें",
  "wb2a15753": "रिले सर्वर के ज़रिए API, किसी भी नेटवर्क से। अनुरोध और जवाब कनेक्शन स्ट्रिंग की कुंजी से सील होते हैं: रिले उन्हें आगे भेजता है पर पढ़ नहीं सकता। ऐप चालू होना चाहिए।",
  "wb2d46890": "वीडियो कहाँ है",
  "wb2e743b7": "मैप्स में खोलें",
  "wb2fa8fdb": "शब्द पढ़ें",
  "wb311f3b0": "वॉइस और वीडियो सेटिंग",
  "wb330074a": "कोई पासफ़्रेज़ न माँगें",
  "wb34a0288": "पेस्ट करें",
  "wb35c3185": "जोड़ा गया",
  "wb3a43630": "हाँ",
  "wb3a772d9": "हर खाता अनलिंक करें और अपनी इंतज़ार सूची साफ़ करें? दोस्तों को अब नहीं बताया जाएगा कि आप यहाँ हैं।",
  "wb3b03247": "इस्तेमाल नहीं हुआ",
  "wb3ca9a34": "आवाज़",
  "wb3f14fb0": "लॉसलेस म्यूज़िक",
  "wf47fcd5b": "अपने Uplink खाते में साइन इन करें",
  "wb42b7af3": "यह पुरानी तस्वीर भूल जाएं?",
  "wce59649b": "कनेक्शन सिर्फ़ इस कंप्यूटर का है: मैसेज इसके और Google के बीच जाते हैं, कभी Uplink के सर्वर से होकर नहीं। हेल्पर ओपन सोर्स है, mautrix-gmessages (GNU AGPL) पर बना।",
  "wb4519085": "कभी नहीं पूछा",
  "wb453bfed": "तस्वीर को ऐप के ऊपर रखें",
  "wb47499ba": "इनमें सिर्फ़ मालिक और एडमिन पोस्ट कर सकते हैं: घोषणाएं, नियम, सिस्टम मैसेज। रिले बाकी सब पर भी यह लागू करता है। किसी स्पेस को उसकी सेटिंग में सिर्फ़ पढ़ने लायक बनाएं।",
  "wb50a96d7": "कोड में ले जाएं",
  "wb52330a2": "हाल में तय हुए",
  "wb52aa576": "डिलीवर हुआ। रंगीन: पढ़ा गया।",
  "wb53018dc": "रैंक",
  "wb5bdd13c": "आप",
  "wb5c51d5f": "रिकॉर्डिंग यहाँ सेव करें",
  "wb5e8e80f": "पेयर नहीं",
  "wb61190f3": "फ़ोल्डर सिंक करें",
  "wb6473d88": "Google Messages की सूचनाएं शांत करें",
  "wb651bded": "रिकॉर्डिंग",
  "wb6996066": "हर एक के साथ वह जो उसे चलाता है। यहाँ चलाने के लिए किसी एक को टैप करें।",
  "wb7309f03": "दिए जाते ही उन्हें कारण के साथ बताया जाता है, अगर वे कनेक्ट हैं; वरना अगली बार जब वे कनेक्ट हों।",
  "wb753bebd": "यहाँ आपके बबल",
  "wb7b07b89": "मैंने इन्हें लिख लिया है",
  "wb7b3f75a": "नया ग्रुप",
  "wb7d6a318": "यह लिंक जोड़ें",
  "wb7e3830e": "आपके लिए आपका यूज़रनेम, नाम, तस्वीर और स्टेटस भरता है। आप इनमें से कुछ भी बदल सकते हैं।",
  "wb7f41ea7": "इसे अपने फ़ोन से स्कैन करें",
  "wb88a2d0e": "नई कुंजी सभी के साथ एन्क्रिप्शन खत्म कर देती है। आगे बढ़ने के लिए हर बातचीत में फिर से कुंजी बदली जाती है, और पुरानी कुंजी से सील किए SMS अब नहीं खोले जा सकते।",
  "wb89df01a": "सहायता",
  "wb8a58f76": "डेवलपर",
  "wb8a72650": "इनमें से तीन टाइप करें",
  "wb933b49a": "ग्रुप किस लिए है: कोई गेम, कोई फ़िल्म, कोई शांत कोना।",
