  "w7cf7aeb3": "ghostapi1:… Ai có nó đều gọi được API: hãy giữ như giữ mật khẩu.",
  "w7cfd61b2": "Hỏi",
  "w7d0d3efe": "Chép lời mỗi bản ghi âm khi được lưu",
  "w7d66c7d7": "Cài đặt cuộc trò chuyện",
  "w7db1a648": "Cho bạn bè thấy số và tài khoản đã liên kết của tôi",
  "w7dbf917d": "Chọn ảnh",
  "w7dcce3a5": "Chia sẻ",
  "w7de460ef": "Màu Android lấy từ hình nền điện thoại, cũng là màu của các ứng dụng hệ thống. Nó thay đổi khi đổi hình nền.",
  "w7e09f19b": "Mang nó về đây",
  "w7e11c46d": "Liên kết kết bạn của bạn, dưới dạng mã QR",
  "w7e288acb": "Tắt tiếng cho tôi",
  "w7e34b97f": "Mã được đặt tên theo công ty gửi tin nhắn (Coinbase, Discover) nếu tin nhắn có ghi, thay cho số.",
  "w7e45c4c5": "Cho vòng kết nối",
  "w7eb08fad": "Nhóm mà người mới thêm bạn vào cũng bị giữ lại và hỏi.",
  "w7eeb8efd": "Bạn đã rời vòng kết nối này.",
  "w7f0282c4": ":root { --app-accent: #ff5c8a; }",
  "w7f18690f": "Chưa có giọng nào. Thêm khóa của bạn, hoặc đọc lại.",
  "w7f2c35ea": "Khi bật ở đây, plugin hoạt động trong các không gian của vòng kết nối này cho mọi thành viên, không cần ai thêm.",
  "w7f948750": "Nhắn mã cho tôi",
  "w7f97edaa": "Micrô nguyên bản, cho âm nhạc: không khử tiếng vọng, khử tiếng ồn hay tăng âm, 510 kb/s stereo ở tốc độ cố định. Hãy dùng tai nghe.",
  "w80324733": "Làm tròn tại chỗ bạn đứng",
  "w80595241": "Báo cho không gian và vòng kết nối",
  "w8062364f": "Đăng nhập Mastodon",
  "w80848996": "Đang chờ bạn phê duyệt trên trang của Microsoft…",
  "w80bbfee7": "Tham gia với tư cách",
  "w80c5c254": "Ai đang dùng sẽ đăng nhập lại ở máy chủ mới.",
  "w80d8dbd0": "Chế độ nhà phát triển",
