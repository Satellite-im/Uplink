  "w90a9ee82": "Thư mục cho bản ghi âm",
  "w90e40fab": "Đưa mã đăng nhập cho Ghost Keyboard",
  "w9110ee5d": "Địa chỉ của nó: https, hoặc http://127.0.0.1 với adb reverse.",
  "w91460811": "Tuyên bố",
  "w915bf322": "Tệp",
  "w91a8315d": "Lấy lại linh hồn",
  "w91d126d8": "Cách tạo plugin",
  "w91dad0f8": "Ở đâu",
  "w91e91987": "Đóng chat",
  "w91ee7fb9": "Sắp ra mắt",
  "wfd6579c8": "Tin nhắn chỉ đi giữa thiết bị này và máy chủ Matrix của bạn. Máy chủ của Uplink không bao giờ thấy chúng, và mật khẩu không được lưu: chỉ lưu phiên máy chủ trả về và khóa mã hóa của thiết bị này.",
  "w9202088e": "Liên kết",
  "w924e07cc": "Không bật cái nào",
  "w924f3271": "Dán mã giao diện",
  "w929d346a": "Bộ emoji",
  "w92aea8e8": "Lưu trên thiết bị này",
  "w92c02e76": "Gọi",
  "w932ed2b7": "Tuyến",
  "w93461f34": "Chọn thời gian…",
  "w934adc9f": "Quên khóa ElevenLabs trên thiết bị này?",
  "w934cec55": "Học từ những gì bạn chuyển",
  "w93508a2b": "Sao chép địa chỉ",
  "w935a806b": "Cho bạn bè thấy ai bảo lãnh tôi",
  "w935f1a4b": "Mở bằng ứng dụng khác",
  "w9381f8d8": "Từ đâu",
  "w8871815a": "Google Messages là ứng dụng SMS mặc định và giữ RCS. Uplink đọc tin nhắn văn bản từ Android và chat RCS từ thông báo của Google Messages, và trả lời qua nó.",
  "w93e63edc": "Bạn chưa báo cáo ai",
  "w9413bf3d": "Từ ảnh của bạn.",
  "w943664b7": "Plugin",
  "w943e12da": "Nghe những gì người khác phát",
  "w947704ea": "Gần đây",
  "w9480a318": "Một plugin đang phát triển đang bật · Cài đặt › Nhà phát triển",
  "w94acf0ab": "Cho bất kỳ ai trong danh bạ, qua tin nhắn",
  "w94d75031": "relay.example.com",
  "w9501c510": "Hóa đơn, biên lai, bưu kiện, và tin nhắn mà plugin loại này không nên đụng tới: mã đăng nhập, câu hỏi của bạn bè, lịch hẹn, lừa đảo trúng thưởng, tin nhắn chính trị.",
  "w1c308a82": "Trong WhatsApp trên điện thoại: Cài đặt › Thiết bị đã liên kết › Liên kết thiết bị, rồi hướng vào mã này. Uplink trở thành một thiết bị khác của bạn, giống WhatsApp Web, và các chat gần đây sẽ được chuyển sang.",
  "w95afdf0e": "Chuyển vào Spam",
  "w95d20bf1": "Mở lại trang của Google",
  "w95dc3445": "Rời cuộc gọi",
  "w95fbfac0": "Tắt mã hóa",
  "w95fdfd9f": "Dấu đang gõ, xác nhận đã đọc, ảnh đủ cỡ và nhóm chat qua internet, thông qua Google Messages. Vài bước, từng bước một.",
  "w960209c3": "Máy chủ chuyển tiếp này, dưới dạng mã QR",
  "w962cd7ec": "Được tìm thấy",
  "w963b0473": "Cuộc trò chuyện đã chọn",
  "w968f7c61": "Những gì ứng dụng này đọc và hiển thị. Nếu các số này đúng mà danh sách sai, hãy kéo danh sách xuống để đọc lại.",
  "w96913f28": "Tên giữ màu chữ gốc",
  "w977bf4cb": "Nhập mã PIN trước",
  "w97af2cdc": "Tên không gian",
  "w97cb0637": "Cho biết tài khoản nào ở nơi khác là của bạn, và dán khối đã ký vào đó: trong phần giới thiệu, bài đăng hoặc trang. Nó chứng minh nội dung đến từ tài khoản này, và vào lúc nào.",
  "w97ecbef1": "Dán vào để xem là của ai",
  "w97f4a04f": "Ai giữ khóa cũ sẽ bị chặn.",
  "w982f5c27": "Cân bằng độ to giọng của bạn. Khi tắt, giữ nguyên mức của bạn.",
  "w983277c4": "1 phút",
  "w987a959b": "Quên mã PIN?",
  "w987c7d5f": "Bỏ chặn",
  "w98a0bb1b": "Mỗi tin nhắn từ số không có trong danh bạ được xem xét theo các dấu hiệu bên dưới. Cần bao nhiêu dấu hiệu:",
  "w98d42939": "Thêm vai trò",
  "w98f2ba3a": "Hủy ghép nối",
  "w98f9c5f8": "Mã vận đơn UPS, USPS hoặc FedEx: trang tra cứu của hãng.",
  "w991624d5": "Bắt đầu điều mới",
  "w992c5ed8": "Đang khởi động Telegram…",
  "w9964e50a": "Đừng dùng cái này",
  "w996b50e4": "Ai có quyền thay đổi vòng kết nối đều có thể chọn.",
  "w9970a07a": "Trực tiếp giữa các thiết bị trên cùng mạng với thiết bị này, không cần máy chủ hay internet. Dùng khi máy chủ chuyển tiếp không chuyển được, và tự dùng khi hoàn toàn không có internet.",
