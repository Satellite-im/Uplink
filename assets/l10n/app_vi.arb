  "w8deb7e3a": "Bản này",
  "w8deb8e24": "Đóng cài đặt",
  "w8debcab6": "Mọi tin nhắn ở đây, cả các chuỗi, dưới dạng Markdown hoặc JSON, kèm tệp nếu bạn muốn.",
  "w8e15cbd9": "Hiện cạnh tên họ trong không gian, vòng kết nối và trên hồ sơ.",
  "w8e2a9ee6": "Mở trong bộ trộn",
  "w8e483945": "Đang gửi.",
  "w8e9060c2": "Với tin nhắn hình ảnh và nhóm.",
  "w8eafa59a": "Mọi cuộc trò chuyện trong Google Messages hiện ở đây, RCS và tin nhắn văn bản, với lịch sử và hình ảnh. Điện thoại cần bật và có mạng: tin nhắn đi qua nó.",
  "w8eba1d51": "Khi tắt, chỉ liên kết tới YouTube, Spotify, SoundCloud, Vimeo, TikTok, X, Reddit và tương tự mới có thẻ xem trước.",
  "w8f037c2f": "Tìm phiên bản mới mỗi khi ứng dụng được mở.",
  "w8f3184bc": "Hệ thống",
  "w8f4719c7": "Ứng dụng tự cập nhật từ gogho.st: phiên bản mới được tải ngầm và cài khi bạn khởi động lại, hoặc lần tới khi thoát.",
  "w8f517045": "Hiệu năng",
  "w8f9b3774": "Nó chạy trong ứng dụng của ai đó",
  "w901b914f": "Không có ảnh chụp màn hình.",
  "w902b7e39": "Vai trò",
