  "w81abc3d7": "Xóa mọi thông tin về tôi",
  "w394a471e": "Khóa, khóa mới và tìm người có Uplink được đặt trên điện thoại, trong Cài đặt › Mã hóa.",
  "w81f51acc": "Ứng dụng",
  "w8210607e": "Cách vẽ emoji trong ứng dụng này. Người kia thấy emoji do điện thoại của họ vẽ.",
  "w82241975": "Tức thì và miễn phí. Một hiệu ứng: trầm hơn, cao hơn, robot và hơn nữa.",
  "w82278ca8": "Không có gì được lưu trữ",
  "w824bbd4c": "Tin nhắn vẫn ở trong kho tin nhắn của Android, nên vẫn còn đủ nếu bạn chuyển lại ứng dụng khác.",
  "w8268ce50": "Những thông báo nào của nó còn phát âm thanh, tính đến tin nhắn gần nhất, kèm cách tắt tiếng từng loại: Tin nhắn đến, và mọi cuộc trò chuyện có âm thanh riêng.",
  "w826f7f7c": "Tải lên",
  "w829f4dad": "Thêm bạn",
  "w82b317a8": "Chỉ quản trị viên mới đổi được những mục này.",
  "w82e16a26": "Những mục này quyết định trước khi tính bất kỳ dấu hiệu nào. \"Không bao giờ\" thắng \"luôn luôn\".",
  "w8313d4fa": "Dừng ghi âm",
  "w83658a3a": "Chỉ màu và phông chữ",
  "w83666356": "Cho phép chọn nhiều đáp án",
  "w83787b9a": "Cập nhật tự động",
  "w8390060e": "Mọi người",
  "w8393950d": "Lỗi, và mỗi tin nhắn hình ảnh: được chuyển thành gì, dung lượng bao nhiêu, và nhà mạng trả lời gì. Giữ 300 dòng gần nhất.",
  "w839b241a": "Chọn thiết bị bạn đang nghe, và âm thanh lossless sẽ phát tới đó.",
  "w844f7eb8": "Không có trong bản dựng này",
  "w847d7bcb": "Plugin",
  "w84b358d7": "Tin nhắn có mã đăng nhập sẽ có nút sao chép mã.",
  "w8aa21ca7": "Uplink hoạt động không cần tin nhắn văn bản: bạn bè, vòng kết nối, Telegram và Signal. Bật tin nhắn để đọc và gửi tin nhắn ở đây nữa, làm ứng dụng nhắn tin chính hoặc cạnh Google Messages.",
  "w84c2de12": "Sao chép các từ",
