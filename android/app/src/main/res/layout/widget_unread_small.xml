<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg"
    android:gravity="center" android:orientation="horizontal" android:padding="12dp">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_stat_ghost"
        android:tint="@color/widget_ink" android:contentDescription="@null" />
    <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textColor="@color/widget_ink" android:textSize="26sp"
        android:textStyle="bold" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:textColor="@color/widget_ink2" android:textSize="13sp"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
