<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_person"
    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
    android:orientation="vertical" android:padding="2dp">
    <ImageView android:id="@+id/widget_face" android:layout_width="44dp" android:layout_height="44dp"
        android:contentDescription="@null" />
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:gravity="center" android:textColor="@color/widget_ink"
        android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
