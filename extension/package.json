{
  "name": "ghost-messaging-keys",
  "private": true,
  "version": "0.2.2",
  "description": "Uplink's key sync: a browser extension that captures the sign-in cookies for the chat networks the app signs in to (Messenger, Instagram, Discord, X, Slack, Google Messages) and syncs them, sealed, across every device signed into your Uplink account.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs chrome",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@glacier/react": "file:vendor/@glacier/react",
    "@noble/curves": "1.9.4",
    "@noble/hashes": "1.8.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
